--[[
    Xanax - SaveManager.lua
    ------------------------------------------------------------------
    Standalone configuration system. It builds its interface ONLY through
    the public element API of UILibrary.lua and reads/writes values only
    through Library.Flags[flag]:Get() / :Set(value, silent).

    API
        SaveManager:SetLibrary(library)      -- defaults to getgenv().UILibrary
        SaveManager:SetFolder("Xanax")       -- <folder>/Configs/<name>.json
        SaveManager:BuildConfigSection(tab)  -- tab optional
        SaveManager:LoadAutoloadConfig()     -- call after all elements exist

    Executing this file when getgenv().UILibrary and getgenv().UIWindow
    already exist attaches everything automatically.
]]

local HttpService = game:GetService("HttpService")

local environment = (type(getgenv) == "function") and getgenv() or _G

local SaveManager = {}
SaveManager.__index      = SaveManager
SaveManager.__Signature  = "XanaxSaveManager"
SaveManager.Folder       = "Xanax"
SaveManager.Library      = nil
SaveManager.AttachedWindow = nil
SaveManager.Section      = nil
SaveManager.Controls     = nil
SaveManager.Ignore       = {}
SaveManager.UseDisk      = false
SaveManager.NoticeShown  = false

--=====================================================================--
-- FILESYSTEM (feature detected, every call wrapped in pcall)
--=====================================================================--
local FS = {
    write  = (type(writefile)  == "function") and writefile  or nil,
    read   = (type(readfile)   == "function") and readfile   or nil,
    isfile = (type(isfile)     == "function") and isfile     or nil,
    list   = (type(listfiles)  == "function") and listfiles  or nil,
    remove = (type(delfile)    == "function") and delfile    or nil,
    mkdir  = (type(makefolder) == "function") and makefolder or nil,
    isdir  = (type(isfolder)   == "function") and isfolder   or nil,
}

local HAS_DISK = (FS.write and FS.read and FS.isfile and FS.list and FS.remove and FS.mkdir) and true or false
SaveManager.UseDisk = HAS_DISK

local function memoryStore(folder)
    environment.__XanaxConfigStore = environment.__XanaxConfigStore or {}
    local root = environment.__XanaxConfigStore
    root[folder] = root[folder] or {}
    return root[folder]
end

function SaveManager:_memory() return memoryStore(self.Folder) end

function SaveManager:_diskFailure()
    if not self.UseDisk then return end
    self.UseDisk = false
    self:_updateNotice()
end

function SaveManager:ConfigDir() return self.Folder .. "/Configs" end
function SaveManager:MarkerPath() return self.Folder .. "/autoload.json" end

function SaveManager:_ensureFolders()
    if not self.UseDisk then return end
    for _, path in ipairs({ self.Folder, self:ConfigDir() }) do
        local exists = false
        if FS.isdir then
            local ok, result = pcall(FS.isdir, path)
            exists = ok and result and true or false
            if not ok then self:_diskFailure() return end
        end
        if not exists then
            local ok = pcall(FS.mkdir, path)
            if not ok then self:_diskFailure() return end
        end
    end
end

-- Normalises listfiles output across executors:
--   "Xanax/Configs/name.json", "Xanax\\Configs\\name.json", "name.json", "name"
local function fileToName(entry)
    if type(entry) ~= "string" then return nil end
    local normalised = entry:gsub("\\", "/")
    local tail = normalised:match("([^/]+)$") or normalised
    if tail:sub(-5):lower() == ".json" then tail = tail:sub(1, #tail - 5) end
    if tail == "" then return nil end
    return tail
end

function SaveManager:ListConfigs()
    local names, seen = {}, {}

    if self.UseDisk then
        self:_ensureFolders()
        local ok, entries = pcall(FS.list, self:ConfigDir())
        if ok and type(entries) == "table" then
            for _, entry in ipairs(entries) do
                local name = fileToName(entry)
                if name and name:lower() ~= "autoload" and not seen[name:lower()] then
                    seen[name:lower()] = true
                    table.insert(names, name)
                end
            end
        elseif not ok then
            self:_diskFailure()
        end
    end

    if not self.UseDisk then
        for name in pairs(self:_memory()) do
            if name ~= "__autoload" and not seen[name:lower()] then
                seen[name:lower()] = true
                table.insert(names, name)
            end
        end
    end

    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    return names
end

function SaveManager:_readConfig(name)
    if self.UseDisk then
        local path = self:ConfigDir() .. "/" .. name .. ".json"
        local okExists, exists = pcall(FS.isfile, path)
        if okExists and not exists then return nil end
        if okExists then
            local okRead, data = pcall(FS.read, path)
            if okRead and type(data) == "string" then return data end
            self:_diskFailure()
        else
            self:_diskFailure()
        end
    end
    return self:_memory()[name]
end

function SaveManager:_writeConfig(name, data)
    if self.UseDisk then
        self:_ensureFolders()
        local ok = pcall(FS.write, self:ConfigDir() .. "/" .. name .. ".json", data)
        if ok then return true end
        self:_diskFailure()
    end
    self:_memory()[name] = data
    return true
end

function SaveManager:_deleteConfig(name)
    if self.UseDisk then
        local path = self:ConfigDir() .. "/" .. name .. ".json"
        local okExists, exists = pcall(FS.isfile, path)
        if okExists and exists then
            local ok = pcall(FS.remove, path)
            if not ok then self:_diskFailure() end
        elseif not okExists then
            self:_diskFailure()
        end
    end
    self:_memory()[name] = nil
    return true
end

function SaveManager:_readMarker()
    local raw
    if self.UseDisk then
        local okExists, exists = pcall(FS.isfile, self:MarkerPath())
        if okExists and exists then
            local okRead, data = pcall(FS.read, self:MarkerPath())
            if okRead and type(data) == "string" then raw = data end
        elseif not okExists then
            self:_diskFailure()
        end
    end
    if raw == nil then raw = self:_memory()["__autoload"] end
    if type(raw) ~= "string" or raw == "" then return nil end

    local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok or type(decoded) ~= "table" or type(decoded.config) ~= "string" or decoded.config == "" then
        self:_clearMarker()
        return nil
    end
    return decoded.config
end

function SaveManager:_writeMarker(name)
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode({ config = name })
    end)
    if not ok then return false end
    if self.UseDisk then
        local written = pcall(FS.write, self:MarkerPath(), encoded)
        if not written then self:_diskFailure() end
    end
    self:_memory()["__autoload"] = encoded
    return true
end

function SaveManager:_clearMarker()
    if self.UseDisk then
        local okExists, exists = pcall(FS.isfile, self:MarkerPath())
        if okExists and exists then pcall(FS.remove, self:MarkerPath()) end
    end
    self:_memory()["__autoload"] = nil
end

--=====================================================================--
-- VALUE ENCODING (lossless JSON round trip)
--=====================================================================--
local function encodeValue(value)
    local kind = typeof(value)
    if kind == "Color3" then
        return { __t = "Color3", R = value.R, G = value.G, B = value.B }
    elseif kind == "EnumItem" then
        return { __t = "Enum", Name = value.Name }
    elseif kind == "table" then
        local list = {}
        for index, item in ipairs(value) do list[index] = encodeValue(item) end
        return list
    elseif kind == "boolean" or kind == "number" or kind == "string" then
        return value
    end
    return nil
end

local function decodeValue(value)
    if type(value) == "table" then
        if value.__t == "Color3" or (tonumber(value.R) and tonumber(value.G) and tonumber(value.B)) then
            return Color3.new(tonumber(value.R) or 0, tonumber(value.G) or 0, tonumber(value.B) or 0)
        end
        if value.__t == "Enum" and type(value.Name) == "string" then
            return value.Name          -- keybinds/enums travel as stable name strings
        end
        local list = {}
        for index, item in ipairs(value) do list[index] = decodeValue(item) end
        return list
    end
    return value
end

--=====================================================================--
-- NAME SANITISING
--=====================================================================--
local function sanitizeName(raw)
    local name = tostring(raw or "")
    name = name:gsub("[%c]", "")                 -- control characters
    name = name:gsub('[\\/:%*%?"<>|]', "")       -- reserved path characters
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    if name:sub(-5):lower() == ".json" then
        name = name:sub(1, #name - 5)
        name = name:gsub("%s+$", "")
    end
    if name == "." or name == ".." or name:lower() == "autoload" then return "" end
    if #name > 64 then name = name:sub(1, 64) end
    return name
end

--=====================================================================--
-- LIBRARY / WINDOW PLUMBING
--=====================================================================--
function SaveManager:SetLibrary(library)
    self.Library = library or environment.UILibrary
    return self
end

function SaveManager:GetLibrary()
    if not self.Library then self.Library = environment.UILibrary end
    return self.Library
end

function SaveManager:SetFolder(name)
    local clean = sanitizeName(name)
    self.Folder = clean ~= "" and clean or "Xanax"
    self.UseDisk = HAS_DISK
    self:_ensureFolders()
    return self
end

function SaveManager:SetIgnoredFlags(list)
    self.Ignore = {}
    for _, flag in ipairs(list or {}) do self.Ignore[flag] = true end
    return self
end

--=====================================================================--
-- UI FEEDBACK
--=====================================================================--
function SaveManager:_feedback(message, tone)
    local controls = self.Controls
    if not controls or not controls.Feedback then return end
    controls.Feedback:Set(message or "")
    local library = self:GetLibrary()
    if library and library.Theme then
        local colour = library.Theme.TextMuted
        if tone == "error" then colour = library.Theme.Danger
        elseif tone == "ok" then colour = library.Theme.Success end
        controls.Feedback:SetColor(colour)
    end
end

function SaveManager:_updateNotice()
    local controls = self.Controls
    if not controls or not controls.Notice then return end
    if self.UseDisk then
        controls.Notice:Set("")
    else
        controls.Notice:Set("Filesystem unavailable - configs are kept for this session only.")
    end
end

function SaveManager:_setAutoloadStatus(name)
    local controls = self.Controls
    if not controls or not controls.Status then return end
    controls.Status:Set("Auto load: " .. (name and name ~= "" and name or "None"))
end

function SaveManager:RefreshList(selected)
    local controls = self.Controls
    if not controls or not controls.List then return {} end
    local names = self:ListConfigs()
    local keep = selected
    if keep == nil then keep = controls.List:Get() end
    local exists = ""
    for _, name in ipairs(names) do
        if type(keep) == "string" and name:lower() == keep:lower() then exists = name break end
    end
    controls.List:Refresh(names, exists)
    return names
end

--=====================================================================--
-- CORE OPERATIONS
--=====================================================================--
function SaveManager:Serialize()
    local library = self:GetLibrary()
    if not library then return nil end

    local flags = {}
    for flag, group in pairs(library.Flags) do
        if not self.Ignore[flag] and #group.Elements > 0 then
            local ok, value = pcall(function() return group:Get() end)
            if ok then
                local encoded = encodeValue(value)
                if encoded ~= nil then flags[flag] = encoded end
            end
        end
    end

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode({ version = 1, brand = "Xanax", flags = flags })
    end)
    if not ok then return nil end
    return encoded
end

function SaveManager:SaveConfig(rawName)
    local name = sanitizeName(rawName)
    if name == "" then
        self:_feedback("Enter a valid config name.", "error")
        return false
    end

    -- names differing only by case reuse the existing file
    for _, existing in ipairs(self:ListConfigs()) do
        if existing:lower() == name:lower() then name = existing break end
    end

    local payload = self:Serialize()
    if not payload then
        self:_feedback("Could not serialise the current values.", "error")
        return false
    end

    self:_writeConfig(name, payload)
    self:RefreshList(name)
    if self.Controls and self.Controls.Name then self.Controls.Name:Set(name, true) end
    self:_feedback('Saved "' .. name .. '".', "ok")
    return true, name
end

function SaveManager:LoadConfig(name)
    if type(name) ~= "string" or name == "" then
        self:_feedback("Select a config first.", "error")
        return false
    end

    local raw = self:_readConfig(name)
    if not raw then
        self:RefreshList("")
        self:_feedback('"' .. name .. '" no longer exists.', "error")
        return false
    end

    local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok or type(decoded) ~= "table" then
        self:_feedback('"' .. name .. '" contains invalid JSON. Nothing changed.', "error")
        return false
    end

    local flags = type(decoded.flags) == "table" and decoded.flags or decoded
    local library = self:GetLibrary()
    if not library then return false end

    local applied, skipped = 0, 0
    for flag, encoded in pairs(flags) do
        local group = library.Flags[flag]
        if group and not self.Ignore[flag] then
            local success = pcall(function() group:Set(decodeValue(encoded), false) end)
            if success then applied = applied + 1 else skipped = skipped + 1 end
        else
            skipped = skipped + 1
        end
    end

    if self.Controls and self.Controls.Name then self.Controls.Name:Set(name, true) end
    self:_feedback(('Loaded "%s" (%d applied, %d skipped).'):format(name, applied, skipped), "ok")
    return true
end

function SaveManager:OverwriteConfig(name)
    if type(name) ~= "string" or name == "" then
        self:_feedback("Select a config to overwrite.", "error")
        return false
    end
    local payload = self:Serialize()
    if not payload then
        self:_feedback("Could not serialise the current values.", "error")
        return false
    end
    self:_writeConfig(name, payload)
    self:RefreshList(name)
    self:_feedback('Overwrote "' .. name .. '".', "ok")
    return true
end

function SaveManager:DeleteConfig(name)
    if type(name) ~= "string" or name == "" then
        self:_feedback("Select a config to delete.", "error")
        return false
    end

    self:_deleteConfig(name)

    local marker = self:_readMarker()
    if marker and marker:lower() == name:lower() then
        self:_clearMarker()
        self:_setAutoloadStatus(nil)
    end

    self:RefreshList("")
    self:_feedback('Deleted "' .. name .. '".', "ok")
    return true
end

function SaveManager:SetAutoloadConfig(name)
    if type(name) ~= "string" or name == "" then
        self:_feedback("Select a config before setting auto load.", "error")
        return false
    end

    local found
    for _, existing in ipairs(self:ListConfigs()) do
        if existing:lower() == name:lower() then found = existing break end
    end
    if not found then
        self:RefreshList("")
        self:_setAutoloadStatus(nil)
        self:_feedback("That config no longer exists.", "error")
        return false
    end

    if not self:_writeMarker(found) then
        self:_feedback("Could not write the auto load marker.", "error")
        return false
    end

    self:_setAutoloadStatus(found)
    self:_feedback('"' .. found .. '" will load automatically.', "ok")
    return true
end

function SaveManager:LoadAutoloadConfig()
    local marker = self:_readMarker()
    if not marker then
        self:_setAutoloadStatus(nil)
        return false
    end

    local found
    for _, existing in ipairs(self:ListConfigs()) do
        if existing:lower() == marker:lower() then found = existing break end
    end

    if not found then
        self:_clearMarker()
        self:_setAutoloadStatus(nil)
        return false
    end

    self:_setAutoloadStatus(found)
    if self.Controls and self.Controls.List then
        self:RefreshList(found)
    end
    return self:LoadConfig(found)
end

--=====================================================================--
-- UI  (built only through the library's public element API)
--=====================================================================--
function SaveManager:_findSettingsTab(window)
    for _, tab in ipairs(window.Tabs or {}) do
        local name = string.lower(tab.Name or "")
        if name == "settings" or name == "config" or name == "configs" then return tab end
    end
    return nil
end

function SaveManager:BuildConfigSection(tab)
    local library = self:GetLibrary()
    if not library then
        warn("[Xanax] SaveManager: no library. Call SaveManager:SetLibrary(Library) first.")
        return nil
    end

    local window = (tab and tab.Window) or environment.UIWindow or library.CurrentWindow
    if not window or window.Destroyed then
        warn("[Xanax] SaveManager: no live window to attach to.")
        return nil
    end

    -- idempotency: one settings section per window, whatever the run order
    if window.__XanaxConfigSection and not window.Destroyed then
        self.AttachedWindow = window
        self.Section = window.__XanaxConfigSection
        self.Controls = window.__XanaxConfigControls or self.Controls
        self:RefreshList()
        self:_updateNotice()
        return self.Section
    end

    tab = tab or self:_findSettingsTab(window) or window:CreateTab({
        Name = "Settings", Icon = "settings", Category = "Player",
    })

    local section = tab:AddSection({ Name = "Configuration", Icon = "config", Column = 1 })
    local manager = self
    local controls = {}

    controls.Name = section:AddTextbox({
        Name = "Config Name",
        Placeholder = "config name",
        Default = "",
    })

    controls.List = section:AddDropdown({
        Name = "Config List",
        Options = {},
        Default = "",
        Placeholder = "None selected",
        EmptyText = "No saved configs",
        Callback = function(choice)
            if choice ~= "" and controls.Name then controls.Name:Set(choice, true) end
        end,
    })

    section:AddButton({
        Name = "Save",
        Callback = function()
            manager:SaveConfig(controls.Name:Get())
        end,
    })

    section:AddButton({
        Name = "Load",
        Callback = function()
            manager:LoadConfig(controls.List:Get())
        end,
    })

    section:AddButton({
        Name = "Overwrite",
        Callback = function()
            manager:OverwriteConfig(controls.List:Get())
        end,
    })

    section:AddButton({
        Name = "Delete",
        Callback = function()
            manager:DeleteConfig(controls.List:Get())
        end,
    })

    section:AddButton({
        Name = "Set as Auto Load",
        Callback = function()
            manager:SetAutoloadConfig(controls.List:Get())
        end,
    })

    controls.Status   = section:AddLabel({ Text = "Auto load: None" })
    controls.Feedback = section:AddLabel({ Text = "", HideEmpty = true })
    controls.Notice   = section:AddLabel({ Text = "", HideEmpty = true, Muted = true })

    self.Controls       = controls
    self.Section        = section
    self.AttachedWindow = window
    window.__XanaxConfigSection  = section
    window.__XanaxConfigControls = controls

    self:_updateNotice()
    self:RefreshList("")
    self:_setAutoloadStatus(self:_readMarker())

    return section
end

--=====================================================================--
-- STATE CARRY-OVER + AUTO ATTACH
--=====================================================================--
local previous = environment.SaveManager
if type(previous) == "table" and previous.__Signature == "XanaxSaveManager" then
    SaveManager.Folder         = previous.Folder or SaveManager.Folder
    SaveManager.Library        = previous.Library
    SaveManager.AttachedWindow = previous.AttachedWindow
    SaveManager.Section        = previous.Section
    SaveManager.Controls       = previous.Controls
    SaveManager.Ignore         = previous.Ignore or {}
    SaveManager.UseDisk        = previous.UseDisk
end

environment.SaveManager = SaveManager

-- Only auto-attach to a live window; a stale destroyed window stays silent
-- so that "SaveManager executed before Preview" never prints anything.
if type(environment.UILibrary) == "table"
   and type(environment.UIWindow) == "table"
   and environment.UIWindow.Destroyed ~= true then
    pcall(function()
        SaveManager:SetLibrary(environment.UILibrary)
        SaveManager:BuildConfigSection()
        SaveManager:LoadAutoloadConfig()
    end)
end

return SaveManager
