local Window, Tab, Section, Element = {}, {}, {}, {}
Window.__index = Window
Tab.__index = Tab
Section.__index = Section
Element.__index = Element

local function clone(v)
	if typeof(v) ~= "table" then return v end
	local r = {}
	for k, x in pairs(v) do r[k] = clone(x) end
	return r
end

local function deepEqual(a, b)
	if typeof(a) ~= typeof(b) then return false end
	if typeof(a) ~= "table" then return a == b end
	for k, v in pairs(a) do if not deepEqual(v, b[k]) then return false end end
	for k in pairs(b) do if a[k] == nil then return false end end
	return true
end

local function tween(obj, props, dur)
	local t = TweenService:Create(obj, TweenInfo.new(dur or Theme.Anim, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function mk(class, props, parent)
	local o = Instance.new(class)
	if o:IsA("GuiObject") then
		o.BorderSizePixel = 0
		o.BackgroundColor3 = Theme.Window
		o.BackgroundTransparency = 1
		o.Active = true
	end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		o.Font = Theme.Font
		o.TextColor3 = Theme.Text
		o.TextSize = Theme.TextBody
		o.Text = ""
		o.TextXAlignment = Enum.TextXAlignment.Left
		o.RichText = false
		o.TextTruncate = Enum.TextTruncate.AtEnd
	end
	if o:IsA("TextLabel") then o.Active = false end
	if o:IsA("GuiButton") then o.AutoButtonColor = false end
	if o:IsA("TextBox") then
		o.ClearTextOnFocus = false
		o.PlaceholderColor3 = Theme.Dim
	end
	if o:IsA("ScrollingFrame") then
		o.BorderSizePixel = 0
		o.ScrollBarThickness = 3
		o.ScrollBarImageColor3 = Theme.Stroke
		o.CanvasSize = UDim2.new(0, 0, 0, 0)
		o.ScrollingDirection = Enum.ScrollingDirection.Y
		o.AutomaticCanvasSize = Enum.AutomaticSize.Y
	end
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end

local function corner(parent, r)
	return mk("UICorner", { CornerRadius = UDim.new(0, r or Theme.RadiusSm) }, parent)
end

local function stroke(parent, color, thick)
	return mk("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thick or Theme.StrokeThick,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function pad(parent, t, r, b, l)
	return mk("UIPadding", {
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
		PaddingLeft = UDim.new(0, l or 0),
	}, parent)
end

local function listLayout(parent, gap, dir)
	return mk("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 6),
	}, parent)
end

-- Minimal geometric icons (no external assets)
local function icon(parent, kind, size, color)
	size = size or 16
	color = color or Theme.Muted
	local holder = mk("Frame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Active = false,
	}, parent)
	local u = size / 16
	local function f(x, y, w, h, rot, trans)
		local p = mk("Frame", {
			BackgroundColor3 = color,
			BackgroundTransparency = trans or 0,
			BorderSizePixel = 0,
			Active = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x * u, y * u),
			Size = UDim2.fromOffset(math.max(1, w * u), math.max(1, h * u)),
			Rotation = rot or 0,
		}, holder)
		corner(p, 1)
		return p
	end
	if kind == "combat" then
		f(8, 3, 2, 10); f(5, 8, 6, 2); f(8, 13, 8, 2, 0)
	elseif kind == "rage" then
		f(8, 4, 3, 3); f(5, 8, 6, 2); f(8, 12, 2, 4)
	elseif kind == "legit" then
		f(8, 8, 10, 10); f(8, 8, 4, 4, 0, 0.3)
	elseif kind == "visuals" then
		f(8, 8, 12, 8); f(8, 6, 2, 2)
	elseif kind == "players" then
		f(8, 5, 5, 5); f(8, 12, 8, 5)
	elseif kind == "effects" then
		f(8, 8, 3, 10, 45); f(8, 8, 3, 10, -45)
	elseif kind == "movement" then
		f(4, 10, 2, 6); f(8, 8, 2, 8); f(12, 6, 2, 10)
	elseif kind == "exploits" then
		f(8, 4, 8, 2); f(5, 8, 2, 8); f(11, 8, 2, 8)
	elseif kind == "settings" then
		f(8, 8, 8, 8); f(8, 8, 3, 3, 0, 0.4)
	elseif kind == "search" then
		f(7, 7, 8, 8); f(12, 12, 4, 2, 45)
	elseif kind == "chevron" then
		f(8, 7, 6, 2, 45); f(8, 7, 6, 2, -45)
	elseif kind == "check" then
		f(6, 9, 3, 2, 45); f(10, 7, 6, 2, -45)
	else
		f(8, 8, 8, 8)
	end
	return holder
end

local function parentGui(gui)
	local tries = {
		function()
			if typeof(gethui) == "function" then return gethui() end
			if typeof(G.gethui) == "function" then return G.gethui() end
		end,
		function() return game:GetService("CoreGui") end,
		function()
			local lp = game:GetService("Players").LocalPlayer
			return lp and (lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui", 3))
		end,
	}
	for _, fn in ipairs(tries) do
		local ok, host = pcall(fn)
		if ok and typeof(host) == "Instance" then
			local ok2 = pcall(function() gui.Parent = host end)
			if ok2 then return true end
		end
	end
	return false
end

-- Element base
function Element:Get()
	return clone(self._value)
end

function Element:Validate(_value)
	return true
end

function Element:Set(value, silent)
	if not self:Validate(value) then return false end
	self._value = clone(value)
	if self._paint then self:_paint(self._value) end
	if not silent and typeof(self.Callback) == "function" then
		pcall(self.Callback, self:Get())
	end
	return true
end

function Element:_register()
	if typeof(self.Flag) == "string" and self.Flag ~= "" then
		Library.Flags[self.Flag] = Library.Flags[self.Flag] or {}
		table.insert(Library.Flags[self.Flag], self)
		if self.Window then
			self.Window.Flags[self.Flag] = self.Window.Flags[self.Flag] or {}
			table.insert(self.Window.Flags[self.Flag], self)
		end
	end
end

-- Window
function Library:CreateWindow(opts)
	opts = opts or {}
	local title = opts.Title or "Xanax"

	local gui = mk("ScreenGui", {
		Name = "XanaxUI_" .. HttpService:GenerateGUID(false),
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10000,
		Enabled = true,
	})
	if not parentGui(gui) then
		gui:Destroy()
		return nil, "No GUI parent available"
	end

	local self = setmetatable({
		Gui = gui,
		Title = title,
		Tabs = {},
		Flags = {},
		Connections = {},
		ToggleKey = Enum.KeyCode.RightShift,
		Destroyed = false,
		DragOffset = Vector2.zero,
	}, Window)

	local root = mk("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(Theme.WindowW, Theme.WindowH),
		BackgroundColor3 = Theme.Window,
		BackgroundTransparency = 0,
		ClipsDescendants = true,
	}, gui)
	corner(root, Theme.Radius)
	stroke(root, Theme.Stroke, 1)
	self.Root = root
	self.Scale = mk("UIScale", { Scale = 1 }, root)

	-- Sidebar
	local sidebar = mk("Frame", {
		Size = UDim2.new(0, Theme.SidebarW, 1, 0),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = 0,
	}, root)
	self.Sidebar = sidebar

	local brand = mk("TextLabel", {
		Size = UDim2.new(1, -20, 0, Theme.TitleH),
		Position = UDim2.fromOffset(14, 8),
		Text = title,
		Font = Theme.FontBold,
		TextSize = Theme.TextTitle,
		TextColor3 = Theme.Text,
		BackgroundTransparency = 1,
	}, sidebar)
	self.Brand = brand

	local tabList = mk("ScrollingFrame", {
		Position = UDim2.fromOffset(8, Theme.TitleH + 12),
		Size = UDim2.new(1, -16, 1, -(Theme.TitleH + 24)),
		BackgroundTransparency = 1,
		ScrollBarThickness = 2,
	}, sidebar)
	listLayout(tabList, 4)
	self.TabList = tabList

	-- Main
	local main = mk("Frame", {
		Position = UDim2.fromOffset(Theme.SidebarW, 0),
		Size = UDim2.new(1, -Theme.SidebarW, 1, 0),
		BackgroundTransparency = 1,
	}, root)
	self.Main = main

	-- Top drag bar (invisible hit area over content top)
	local dragBar = mk("TextButton", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
	}, main)
	self.DragBar = dragBar

	local content = mk("Frame", {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 1, -40),
		BackgroundTransparency = 1,
	}, main)
	self.Content = content

	-- Footer
	local footer = mk("Frame", {
		Position = UDim2.new(0, 0, 1, -40),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = 0,
	}, main)
	mk("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.StrokeSoft,
		BackgroundTransparency = 0,
	}, footer)

	local searchBox = mk("TextBox", {
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(0.42, 0, 0, 24),
		BackgroundColor3 = Theme.Input,
		BackgroundTransparency = 0,
		PlaceholderText = "Search...",
		TextSize = Theme.TextSmall,
		TextColor3 = Theme.Text,
		ClearTextOnFocus = false,
	}, footer)
	corner(searchBox, Theme.RadiusXs)
	stroke(searchBox, Theme.StrokeSoft)
	pad(searchBox, 0, 8, 0, 28)
	local sIcon = icon(footer, "search", 12, Theme.Dim)
	sIcon.Position = UDim2.fromOffset(18, 14)
	self.Search = searchBox

	local chipHost = mk("Frame", {
		Position = UDim2.new(0.45, 0, 0, 8),
		Size = UDim2.new(0.55, -12, 0, 24),
		BackgroundTransparency = 1,
	}, footer)
	listLayout(chipHost, 6, Enum.FillDirection.Horizontal)
	self.ChipHost = chipHost

	local function addChip(text)
		local c = mk("TextLabel", {
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Section,
			BackgroundTransparency = 0,
			Text = "  " .. text .. "  ",
			TextSize = Theme.TextTiny,
			TextColor3 = Theme.Muted,
		}, chipHost)
		corner(c, 12)
		stroke(c, Theme.StrokeSoft)
		return c
	end
	self.ChipTargeting = addChip("Targeting")
	self.ChipPitch = addChip("Pitch")

	-- Connections helper
	function self:Connect(sig, fn)
		local c = sig:Connect(function(...)
			if not self.Destroyed then fn(...) end
		end)
		self.Connections[#self.Connections + 1] = c
		return c
	end

	function self:RegisterFlag(flag, el)
		if typeof(flag) ~= "string" or flag == "" then return end
		Library.Flags[flag] = Library.Flags[flag] or {}
		table.insert(Library.Flags[flag], el)
		self.Flags[flag] = self.Flags[flag] or {}
		table.insert(self.Flags[flag], el)
	end

	function self:GetState()
		local out = {}
		for flag, list in pairs(self.Flags) do
			if list[1] then out[flag] = list[1]:Get() end
		end
		return out
	end

	function self:SetState(map, silent)
		if typeof(map) ~= "table" then return false end
		for flag, value in pairs(map) do
			local list = self.Flags[flag]
			if list then
				for _, el in ipairs(list) do
					pcall(function() el:Set(value, silent) end)
				end
			end
		end
		return true
	end

	function self:SelectTab(tab)
		self.ActiveTab = tab
		for _, t in ipairs(self.Tabs) do
			t.Page.Visible = (t == tab)
			t.Button.BackgroundColor3 = (t == tab) and Theme.Hover or Theme.Sidebar
			t.Button.BackgroundTransparency = (t == tab) and 0 or 1
			t.Label.TextColor3 = (t == tab) and Theme.Text or Theme.Muted
			t.Indicator.Visible = (t == tab)
		end
		self.Search.Text = ""
		if tab then tab:Filter("") end
	end

	function self:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true
		for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
		for flag, list in pairs(Library.Flags) do
			for i = #list, 1, -1 do
				if list[i].Window == self then table.remove(list, i) end
			end
			if #list == 0 then Library.Flags[flag] = nil end
		end
		local idx = table.find(Library.Windows, self)
		if idx then table.remove(Library.Windows, idx) end
		if G.UIWindow == self then G.UIWindow = nil end
		if G.XanaxUI == self then G.XanaxUI = nil end
		gui:Destroy()
	end

	-- Dragging
	local dragging, dragStart, startPos
	self:Connect(dragBar.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = root.Position
		end
	end)
	self:Connect(UserInputService.InputChanged, function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	self:Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Toggle keybind
	self:Connect(UserInputService.InputBegan, function(input, gp)
		if gp then return end
		if input.KeyCode == self.ToggleKey then
			gui.Enabled = not gui.Enabled
		end
	end)

	-- Search
	self:Connect(searchBox:GetPropertyChangedSignal("Text"), function()
		if self.ActiveTab then self.ActiveTab:Filter(searchBox.Text) end
	end)

	-- Fit scale
	local function fit()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local s = math.clamp(math.min((vp.X - Theme.SafeMargin) / Theme.WindowW, (vp.Y - Theme.SafeMargin) / Theme.WindowH), 0.45, 1)
		self.Scale.Scale = s
	end
	fit()
	if workspace.CurrentCamera then
		self:Connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), fit)
	end

	-- Hidden toggle-key flag
	local keyEl = setmetatable({
		Window = self,
		Flag = "interface.toggleKey",
		_value = "RightShift",
		Callback = nil,
	}, Element)
	function keyEl:Validate(v)
		return typeof(v) == "string" and v ~= ""
	end
	function keyEl:Set(v, silent)
		if not self:Validate(v) then return false end
		local ok, kc = pcall(function() return Enum.KeyCode[v] end)
		if not ok or typeof(kc) ~= "EnumItem" then return false end
		self._value = v
		self.Window.ToggleKey = kc
		if not silent and self.Callback then pcall(self.Callback, v) end
		return true
	end
	function keyEl:Get() return self._value end
	keyEl:_register()

	table.insert(Library.Windows, self)
	return self
end

function Window:CreateTab(opts)
	opts = opts or {}
	local name = opts.Name or "Tab"
	local iconName = opts.Icon or "settings"

	local btn = mk("TextButton", {
		Size = UDim2.new(1, 0, 0, Theme.TabH),
		BackgroundTransparency = 1,
		Text = "",
		LayoutOrder = #self.Tabs + 1,
	}, self.TabList)
	corner(btn, Theme.RadiusXs)

	local ind = mk("Frame", {
		Size = UDim2.new(0, 3, 0, 16),
		Position = UDim2.new(0, 0, 0.5, -8),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0,
		Visible = false,
	}, btn)
	corner(ind, 2)

	local ic = icon(btn, iconName, 14, Theme.Muted)
	ic.Position = UDim2.fromOffset(12, 9)

	local label = mk("TextLabel", {
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.new(1, -40, 1, 0),
		Text = name,
		TextSize = Theme.TextBody,
		TextColor3 = Theme.Muted,
		BackgroundTransparency = 1,
	}, btn)

	local page = mk("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ScrollBarThickness = 3,
	}, self.Content)
	pad(page, 12, 12, 12, 12)
	local grid = mk("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, page)
	local columns = mk("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		VerticalAlignment = Enum.VerticalAlignment.Top,
	}, grid)
	local leftCol = mk("Frame", {
		Size = UDim2.new(0.5, -5, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
	}, grid)
	listLayout(leftCol, 10)
	local rightCol = mk("Frame", {
		Size = UDim2.new(0.5, -5, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
	}, grid)
	listLayout(rightCol, 10)

	local tab = setmetatable({
		Window = self,
		Name = name,
		Button = btn,
		Indicator = ind,
		Label = label,
		Page = page,
		Grid = grid,
		Left = leftCol,
		Right = rightCol,
		Sections = {},
		IconHolder = ic,
	}, Tab)

	self:Connect(btn.MouseButton1Click, function()
		self:SelectTab(tab)
	end)

	table.insert(self.Tabs, tab)
	if not self.ActiveTab then self:SelectTab(tab) end
	return tab
end

function Tab:Filter(query)
	query = string.lower(tostring(query or ""))
	for _, sec in ipairs(self.Sections) do
		local showSec = query == "" or string.find(string.lower(sec.Name), query, 1, true)
		local any = showSec
		for _, el in ipairs(sec.Elements) do
			local name = string.lower(el.Name or "")
			local match = query == "" or showSec or string.find(name, query, 1, true)
			if el.Row then el.Row.Visible = match end
			if match then any = true end
		end
		sec.Frame.Visible = any
	end
end

function Tab:AddSection(opts)
	opts = opts or {}
	local name = opts.Name or "Section"
	local col = (opts.Side == "right" or opts.Column == "right") and self.Right or self.Left
	if opts.FullWidth then col = self.Grid end

	local frame = mk("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Section,
		BackgroundTransparency = 0,
		LayoutOrder = #self.Sections + 1,
	}, col)
	corner(frame, Theme.RadiusSm)
	stroke(frame, Theme.StrokeSoft)

	local head = mk("TextLabel", {
		Size = UDim2.new(1, -16, 0, 28),
		Position = UDim2.fromOffset(10, 4),
		Text = name,
		Font = Theme.FontSemi,
		TextSize = Theme.TextSection,
		TextColor3 = Theme.Text,
		BackgroundTransparency = 1,
	}, frame)

	local body = mk("Frame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, frame)
	pad(body, 2, 10, 10, 10)
	listLayout(body, 4)

	local section = setmetatable({
		Tab = self,
		Window = self.Window,
		Name = name,
		Frame = frame,
		Body = body,
		Elements = {},
	}, Section)
	table.insert(self.Sections, section)
	self.CurrentSection = section
	return section
end

local function ensureSection(tab)
	if not tab.CurrentSection then
		return tab:AddSection({ Name = tab.Name })
	end
	return tab.CurrentSection
end

