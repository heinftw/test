					Font = THEME.Fonts.Body,
					Text = "▾",
					TextSize = 12,
					TextColor3 = THEME.Colors.TextMuted,
					Parent = Box,
				})

				local open = false
				local ListFrame

				local Element = { Type = "Dropdown", Instance = Row, _window = Window }

				function Element:Set(newValue, silent)
					value = newValue
					SelectedLabel.Text = tostring(value or "")
					if not silent then
						callback(value)
					end
				end

				function Element:Get()
					return value
				end

				-- Generic list-refresh helper (used by any consumer that needs to
				-- repopulate a dropdown's options at runtime, e.g. a config list).
				function Element:Refresh(newOptions, newDefault)
					options = newOptions or options
					if newDefault ~= nil then
						Element:Set(newDefault, true)
					elseif not table.find(options, value) then
						Element:Set(options[1], true)
					else
						SelectedLabel.Text = tostring(value or "")
					end
				end

				local function closeList()
					open = false
					if ListFrame then
						ListFrame:Destroy()
						ListFrame = nil
					end
					Chevron.Text = "▾"
				end

				local function openList()
					open = true
					Chevron.Text = "▴"
					local abs = Box.AbsolutePosition
					local mainAbs = Window.Main.AbsolutePosition
					local relX = abs.X - mainAbs.X
					local relY = abs.Y - mainAbs.Y + Box.AbsoluteSize.Y + 2

					ListFrame = New("Frame", {
						BackgroundColor3 = THEME.Colors.Overlay,
						Position = UDim2.new(0, relX, 0, relY),
						Size = UDim2.new(0, Box.AbsoluteSize.X, 0, math.min(#options * 22 + 8, 150)),
						ZIndex = 60,
						Parent = Window.Overlay,
					}, {
						New("UICorner", { CornerRadius = UDim.new(0, 6) }),
						New("UIStroke", { Color = THEME.Colors.InputStroke, Thickness = 1 }),
						New("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }),
					})

					local ListScroll = New("ScrollingFrame", {
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 1, 0),
						CanvasSize = UDim2.new(0, 0, 0, #options * 22),
						ScrollBarThickness = 2,
						ScrollBarImageColor3 = THEME.Colors.Accent,
						BorderSizePixel = 0,
						ZIndex = 60,
						Parent = ListFrame,
					}, {
						New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
					})

					for i, opt in ipairs(options) do
						local OptButton = New("TextButton", {
							BackgroundTransparency = 1,
							Size = UDim2.new(1, 0, 0, 22),
							AutoButtonColor = false,
							Font = THEME.Fonts.Body,
							Text = "  " .. tostring(opt),
							TextSize = THEME.Text.Small,
							TextColor3 = (opt == value) and THEME.Colors.Accent or THEME.Colors.TextPrimary,
							TextXAlignment = Enum.TextXAlignment.Left,
							ZIndex = 61,
							LayoutOrder = i,
							Parent = ListScroll,
						})
						OptButton.MouseEnter:Connect(function()
							OptButton.BackgroundTransparency = 0
							OptButton.BackgroundColor3 = THEME.Colors.NavHover
						end)
						OptButton.MouseLeave:Connect(function()
							OptButton.BackgroundTransparency = 1
						end)
						OptButton.MouseButton1Click:Connect(function()
							Element:Set(opt)
							closeList()
						end)
					end
				end

				Box.MouseButton1Click:Connect(function()
					if open then
						closeList()
					else
						openList()
					end
				end)

				RegisterFlag(flag, Element)
				return Element
			end

