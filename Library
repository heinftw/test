--=============================================================
-- INTERNAL HELPERS
--=============================================================
local Library = {}
Library.Flags = {}
Library.Windows = {}
Library.Theme = THEME

local function New(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function Tween(obj, props, time, style, direction)
	local info = TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local tw = TweenService:Create(obj, info, props)
	tw:Play()
	return tw
end

local function GetGuiParent()
	local ok, hui = pcall(function()
		return gethui and gethui() or nil
	end)
	if ok and hui then
		return hui
	end

	local ok2, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if ok2 and coreGui then
		return coreGui
	end

	local player = game:GetService("Players").LocalPlayer
	return player:WaitForChild("PlayerGui")
end

local function MakeDraggable(handle, target)
	local dragging = false
	local dragStart = nil
	local startPos = nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	handle.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function RegisterFlag(flag, element)
	if flag and flag ~= "" then
		Library.Flags[flag] = element
	end
end

--=============================================================
-- ELEMENT BASE ROW BUILDER
--=============================================================
local function BaseRow(parent, height)
	return New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 34),
		Parent = parent,
	})
end

--=============================================================
-- LIBRARY:CREATEWINDOW
--=============================================================
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local windowName = cfg.Name or "Xanax"
	local size = cfg.Size or UDim2.new(0, 650, 0, 400)

	local ScreenGui = New("ScreenGui", {
		Name = "XanaxUI_" .. HttpService:GenerateGUID(false),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = true,
	})
	ScreenGui.Parent = GetGuiParent()

	local Main = New("Frame", {
		Name = "Main",
		BackgroundColor3 = THEME.Colors.WindowBackground,
		Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
		Size = size,
		Active = true,
		ClipsDescendants = true,
		Parent = ScreenGui,
	}, {
		New("UICorner", { CornerRadius = UDim.new(0, 8) }),
		New("UIStroke", { Color = THEME.Colors.WindowStroke, Thickness = 1 }),
	})

	-- Overlay layer sits above everything and never clips, used for
	-- dropdown lists / color picker popups so ScrollingFrames never cut them off.
	local Overlay = New("Frame", {
		Name = "Overlay",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 50,
		Parent = Main,
	})

	----------------------------------------------------------
	-- Sidebar
	----------------------------------------------------------
	local Sidebar = New("Frame", {
		Name = "Sidebar",
		BackgroundColor3 = THEME.Colors.Sidebar,
		Size = UDim2.new(0, 150, 1, 0),
		Active = true,
		Parent = Main,
	}, {
		New("UICorner", { CornerRadius = UDim.new(0, 8) }),
	})

	-- mask the right-side rounded corners of the sidebar so it reads as square against content
	New("Frame", {
		BackgroundColor3 = THEME.Colors.Sidebar,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -10, 0, 0),
		Size = UDim2.new(0, 10, 1, 0),
		Parent = Sidebar,
	})

	New("Frame", {
		BackgroundColor3 = THEME.Colors.SidebarStroke,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -1, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
		Parent = Sidebar,
	})

	local LogoRow = New("Frame", {
		Name = "LogoRow",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 42),
		Active = true,
		Parent = Sidebar,
	})
	MakeDraggable(LogoRow, Main)

	New("Frame", {
		BackgroundColor3 = THEME.Colors.Accent,
		Position = UDim2.new(0, 14, 0.5, -4),
		Size = UDim2.new(0, 8, 0, 8),
		Parent = LogoRow,
	}, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 30, 0, 0),
		Size = UDim2.new(1, -40, 1, 0),
		Font = THEME.Fonts.Logo,
		Text = windowName,
		TextSize = THEME.Text.Logo,
		TextColor3 = THEME.Colors.TextPrimary,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = LogoRow,
	})

	New("Frame", {
		BackgroundColor3 = THEME.Colors.SidebarStroke,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 42),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = Sidebar,
	})

	local NavHolder = New("Frame", {
		Name = "NavHolder",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 50),
		Size = UDim2.new(1, 0, 1, -100),
		Parent = Sidebar,
	}, {
		New("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 2),
		}),
		New("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
	})

	----------------------------------------------------------
	-- Search box (visual only, filters nothing by default — cosmetic
	-- to match the reference image; kept purely presentational)
	----------------------------------------------------------
	local SearchBox = New("Frame", {
		BackgroundColor3 = THEME.Colors.InputBackground,
		Position = UDim2.new(0, 10, 1, -38),
		Size = UDim2.new(1, -20, 0, 26),
		Parent = Sidebar,
	}, {
		New("UICorner", { CornerRadius = UDim.new(0, 6) }),
		New("UIStroke", { Color = THEME.Colors.InputStroke, Thickness = 1 }),
	})

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 8, 0, 0),
		Size = UDim2.new(0, 14, 1, 0),
		Font = THEME.Fonts.Body,
		Text = "⌕",
		TextSize = 14,
		TextColor3 = THEME.Colors.TextDim,
		Parent = SearchBox,
	})

	local SearchInput = New("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 24, 0, 0),
		Size = UDim2.new(1, -30, 1, 0),
		Font = THEME.Fonts.Body,
		PlaceholderText = "Search...",
		Text = "",
		TextSize = THEME.Text.Small,
		TextColor3 = THEME.Colors.TextPrimary,
		PlaceholderColor3 = THEME.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = SearchBox,
	})

	----------------------------------------------------------
	-- Content area
	----------------------------------------------------------
	local Content = New("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 150, 0, 0),
		Size = UDim2.new(1, -150, 1, 0),
		Parent = Main,
	})

	local Window = {}
	Window.ScreenGui = ScreenGui
	Window.Main = Main
	Window.Sidebar = Sidebar
	Window.Content = Content
	Window.Overlay = Overlay
	Window.Tabs = {}
	Window.Visible = true
	Window._tabCount = 0

	function Window:SetVisible(bool)
		Window.Visible = bool
		ScreenGui.Enabled = bool
	end

	function Window:Toggle()
		Window:SetVisible(not Window.Visible)
	end

	function Window:Destroy()
		for flag, el in pairs(Library.Flags) do
			if el._window == Window then
				Library.Flags[flag] = nil
			end
		end
		ScreenGui:Destroy()
	end

	----------------------------------------------------------
	-- Hidden UI-toggle keybind (RightShift) — functional only
	----------------------------------------------------------
	Window._toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	Window._inputConn = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Window._toggleKey then
			Window:Toggle()
		end
	end)

	----------------------------------------------------------
	-- Window:CreateTab
	----------------------------------------------------------
	function Window:CreateTab(tabCfg)
		tabCfg = tabCfg or {}
		local tabName = tabCfg.Name or "Tab"
		local icon = tabCfg.Icon or "◆"
		local columns = tabCfg.Columns or 1

		Window._tabCount += 1
		local order = Window._tabCount
		local isFirst = order == 1

		local NavButton = New("TextButton", {
			Name = tabName,
			BackgroundColor3 = THEME.Colors.NavSelectedBg,
			BackgroundTransparency = isFirst and 0 or 1,
			AutoButtonColor = false,
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = order,
			Text = "",
			Parent = NavHolder,
		}, {
			New("UICorner", { CornerRadius = UDim.new(0, 6) }),
		})

		New("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 10, 0, 0),
			Size = UDim2.new(0, 18, 1, 0),
			Font = THEME.Fonts.Body,
			Text = icon,
			TextSize = 13,
			TextColor3 = isFirst and THEME.Colors.Accent or THEME.Colors.TextMuted,
			Name = "Icon",
			Parent = NavButton,
		})

		New("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 30, 0, 0),
			Size = UDim2.new(1, -36, 1, 0),
			Font = THEME.Fonts.Body,
			Text = tabName,
			TextSize = THEME.Text.Body,
			TextColor3 = isFirst and THEME.Colors.Accent or THEME.Colors.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Name = "Label",
			Parent = NavButton,
		})

		local Page = New("Frame", {
			Name = tabName .. "Page",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			Visible = isFirst,
			Parent = Content,
		}, {
			New("UIPadding", {
				PaddingLeft = UDim.new(0, 12),
				PaddingRight = UDim.new(0, 12),
				PaddingTop = UDim.new(0, 12),
				PaddingBottom = UDim.new(0, 12),
			}),
			New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 10),
			}),
		})

		local Tab = {}
		Tab.Name = tabName
		Tab.Window = Window
		Tab.Page = Page
		Tab.NavButton = NavButton
		Tab.Columns = {}

		local colWidth = 1 / columns
		for i = 1, columns do
			local ColumnScroll = New("ScrollingFrame", {
				Name = "Column" .. i,
				BackgroundTransparency = 1,
				Size = UDim2.new(colWidth, i < columns and -5 or -((columns - 1) * 5), 1, 0),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = THEME.Colors.Accent,
				BorderSizePixel = 0,
				LayoutOrder = i,
				Parent = Page,
			}, {
				New("UIListLayout", {
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 10),
				}),
			})
			Tab.Columns[i] = ColumnScroll
		end

		Window.Tabs[tabName] = Tab

		NavButton.MouseButton1Click:Connect(function()
			for _, t in pairs(Window.Tabs) do
				t.Page.Visible = false
				t.NavButton.BackgroundTransparency = 1
				t.NavButton.Icon.TextColor3 = THEME.Colors.TextMuted
				t.NavButton.Label.TextColor3 = THEME.Colors.TextMuted
			end
			Page.Visible = true
			NavButton.BackgroundTransparency = 0
			NavButton.Icon.TextColor3 = THEME.Colors.Accent
			NavButton.Label.TextColor3 = THEME.Colors.Accent
		end)

		NavButton.MouseEnter:Connect(function()
			if Page.Visible then return end
			Tween(NavButton, { BackgroundColor3 = THEME.Colors.NavHover }, 0.1)
			NavButton.BackgroundTransparency = 0
		end)
		NavButton.MouseLeave:Connect(function()
			if Page.Visible then return end
			NavButton.BackgroundTransparency = 1
		end)

		----------------------------------------------------------
		-- Tab:AddSection  (a "card" like Ragebot / Silent Aim / Anti Aim)
		----------------------------------------------------------
		function Tab:AddSection(sectionCfg)
			sectionCfg = sectionCfg or {}
			local column = Tab.Columns[sectionCfg.Column or 1] or Tab.Columns[1]

			local Card = New("Frame", {
				BackgroundColor3 = THEME.Colors.Card,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = sectionCfg.Order or 0,
				Parent = column,
			}, {
				New("UICorner", { CornerRadius = UDim.new(0, 6) }),
				New("UIStroke", { Color = THEME.Colors.CardStroke, Thickness = 1 }),
				New("UIPadding", {
					PaddingLeft = UDim.new(0, 10),
					PaddingRight = UDim.new(0, 10),
					PaddingTop = UDim.new(0, 10),
					PaddingBottom = UDim.new(0, 10),
				}),
				New("UIListLayout", {
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 8),
				}),
			})

			if sectionCfg.Name then
				New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 16),
					Font = THEME.Fonts.Header,
					Text = sectionCfg.Name,
					TextSize = THEME.Text.SectionHeader,
					TextColor3 = THEME.Colors.TextPrimary,
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = -1,
					Parent = Card,
				})
			end

			local Section = {}
			Section.Instance = Card
			Section.Window = Window
			Section._order = 0

			local function nextOrder()
				Section._order += 1
				return Section._order
			end

			----------------------------------------------------------
			-- AddLabel
			----------------------------------------------------------
			function Section:AddLabel(elCfg)
				elCfg = elCfg or {}
				local Row = BaseRow(Card, 16)
				Row.LayoutOrder = nextOrder()
				New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 1, 0),
					Font = THEME.Fonts.Body,
					Text = elCfg.Text or "Label",
					TextSize = THEME.Text.Small,
					TextColor3 = THEME.Colors.TextMuted,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Row,
				})
				local Element = { Type = "Label", Instance = Row, _window = Window }
				function Element:Set(text) Row:FindFirstChildOfClass("TextLabel").Text = text end
				function Element:Get() return Row:FindFirstChildOfClass("TextLabel").Text end
				return Element
			end

			----------------------------------------------------------
			-- AddParagraph
			----------------------------------------------------------
			function Section:AddParagraph(elCfg)
				elCfg = elCfg or {}
				local Row = New("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = nextOrder(),
					Parent = Card,
				}, {
					New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
				})
				New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 14),
					Font = THEME.Fonts.Header,
					Text = elCfg.Title or "Paragraph",
					TextSize = THEME.Text.Small,
					TextColor3 = THEME.Colors.TextPrimary,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Row,
				})
				New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Font = THEME.Fonts.Body,
					Text = elCfg.Content or "",
					TextSize = THEME.Text.Tiny,
					TextColor3 = THEME.Colors.TextMuted,
					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Row,
				})
				return { Type = "Paragraph", Instance = Row, _window = Window }
			end

			----------------------------------------------------------
			-- AddDivider (small caps sub-header used e.g. "Targeting")
			----------------------------------------------------------
			function Section:AddDivider(elCfg)
				elCfg = elCfg or {}
				local Row = BaseRow(Card, 18)
				Row.LayoutOrder = nextOrder()
				New("Frame", {
					BackgroundColor3 = THEME.Colors.Divider,
					BorderSizePixel = 0,
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.new(1, 0, 0, 1),
					ZIndex = 1,
					Parent = Row,
				})
				New("TextLabel", {
					BackgroundColor3 = THEME.Colors.Card,
					Position = UDim2.new(0, 0, 0, 0),
					Size = UDim2.new(0, 0, 1, 0),
					AutomaticSize = Enum.AutomaticSize.X,
					Font = THEME.Fonts.Header,
					Text = "  " .. (elCfg.Text or "SECTION") .. "  ",
					TextSize = THEME.Text.Tiny,
					TextColor3 = THEME.Colors.TextDim,
					ZIndex = 2,
					Parent = Row,
				})
				return { Type = "Divider", Instance = Row, _window = Window }
			end

			----------------------------------------------------------
			-- AddToggle
			----------------------------------------------------------
			function Section:AddToggle(elCfg)
				elCfg = elCfg or {}
				local flag = elCfg.Flag
				local value = elCfg.Default or false
				local callback = elCfg.Callback or function() end

				local Row = BaseRow(Card, 20)
				Row.LayoutOrder = nextOrder()

				New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, -46, 1, 0),
					Font = THEME.Fonts.Body,
					Text = elCfg.Name or "Toggle",
					TextSize = THEME.Text.Body,
					TextColor3 = THEME.Colors.TextPrimary,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Row,
				})

				local Switch = New("Frame", {
					BackgroundColor3 = value and THEME.Colors.Accent or THEME.Colors.ToggleOff,
					Position = UDim2.new(1, -36, 0.5, -9),
					Size = UDim2.new(0, 36, 0, 18),
					Parent = Row,
				}, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

				local Knob = New("Frame", {
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					Position = value and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
					Size = UDim2.new(0, 14, 0, 14),
					Parent = Switch,
				}, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

				local Click = New("TextButton", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 1, 0),
					Text = "",
					Parent = Row,
				})

				local Element = { Type = "Toggle", Instance = Row, _window = Window }

				function Element:Set(newValue, silent)
					value = newValue and true or false
					Tween(Switch, { BackgroundColor3 = value and THEME.Colors.Accent or THEME.Colors.ToggleOff }, 0.12)
					Tween(Knob, { Position = value and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) }, 0.12)
					if not silent then
						callback(value)
					end
				end

				function Element:Get()
					return value
				end

				Click.MouseButton1Click:Connect(function()
					Element:Set(not value)
				end)

				RegisterFlag(flag, Element)
				return Element
			end

			----------------------------------------------------------
			-- AddSlider
			----------------------------------------------------------
			function Section:AddSlider(elCfg)
				elCfg = elCfg or {}
				local flag = elCfg.Flag
				local min = elCfg.Min or 0
				local max = elCfg.Max or 100
				local increment = elCfg.Increment or 1
				local value = elCfg.Default or min
				local suffix = elCfg.Suffix or ""
				local callback = elCfg.Callback or function() end

				local Row = New("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 34),
					LayoutOrder = nextOrder(),
					Parent = Card,
				})

				New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, -50, 0, 16),
					Font = THEME.Fonts.Body,
					Text = elCfg.Name or "Slider",
					TextSize = THEME.Text.Body,
					TextColor3 = THEME.Colors.TextPrimary,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Row,
				})

				local ValueLabel = New("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.new(1, -50, 0, 0),
					Size = UDim2.new(0, 50, 0, 16),
					Font = THEME.Fonts.Body,
					Text = tostring(value) .. suffix,
					TextSize = THEME.Text.Small,
					TextColor3 = THEME.Colors.TextMuted,
					TextXAlignment = Enum.TextXAlignment.Right,
					Parent = Row,
				})

				local Track = New("Frame", {
					BackgroundColor3 = THEME.Colors.SliderTrack,
					Position = UDim2.new(0, 0, 0, 24),
					Size = UDim2.new(1, 0, 0, 4),
					Parent = Row,
				}, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

				local Fill = New("Frame", {
					BackgroundColor3 = THEME.Colors.Accent,
					Size = UDim2.new(0, 0, 1, 0),
					Parent = Track,
				}, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

				local Knob = New("Frame", {
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					Position = UDim2.new(0, -5, 0.5, -5),
					Size = UDim2.new(0, 10, 0, 10),
					ZIndex = 2,
					Parent = Fill,
				}, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

				local dragging = false

				local function updateVisual()
					local alpha = (value - min) / (max - min)
					alpha = math.clamp(alpha, 0, 1)
					Fill.Size = UDim2.new(alpha, 0, 1, 0)
					ValueLabel.Text = tostring(value) .. suffix
				end
				updateVisual()

				local Element = { Type = "Slider", Instance = Row, _window = Window }

				function Element:Set(newValue, silent)
					newValue = math.clamp(newValue, min, max)
					newValue = math.floor((newValue - min) / increment + 0.5) * increment + min
					value = newValue
					updateVisual()
					if not silent then
						callback(value)
					end
				end

				function Element:Get()
					return value
				end

				local function setFromX(xPos)
					local rel = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
					local newVal = min + (max - min) * rel
					Element:Set(newVal)
				end

				Track.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						setFromX(input.Position.X)
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						setFromX(input.Position.X)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)

				RegisterFlag(flag, Element)
				return Element
			end

