-- Slider
function Section:AddSlider(opts)
	opts = opts or {}
	local min = opts.Min or 0
	local max = opts.Max or 100
	local default = opts.Default or min
	local suffix = opts.Suffix or opts.Unit or ""
	local decimals = opts.Decimals or 0

	local row = makeRow(self, Theme.SliderH)
	local top = mk("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
	}, row)
	mk("TextLabel", {
		Size = UDim2.new(0.7, 0, 1, 0),
		Text = opts.Name or "Slider",
		TextSize = Theme.TextBody,
		TextColor3 = Theme.Muted,
		BackgroundTransparency = 1,
	}, top)
	local valueLbl = mk("TextLabel", {
		Size = UDim2.new(0.3, 0, 1, 0),
		Position = UDim2.new(0.7, 0, 0, 0),
		Text = "",
		TextSize = Theme.TextSmall,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
	}, top)

	local track = mk("Frame", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, Theme.TrackH),
		BackgroundColor3 = Theme.Track,
		BackgroundTransparency = 0,
	}, row)
	corner(track, Theme.TrackH / 2)

	local fill = mk("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0,
		Active = false,
	}, track)
	corner(fill, Theme.TrackH / 2)

	local thumb = mk("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Thumb,
		BackgroundTransparency = 0,
		ZIndex = 2,
		Active = false,
	}, track)
	corner(thumb, 6)
	stroke(thumb, Theme.Accent, 1)

	local el = setmetatable({
		Window = self.Window,
		Section = self,
		Name = opts.Name or "Slider",
		Flag = opts.Flag,
		Callback = opts.Callback,
		Row = row,
		Min = min,
		Max = max,
		_value = default,
	}, Element)

	local function fmt(v)
		if decimals <= 0 then return tostring(math.floor(v + 0.5)) .. suffix end
		return string.format("%." .. tostring(decimals) .. "f", v) .. suffix
	end

	function el:Validate(v)
		return typeof(v) == "number"
	end
	function el:_paint(v)
		v = math.clamp(v, min, max)
		local a = (max == min) and 0 or ((v - min) / (max - min))
		fill.Size = UDim2.new(a, 0, 1, 0)
		thumb.Position = UDim2.new(a, 0, 0.5, 0)
		valueLbl.Text = fmt(v)
	end
	function el:Set(v, silent)
		if not self:Validate(v) then return false end
		v = math.clamp(v, min, max)
		if decimals <= 0 then v = math.floor(v + 0.5) else v = math.floor(v * 10 ^ decimals + 0.5) / 10 ^ decimals end
		self._value = v
		self:_paint(v)
		if not silent and self.Callback then pcall(self.Callback, v) end
		return true
	end

	el:_register()
	el:Set(default, true)

	local sliding = false
	local function at(x)
		local abs = track.AbsolutePosition.X
		local w = track.AbsoluteSize.X
		if w <= 0 then return end
		local a = math.clamp((x - abs) / w, 0, 1)
		el:Set(min + (max - min) * a)
	end

	self.Window:Connect(track.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			at(input.Position.X)
		end
	end)
	self.Window:Connect(UserInputService.InputChanged, function(input)
		if not sliding then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			at(input.Position.X)
		end
	end)
	self.Window:Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	table.insert(self.Elements, el)
	return el
end

-- Dropdown
function Section:AddDropdown(opts)
	opts = opts or {}
	local items = {}
	for _, v in ipairs(opts.Options or opts.Values or {}) do
		if typeof(v) == "string" then items[#items + 1] = v end
	end
	local multi = opts.Multi == true
	local default = opts.Default
	if multi then
		if typeof(default) ~= "table" then default = {} end
	else
		if typeof(default) ~= "string" then default = items[1] or "" end
	end

	local row = makeRow(self, Theme.DropH)
	mk("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		Text = opts.Name or "Dropdown",
		TextSize = Theme.TextBody,
		TextColor3 = Theme.Muted,
		BackgroundTransparency = 1,
	}, row)

	local trigger = mk("TextButton", {
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = Theme.Input,
		BackgroundTransparency = 0,
		Text = "",
	}, row)
	corner(trigger, Theme.RadiusXs)
	stroke(trigger, Theme.Stroke)

	local tLabel = mk("TextLabel", {
		Size = UDim2.new(1, -28, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		Text = "",
		TextSize = Theme.TextSmall,
		TextColor3 = Theme.Text,
		BackgroundTransparency = 1,
	}, trigger)
	local chev = icon(trigger, "chevron", 10, Theme.Dim)
	chev.Position = UDim2.new(1, -18, 0.5, -5)

	local menu
	local el = setmetatable({
		Window = self.Window,
		Section = self,
		Name = opts.Name or "Dropdown",
		Flag = opts.Flag,
		Callback = opts.Callback,
		Row = row,
		Options = items,
		Multi = multi,
		_value = default,
		_open = false,
	}, Element)

	local function display(v)
		if multi then
			if typeof(v) ~= "table" or #v == 0 then return opts.Placeholder or "Select..." end
			return table.concat(v, ", ")
		end
		if v == nil or v == "" then return opts.Placeholder or "Select..." end
		return tostring(v)
	end

	function el:Validate(v)
		if multi then
			if typeof(v) ~= "table" then return false end
			for _, x in ipairs(v) do if not table.find(items, x) then return false end end
			return true
		end
		return typeof(v) == "string" and (v == "" or table.find(items, v) ~= nil)
	end
	function el:_paint(v)
		tLabel.Text = display(v)
		tLabel.TextColor3 = (v == "" or (typeof(v) == "table" and #v == 0)) and Theme.Dim or Theme.Text
	end
	function el:Close()
		self._open = false
		if menu then menu:Destroy(); menu = nil end
	end
	function el:Refresh(newItems, keep)
		items = {}
		for _, v in ipairs(newItems or {}) do if typeof(v) == "string" then items[#items + 1] = v end end
		self.Options = items
		local cur = keep ~= nil and keep or self:Get()
		if multi then
			local n = {}
			for _, x in ipairs(typeof(cur) == "table" and cur or {}) do
				if table.find(items, x) then n[#n + 1] = x end
			end
			self:Set(n, true)
		else
			if not table.find(items, cur) then cur = items[1] or "" end
			self:Set(cur, true)
		end
		if self._open then self:Close() end
	end
	function el:Open()
		if self._open then self:Close(); return end
		-- close other dropdowns
		for _, sec in ipairs(self.Section.Tab.Sections) do
			for _, e in ipairs(sec.Elements) do
				if e ~= self and e.Close then e:Close() end
			end
		end
		self._open = true
		local count = math.max(#items, 1)
		local h = math.min(count * 26 + 8, 160)
		menu = mk("ScrollingFrame", {
			Position = UDim2.fromOffset(0, 46),
			Size = UDim2.new(1, 0, 0, h),
			BackgroundColor3 = Theme.SectionTop,
			BackgroundTransparency = 0,
			ZIndex = 20,
			ScrollBarThickness = 3,
			CanvasSize = UDim2.fromOffset(0, count * 26 + 8),
		}, row)
		corner(menu, Theme.RadiusXs)
		stroke(menu, Theme.Accent)
		pad(menu, 4, 4, 4, 4)
		listLayout(menu, 2)

		if #items == 0 then
			mk("TextLabel", {
				Size = UDim2.new(1, 0, 0, 24),
				Text = "No options",
				TextSize = Theme.TextSmall,
				TextColor3 = Theme.Dim,
				BackgroundTransparency = 1,
			}, menu)
		end

		for _, item in ipairs(items) do
			local b = mk("TextButton", {
				Size = UDim2.new(1, 0, 0, 24),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 21,
			}, menu)
			corner(b, 4)
			local l = mk("TextLabel", {
				Size = UDim2.new(1, -28, 1, 0),
				Position = UDim2.fromOffset(8, 0),
				Text = item,
				TextSize = Theme.TextSmall,
				TextColor3 = Theme.Muted,
				BackgroundTransparency = 1,
				ZIndex = 22,
			}, b)
			local ck = icon(b, "check", 10, Theme.Accent)
			ck.Position = UDim2.new(1, -18, 0.5, -5)
			ck.Visible = false
			local function paintSel()
				local v = el:Get()
				local sel = multi and table.find(v, item) ~= nil or (not multi and v == item)
				ck.Visible = sel
				l.TextColor3 = sel and Theme.Text or Theme.Muted
				b.BackgroundTransparency = sel and 0.85 or 1
				b.BackgroundColor3 = Theme.Hover
			end
			paintSel()
			self.Window:Connect(b.MouseButton1Click, function()
				if multi then
					local v = el:Get()
					local i = table.find(v, item)
					if i then table.remove(v, i) else v[#v + 1] = item end
					el:Set(v)
					paintSel()
				else
					el:Set(item)
					el:Close()
				end
			end)
			self.Window:Connect(b.MouseEnter, function()
				b.BackgroundTransparency = 0.7
				b.BackgroundColor3 = Theme.Hover
			end)
			self.Window:Connect(b.MouseLeave, function()
				paintSel()
			end)
		end
	end

	el:_register()
	el:Set(default, true)

	self.Window:Connect(trigger.MouseButton1Click, function()
		el:Open()
	end)

	table.insert(self.Elements, el)
	return el
end

-- Button
function Section:AddButton(opts)
	opts = opts or {}
	local row = makeRow(self, Theme.RowH + 4)
	local btn = mk("TextButton", {
		Size = UDim2.new(1, 0, 0, Theme.RowH),
		BackgroundColor3 = Theme.Input,
		BackgroundTransparency = 0,
		Text = opts.Name or "Button",
		TextSize = Theme.TextBody,
		TextColor3 = Theme.Text,
		Font = Theme.FontSemi,
		TextXAlignment = Enum.TextXAlignment.Center,
	}, row)
	corner(btn, Theme.RadiusXs)
	local st = stroke(btn, Theme.Stroke)

	local el = setmetatable({
		Window = self.Window,
		Section = self,
		Name = opts.Name or "Button",
		Flag = opts.Flag,
		Callback = opts.Callback,
		Row = row,
		Button = btn,
		_value = false,
	}, Element)
	function el:Validate(v) return typeof(v) == "boolean" end
	function el:Set(v, silent)
		self._value = v and true or false
		if not silent and self.Callback then pcall(self.Callback) end
		return true
	end
	-- buttons typically not flagged; still allow
	el:_register()

	self.Window:Connect(btn.MouseButton1Click, function()
		if el.Callback then pcall(el.Callback) end
	end)
	self.Window:Connect(btn.MouseEnter, function()
		tween(btn, { BackgroundColor3 = Theme.Hover })
		tween(st, { Color = Theme.Accent })
	end)
	self.Window:Connect(btn.MouseLeave, function()
		tween(btn, { BackgroundColor3 = Theme.Input })
		tween(st, { Color = Theme.Stroke })
	end)

	table.insert(self.Elements, el)
	return el
end

-- Textbox
function Section:AddTextbox(opts)
	opts = opts or {}
	local row = makeRow(self, Theme.DropH)
	mk("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		Text = opts.Name or "Textbox",
		TextSize = Theme.TextBody,
		TextColor3 = Theme.Muted,
		BackgroundTransparency = 1,
	}, row)
	local box = mk("TextBox", {
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = Theme.Input,
		BackgroundTransparency = 0,
		Text = opts.Default or "",
		PlaceholderText = opts.Placeholder or "",
		TextSize = Theme.TextSmall,
		TextColor3 = Theme.Text,
	}, row)
	corner(box, Theme.RadiusXs)
	local st = stroke(box, Theme.Stroke)
	pad(box, 0, 8, 0, 8)

	local el = setmetatable({
		Window = self.Window,
		Section = self,
		Name = opts.Name or "Textbox",
		Flag = opts.Flag,
		Callback = opts.Callback,
		Row = row,
		Input = box,
		Stroke = st,
		_value = opts.Default or "",
	}, Element)
	function el:Validate(v) return typeof(v) == "string" end
	function el:_paint(v)
		if box.Text ~= v then box.Text = v end
	end
	el:_register()
	el:Set(opts.Default or "", true)

	local painting = false
	self.Window:Connect(box:GetPropertyChangedSignal("Text"), function()
		if painting then return end
		el._value = box.Text
		if el.Callback then pcall(el.Callback, box.Text) end
	end)
	-- allow external Set without feedback loop
	local oldPaint = el._paint
	function el:_paint(v)
		painting = true
		oldPaint(self, v)
		painting = false
	end

	table.insert(self.Elements, el)
	return el
end

