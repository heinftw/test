			function Section:AddColorPicker(elCfg)
				elCfg = elCfg or {}
				local flag = elCfg.Flag
				local value = elCfg.Default or Color3.fromRGB(255, 255, 255)
				local callback = elCfg.Callback or function() end

				local Row = BaseRow(Card, 24)
				Row.LayoutOrder = nextOrder()

				New("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, -34, 1, 0),
					Font = THEME.Fonts.Body,
					Text = elCfg.Name or "Color",
					TextSize = THEME.Text.Body,
					TextColor3 = THEME.Colors.TextPrimary,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Row,
				})

				local Swatch = New("TextButton", {
					BackgroundColor3 = value,
					Position = UDim2.new(1, -28, 0.5, -11),
					Size = UDim2.new(0, 28, 0, 22),
					AutoButtonColor = false,
					Text = "",
					Parent = Row,
				}, {
					New("UICorner", { CornerRadius = UDim.new(0, 6) }),
					New("UIStroke", { Color = THEME.Colors.InputStroke, Thickness = 1 }),
				})

				local open = false
				local Popup

				local Element = { Type = "ColorPicker", Instance = Row, _window = Window }

				function Element:Set(newValue, silent)
					value = newValue
					Swatch.BackgroundColor3 = value
					if not silent then
						callback(value)
					end
				end

				function Element:Get()
					return value
				end

				local function closePopup()
					open = false
					if Popup then
						Popup:Destroy()
						Popup = nil
					end
				end

				local function buildChannelSlider(parent, label, order, initial, onChange)
					local SRow = New("Frame", {
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 0, 28),
						LayoutOrder = order,
						Parent = parent,
					})
					New("TextLabel", {
						BackgroundTransparency = 1,
						Size = UDim2.new(0, 16, 0, 14),
						Font = THEME.Fonts.Body,
						Text = label,
						TextSize = THEME.Text.Tiny,
						TextColor3 = THEME.Colors.TextMuted,
						Parent = SRow,
					})
					local Track = New("Frame", {
						BackgroundColor3 = THEME.Colors.SliderTrack,
						Position = UDim2.new(0, 0, 0, 18),
						Size = UDim2.new(1, 0, 0, 4),
						Parent = SRow,
					}, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
					local Fill = New("Frame", {
						BackgroundColor3 = THEME.Colors.Accent,
						Size = UDim2.new(initial / 255, 0, 1, 0),
						Parent = Track,
					}, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

					local dragging = false
					local function setFromX(x)
						local rel = math.clamp((x - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
						Fill.Size = UDim2.new(rel, 0, 1, 0)
						onChange(math.floor(rel * 255))
					end
					Track.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							dragging = true
							setFromX(input.Position.X)
						end
					end)
					UserInputService.InputChanged:Connect(function(input)
						if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
							setFromX(input.Position.X)
						end
					end)
					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							dragging = false
						end
					end)
				end

				local function openPopup()
					open = true
					local abs = Swatch.AbsolutePosition
					local mainAbs = Window.Main.AbsolutePosition
					local relX = math.min(abs.X - mainAbs.X - 120, Window.Main.AbsoluteSize.X - 160)
					local relY = abs.Y - mainAbs.Y + Swatch.AbsoluteSize.Y + 2

					local r, g, b = value.R * 255, value.G * 255, value.B * 255

					Popup = New("Frame", {
						BackgroundColor3 = THEME.Colors.Overlay,
						Position = UDim2.new(0, relX, 0, relY),
						Size = UDim2.new(0, 150, 0, 110),
						ZIndex = 60,
						Parent = Window.Overlay,
					}, {
						New("UICorner", { CornerRadius = UDim.new(0, 6) }),
						New("UIStroke", { Color = THEME.Colors.InputStroke, Thickness = 1 }),
						New("UIPadding", {
							PaddingLeft = UDim.new(0, 8),
							PaddingRight = UDim.new(0, 8),
							PaddingTop = UDim.new(0, 8),
							PaddingBottom = UDim.new(0, 8),
						}),
						New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
					})

					buildChannelSlider(Popup, "R", 1, r, function(nv)
						r = nv
						Element:Set(Color3.fromRGB(r, g, b))
					end)
					buildChannelSlider(Popup, "G", 2, g, function(nv)
						g = nv
						Element:Set(Color3.fromRGB(r, g, b))
					end)
					buildChannelSlider(Popup, "B", 3, b, function(nv)
						b = nv
						Element:Set(Color3.fromRGB(r, g, b))
					end)
				end

				Swatch.MouseButton1Click:Connect(function()
					if open then
						closePopup()
					else
						openPopup()
					end
				end)

				RegisterFlag(flag, Element)
				return Element
			end

			return Section
		end

		return Tab
	end

	Library.Windows[#Library.Windows + 1] = Window
	return Window
