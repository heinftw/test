-- Utilities ----------------------------------------------------------------------

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

-- Luau builtins with plain-Lua fallbacks (executors always provide them)
local tableFind = table.find or function(list, value)
	for index, entry in ipairs(list) do
		if entry == value then
			return index
		end
	end
	return nil
end
local mathClamp = math.clamp or function(value, min, max)
	return math.max(min, math.min(max, value))
end

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function isHex(value)
	return type(value) == "string" and value:match("^#%x%x%x%x%x%x$") ~= nil
end

local function toColor(value, fallback)
	if typeof(value) == "Color3" then
		return value
	end
	if isHex(value) then
		return Color3.fromRGB(
			tonumber(value:sub(2, 3), 16),
			tonumber(value:sub(4, 5), 16),
			tonumber(value:sub(6, 7), 16)
		)
	end
	if type(value) == "string" and value:match("^%x%x%x%x%x%x$") then
		return toColor("#" .. value, fallback)
	end
	return fallback
end

local function toHex(value)
	return string.format("#%02x%02x%02x", math.floor(value.R * 255 + 0.5), math.floor(value.G * 255 + 0.5), math.floor(value.B * 255 + 0.5))
end

local function lighten(color3, amount)
	return color3:Lerp(WHITE, amount)
end

local function darken(color3, amount)
	return color3:Lerp(BLACK, amount)
end

local function clamp(value, min, max)
	return math.max(min, math.min(max, value))
end

local function prettifyKey(name)
	-- "RightShift" -> "Right Shift"; "F1" stays "F1"; existing spaces preserved.
	if type(name) ~= "string" then
		return name
	end
	local spaced = name:gsub("(%l)(%u)", "%1 %2")
	spaced = spaced:gsub("(%l)(%d)", "%1 %2")
	return spaced
end

local function resolveKeyCode(name)
	if type(name) == "string" then
		local compact = name:gsub("%s+", "")
		local ok, code = pcall(function()
			return Enum.KeyCode[compact]
		end)
		if ok and code then
			return code
		end
	end
	return nil
end

-- Only these keys may toggle the menu (matches the original whitelist)
local MENU_KEYS = { RightShift = true, Insert = true, Home = true, F4 = true }

local function new(className, properties, parent)
	local object = Instance.new(className)
	local ok, message = pcall(function()
		for property, value in pairs(properties) do
			object[property] = value
		end
		object.Parent = parent
	end)
	if not ok then
		object:Destroy()
		error(string.format("[xanax.ui] Cannot create %s: %s", className, tostring(message)), 2)
	end
	return object
end

local function resolveGuiParent()
	local ok, hui = pcall(function()
		return gethui()
	end)
	if ok and hui then
		return hui
	end
	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		return coreGui
	end
	local player = Players.LocalPlayer
	if player then
		local okPg, playerGui = pcall(function()
			return player:WaitForChild("PlayerGui", 10)
		end)
		if okPg and playerGui then
			return playerGui
		end
	end
	return nil
end

-- Signals (pure Lua, loop-safe, pcall-isolated handlers) --------------------------

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(handler)
	local connection = { Connected = true }
	connection.Handler = handler
	function connection.Disconnect(self)
		connection.Connected = false
		for index, entry in ipairs(connection._signal._handlers or {}) do
			if entry == connection then
				table.remove(connection._signal._handlers, index)
				break
			end
		end
	end
	connection._signal = self
	table.insert(self._handlers, connection)
	return connection
end

function Signal:Once(handler)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal:Fire(...)
	local snapshot = {}
	for index, connection in ipairs(self._handlers) do
		snapshot[index] = connection
	end
	for _, connection in ipairs(snapshot) do
		if connection.Connected then
			local ok, err = pcall(connection.Handler, ...)
			if not ok then
				warn("[xanax.ui] signal handler error: " .. tostring(err))
			end
		end
	end
end

function Signal:DisconnectAll()
	for _, connection in ipairs(self._handlers) do
		connection.Connected = false
	end
	self._handlers = {}
end

Library.Signal = Signal

-- Motion engine -------------------------------------------------------------------
-- Library:Tween is the ONLY tween entry point. It cancels any active tween that
-- owns the same object+property before playing, so spam is always safe.

local function styleFor(style)
	if style == "Quint" then
		return Ease.Quint, EaseDir
	elseif style == "Back" then
		return Ease.Back, EaseDir
	end
	return Ease.Quad, EaseDir
end

local function animationsActive()
	return Library.AnimationsEnabled and not GuiService.ReducedMotionEnabled
end

function Library:Tween(object, properties, duration, style)
	if not object or not object.Parent then
		return
	end
	local slot = TweenRegistry[object]
	if slot then
		for property in pairs(properties) do
			local active = slot[property]
			if active then
				active:Cancel()
				slot[property] = nil
			end
		end
	end
	local resolvedDuration = duration or Tokens.FAST
	if not animationsActive() or resolvedDuration <= 0 then
		for property, value in pairs(properties) do
			object[property] = value
		end
		return
	end
	local easingStyle = styleFor(style)
	slot = TweenRegistry[object]
	if not slot then
		slot = {}
		TweenRegistry[object] = slot
	end
	for property, value in pairs(properties) do
		local tween = TweenService:Create(object, TweenInfo.new(resolvedDuration, easingStyle, EaseDir), { [property] = value })
		slot[property] = tween
		tween.Completed:Once(function()
			if slot[property] == tween then
				slot[property] = nil
			end
		end)
		tween:Play()
	end
end

function Library:CancelTweens(object)
	local slot = TweenRegistry[object]
	if not slot then
		return
	end
	for property, tween in pairs(slot) do
		tween:Cancel()
		slot[property] = nil
	end
	TweenRegistry[object] = nil
end

local function cancelTweenTree(root)
	local function walk(object)
		Library:CancelTweens(object)
		for _, child in ipairs(object:GetChildren()) do
			walk(child)
		end
	end
	walk(root)
end

-- Theme ----------------------------------------------------------------------------

local DEFAULT_THEME = {
	Window = "#111111",
	Panel = "#161616",
	Border = "#0a0a0a",
	Edge = "#1a1a1a",
	Text = "#c8c8c8",
	Muted = "#707070",
	Accent = "#50c7ce",
	Hover = "#1e1e1e",
	Press = "#252525",
}

for key, hex in pairs(DEFAULT_THEME) do
	Library.Theme[key] = toColor(hex)
end

function Library:SetTheme(key, value)
	local color3 = toColor(value, nil)
	if not color3 or not DEFAULT_THEME[key] then
		return false, "Unknown theme key or invalid color: " .. tostring(key)
	end
	Library.Theme[key] = color3
	for _, painter in ipairs(Library._Painters) do
		pcall(painter)
	end
	return true
end

function Library:GetTheme()
	local copy = {}
	for key, value in pairs(Library.Theme) do
		copy[key] = value
	end
	return copy
end

function Library:SetAnimationsEnabled(enabled)
	Library.AnimationsEnabled = enabled == true
	if not Library.AnimationsEnabled then
		for object, slot in pairs(TweenRegistry) do
			for property, tween in pairs(slot) do
				tween:Cancel()
				slot[property] = nil
			end
			TweenRegistry[object] = nil
		end
	end
	return true
end

function Library:SetNotificationsEnabled(enabled)
	Library.NotificationsEnabled = enabled == true
	return true
end

-- Notifications ---------------------------------------------------------------------
-- Toast stack with spring slide-in, timed accent progress bar, slide-out.

local NotificationHost = nil

local function ensureNotificationHost()
	if NotificationHost and NotificationHost.Gui.Parent then
		return NotificationHost
	end
	local parent = resolveGuiParent()
	local gui = new("ScreenGui", {
		Name = "XanaxUI_Notifications",
		ResetOnSpawn = false,
		DisplayOrder = 21,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
	}, parent)
	local holder = new("Frame", {
		Name = "Stack",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.new(0, 264, 1, -28),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, gui)
	NotificationHost = { Gui = gui, Holder = holder, Toasts = {} }
	return NotificationHost
end

local Toast = {}
Toast.__index = Toast

function Toast:Dismiss()
	local self = self
	if self.Closed then
		return
	end
	self.Closed = true
	local host = NotificationHost
	if host then
		for index, toast in ipairs(host.Toasts) do
			if toast == self then
				table.remove(host.Toasts, index)
				break
			end
		end
		for index, toast in ipairs(host.Toasts) do
			Library:Tween(toast.Frame, { Position = UDim2.new(1, -264, 0, (index - 1) * 64) }, Tokens.BASE, "Quint")
		end
	end
	if self.Frame and self.Frame.Parent then
		Library:Tween(self.Frame, { Position = self.Frame.Position + UDim2.fromOffset(290, 0), GroupTransparency = 1 }, Tokens.FAST, "Quint")
		task.delay(animationsActive() and Tokens.FAST or 0, function()
			if self.Frame then
				cancelTweenTree(self.Frame)
				self.Frame:Destroy()
				self.Frame = nil
			end
		end)
	end
end

