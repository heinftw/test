-- convenience: Tab:AddToggle(...) forwards to the most recent section
for _, method in ipairs({ "AddToggle", "AddSlider", "AddDropdown", "AddButton",
                          "AddTextbox", "AddKeybind", "AddColorPicker", "AddLabel", "AddParagraph" }) do
    local name = method
    Tab[name] = function(self, options)
        local section = self.CurrentSection or self:AddSection({ Name = self.Name })
        return section[name](section, options)
    end
end

