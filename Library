		label = self:_text("TextLabel", row, "Label", options.Text or options.Title or "Color", TEXT_BASE.Body, {
			Size = UDim2.fromScale(1, 1),
			Wave = true,
		})
		swatch = self:_text("TextButton", row, "Swatch", "", TEXT_BASE.Body, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -2, 0.5, 0),
			Size = UDim2.fromScale(26 / 224, 10 / 14.4),
			BackgroundTransparency = 0,
			BackgroundColor3 = toColor(options.Default, WHITE),
			BorderSizePixel = 1,
			BorderColor3 = theme.Border,
			Text = "",
		})
	end

	local element = newElement("ColorPicker", tab, options, row)
	element._ownsRow = not compact
	element:Bind(swatch)
	element._normalize = function(value)
		if typeof(value) == "Color3" then
			return true, value
		end
		if type(value) == "string" then
			local hex = value:lower()
			if hex:sub(1, 1) ~= "#" then
				hex = "#" .. hex
			end
			local converted = toColor(hex, nil)
			if converted then
				return true, converted
			end
		end
		return false, "Invalid color: " .. tostring(value)
	end
	element._apply = function(value)
		Library:Tween(swatch, { BackgroundColor3 = value }, Tokens.INSTANT, "Quad")
	end
	element:Set(options.Default or "#ffffff", true)

	bindButton(self, swatch, function()
		self:_openColorPickerPopup(element, swatch, options)
	end, function()
		return element.Value, 0, theme.Text
	end, true)
	local paintSwatch = function()
		Library:Tween(swatch, { BackgroundColor3 = element.Value }, Tokens.INSTANT, "Quad")
	end
	table.insert(self._paintFns, paintSwatch)
	return element
end

function Window:_openColorPickerPopup(element, owner, options)
	if self._popup and self._popup.Kind == "Color" and self._popup.Element == element then
		self:_closePopup()
		return
	end
	local theme = Library.Theme
	local unit = clamp(self._unit or 1, 0.9, 1.5)
	local scaleUnit = math.floor(10 * unit + 0.5) / 10
	local squareSize = math.floor(128 * scaleUnit)
	local popupWidth = math.floor(196 * scaleUnit)
	local popupHeight = math.floor(238 * scaleUnit)

	local h, s, v = hsvFromColor(element.Value)
	local popupConnections = {}
	local function pconnect(signal, handler)
		local connection = signal:Connect(handler)
		table.insert(popupConnections, connection)
		return connection
	end
	local popup = self:_openPopup("Color", owner, {
		AnchorCenter = false,
		Expand = true,
		RootSize = UDim2.fromOffset(popupWidth, popupHeight),
		OnClose = function()
			for index = #popupConnections, 1, -1 do
				pcall(function()
					popupConnections[index]:Disconnect()
				end)
				popupConnections[index] = nil
			end
		end,
	})
	if not popup then
		return
	end
	popup.Element = element

	local title = new("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.new(1, -16, 0, 12),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = tostring(options.Text or options.Title or "Color"),
		TextSize = math.floor(9 * scaleUnit),
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, popup.Root)
	local preview = new("Frame", {
		Name = "Preview",
		Position = UDim2.new(1, -squareSize / 4 - 10, 0, 22),
		Size = UDim2.fromOffset(squareSize / 4, squareSize / 4),
		BackgroundColor3 = element.Value,
		BorderSizePixel = 1,
		BorderColor3 = theme.Border,
		ZIndex = 3,
	}, popup.Root)
	new("UICorner", { CornerRadius = UDim.new(0, 3) }, preview)
	local square = new("TextButton", {
		Name = "SaturationValue",
		Position = UDim2.fromOffset(8, 22),
		Size = UDim2.fromOffset(squareSize, squareSize),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 1,
		BorderColor3 = theme.Border,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
	}, popup.Root)
	new("UICorner", { CornerRadius = UDim.new(0, 3) }, square)
	local whiteLayer = new("Frame", {
		Name = "WhiteLayer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 4,
	}, square)
	new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	}), Rotation = 180 }, whiteLayer)
	local blackLayer = new("Frame", {
		Name = "BlackLayer",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, square)
	new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	}), Rotation = 90 }, blackLayer)
	local crosshair = new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(s, 0, 1 - v, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		ZIndex = 6,
	}, square)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, crosshair)
	new("UIStroke", { Color = WHITE, Thickness = 1.4, Transparency = 0.1 }, crosshair)
	new("UIStroke", { Color = BLACK, Thickness = 2.6, Transparency = 0.55 }, crosshair)
	local crossScale = new("UIScale", { Scale = 1 }, crosshair)

	local hueBar = new("TextButton", {
		Name = "HueBar",
		Position = UDim2.fromOffset(8, 22 + squareSize + 6),
		Size = UDim2.new(1, -16, 0, 10),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 1,
		BorderColor3 = theme.Border,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
	}, popup.Root)
	new("UICorner", { CornerRadius = UDim.new(0, 3) }, hueBar)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Rotation = 0,
	}, hueBar)
	local hueThumb = new("Frame", {
		Name = "Thumb",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(h, 0, 0.5, 0),
		Size = UDim2.fromOffset(6, 14),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 1,
		BorderColor3 = darken(theme.Panel, 0.3),
		ZIndex = 4,
	}, hueBar)
	new("UICorner", { CornerRadius = UDim.new(0, 2) }, hueThumb)

	local function buildField(name, position, width)
		local box = new("TextBox", {
			Name = name,
			Position = position,
			Size = UDim2.fromOffset(width, 16),
			BackgroundColor3 = lighten(theme.Panel, 0.16),
			BorderSizePixel = 1,
			BorderColor3 = theme.Border,
			Font = Enum.Font.Code,
			TextSize = math.floor(9 * scaleUnit),
			TextColor3 = theme.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			ClearTextOnFocus = true,
			Text = "",
			ZIndex = 3,
		}, popup.Root)
		new("UICorner", { CornerRadius = UDim.new(0, 3) }, box)
		local stroke = new("UIStroke", { Color = theme.Accent, Thickness = 1, Transparency = 1 }, box)
		return box, stroke
	end

	local hexBox, hexStroke = buildField("Hex", UDim2.fromOffset(8, 22 + squareSize + 22), math.floor(74 * scaleUnit))
	local rBox, rStroke = buildField("R", UDim2.fromOffset(8 + 78 * scaleUnit, 22 + squareSize + 22), math.floor(30 * scaleUnit))
	local gBox, gStroke = buildField("G", UDim2.fromOffset(8 + 112 * scaleUnit, 22 + squareSize + 22), math.floor(30 * scaleUnit))
	local bBox, bStroke = buildField("B", UDim2.fromOffset(8 + 146 * scaleUnit, 22 + squareSize + 22), math.floor(30 * scaleUnit))

	local function reject(stroke)
		Library:Tween(stroke, { Color = Color3.fromRGB(231, 157, 143), Transparency = 0.15 }, Tokens.INSTANT, "Quad")
		task.delay(0.45, function()
			if stroke.Parent then
				Library:Tween(stroke, { Color = theme.Accent, Transparency = 1 }, Tokens.FAST, "Quad")
			end
		end)
	end

	local state = { UpdatingFields = false }
	local function currentColor()
		return Color3.fromHSV(h, s, v)
	end

	local function refreshVisuals()
		local color = currentColor()
		Library:Tween(square, { BackgroundColor3 = Color3.fromHSV(h, 1, 1) }, Tokens.INSTANT, "Quad")
		Library:Tween(preview, { BackgroundColor3 = color }, Tokens.INSTANT, "Quad")
		crosshair.Position = UDim2.new(s, 0, 1 - v, 0)
		hueThumb.Position = UDim2.new(h, 0, 0.5, 0)
		if not state.UpdatingFields then
			state.UpdatingFields = true
			if UserInputService:GetFocusedTextBox() ~= hexBox then
				hexBox.Text = toHex(color)
			end
			if UserInputService:GetFocusedTextBox() ~= rBox then
				rBox.Text = tostring(math.floor(color.R * 255 + 0.5))
			end
			if UserInputService:GetFocusedTextBox() ~= gBox then
				gBox.Text = tostring(math.floor(color.G * 255 + 0.5))
			end
			if UserInputService:GetFocusedTextBox() ~= bBox then
				bBox.Text = tostring(math.floor(color.B * 255 + 0.5))
			end
			state.UpdatingFields = false
		end
	end

	local function commit()
		element:Set(currentColor())
	end

	local function applyHue(newHue)
		h = clamp(newHue, 0, 1)
		refreshVisuals()
		commit()
	end

	local function applySV(newS, newV)
		s = clamp(newS, 0, 1)
		v = clamp(newV, 0, 1)
		refreshVisuals()
		commit()
	end

	local function bindDrag(surface, handler)
		local dragging = false
		local function update(position)
			local inset = GuiService:GetGuiInset()
			local rel = Vector2.new(position.X - inset.X, position.Y - inset.Y) - surface.AbsolutePosition
			local ratioX = clamp(rel.X / math.max(1, surface.AbsoluteSize.X), 0, 1)
			local ratioY = clamp(rel.Y / math.max(1, surface.AbsoluteSize.Y), 0, 1)
			handler(ratioX, ratioY)
		end
		surface.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				Library:Tween(crossScale, { Scale = 1.25 }, Tokens.INSTANT, "Back")
				update(input.Position)
			end
		end)
		surface.MouseEnter:Connect(function()
			if not dragging then
				Library:Tween(crossScale, { Scale = 1.1 }, Tokens.FAST, "Back")
			end
		end)
		surface.MouseLeave:Connect(function()
			if not dragging then
				Library:Tween(crossScale, { Scale = 1 }, Tokens.FAST, "Back")
			end
		end)
		pconnect(UserInputService.InputChanged, function(input)
			if not dragging then
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				update(input.Position)
			end
		end)
		pconnect(UserInputService.InputEnded, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragging = false
				Library:Tween(crossScale, { Scale = 1 }, Tokens.FAST, "Back")
			end
		end)
	end

	bindDrag(square, function(rx, ry)
		applySV(rx, 1 - ry)
	end)
	bindDrag(hueBar, function(rx)
		applyHue(rx)
	end)

	hexBox.FocusLost:Connect(function()
		local text = hexBox.Text:lower()
		if text:sub(1, 1) ~= "#" then
			text = "#" .. text
		end
		local converted = toColor(text, nil)
		if converted then
			local nh, ns, nv = hsvFromColor(converted)
			h, s, v = nh, ns, nv
			refreshVisuals()
			commit()
		else
			reject(hexStroke)
		end
	end)
	hexBox:GetPropertyChangedSignal("Text"):Connect(function()
		local text = hexBox.Text:lower()
		if text:sub(1, 1) ~= "#" then
			text = "#" .. text
		end
		if toColor(text, nil) then
			local converted = toColor(text, nil)
			local nh, ns, nv = hsvFromColor(converted)
			h, s, v = nh, ns, nv
			refreshVisuals()
			commit()
		end
	end)

	local function bindChannel(box, stroke, channel)
		box.FocusLost:Connect(function()
			local number = tonumber(box.Text)
			if number and number >= 0 and number <= 255 then
				local color = currentColor()
				local components = { R = color.R, G = color.G, B = color.B }
				components[channel] = number / 255
				local nh, ns, nv = hsvFromColor(Color3.new(components.R, components.G, components.B))
				h, s, v = nh, ns, nv
				refreshVisuals()
				commit()
			else
				reject(stroke)
			end
		end)
	end
	bindChannel(rBox, rStroke, "R")
	bindChannel(gBox, gStroke, "G")
	bindChannel(bBox, bStroke, "B")

	for index, presetHex in ipairs(PRESET_PALETTE) do
		local presetColor = toColor(presetHex, WHITE)
		local swatch = new("TextButton", {
			Name = "Preset_" .. tostring(index),
			Position = UDim2.fromOffset(8 + (index - 1) * math.floor(23 * scaleUnit), 22 + squareSize + 46),
			Size = UDim2.fromOffset(math.floor(19 * scaleUnit), math.floor(14 * scaleUnit)),
			BackgroundColor3 = presetColor,
			BorderSizePixel = 1,
			BorderColor3 = theme.Border,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 3,
		}, popup.Root)
		new("UICorner", { CornerRadius = UDim.new(0, 3) }, swatch)
		swatch.Activated:Connect(function()
			local nh, ns, nv = hsvFromColor(presetColor)
			h, s, v = nh, ns, nv
			refreshVisuals()
			commit()
		end)
	end

	refreshVisuals()
end

-- Label / Paragraph / Section ---------------------------------------------------------

function Window:_buildLabel(tab, options)
	local theme = Library.Theme
	local row = self:_newRow(tab, "Label", options)
	local label = self:_text("TextLabel", row, "Label", tostring(options.Text or options.Title or ""), TEXT_BASE.Small, {
		Size = UDim2.fromScale(1, 0.95),
		TextColor3 = theme.Muted,
		Wave = true,
	})
	local element = newElement("Label", tab, options, row)
	element:Bind(label)
	element._normalize = function(value)
		return true, value == nil and "" or tostring(value)
	end
	element._apply = function(value, _, colorOverride)
		label.Text = tostring(value)
	end
	element:Set(tostring(options.Text or options.Title or ""), true)

	function element:SetText(text, color)
		label.Text = tostring(text)
		if color then
			Library:Tween(label, { TextColor3 = color }, Tokens.INSTANT, "Quad")
		end
	end
	function element:SetColor(color)
		Library:Tween(label, { TextColor3 = color }, Tokens.INSTANT, "Quad")
	end
	return element
end

function Window:_buildParagraph(tab, options)
	local theme = Library.Theme
	local row = self:_newRow(tab, "Paragraph", options)
	local hasTitle = options.Title ~= nil and #tostring(options.Title) > 0
	local title = nil
	if hasTitle then
		title = self:_text("TextLabel", row, "Title", tostring(options.Title), TEXT_BASE.Body, {
			Size = UDim2.fromScale(1, 0.3),
			TextColor3 = lighten(theme.Text, 0.08),
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = lighten(theme.Text, 0.08),
		})
	end
	local body = self:_text("TextLabel", row, "Body", tostring(options.Text or options.Description or ""), TEXT_BASE.Small, {
		Position = hasTitle and UDim2.fromScale(0, 0.3) or UDim2.fromScale(0, 0),
		Size = hasTitle and UDim2.fromScale(1, 0.7) or UDim2.fromScale(1, 1),
		TextColor3 = theme.Muted,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Wave = true,
	})
	local element = newElement("Paragraph", tab, options, row)
	element:Bind(body)
	local paragraphEntry = { Object = row, Text = tostring(options.Text or options.Description or ""), HasTitle = hasTitle }
	table.insert(self._paragraphEntries, paragraphEntry)
	element._normalize = function(value)
		return true, value == nil and "" or tostring(value)
	end
	element._apply = function(value)
		body.Text = tostring(value)
		paragraphEntry.Text = tostring(value)
		self:_requestRelayout()
	end
	element:Set(tostring(options.Text or options.Description or ""), true)

	function element:SetText(text)
		body.Text = tostring(text)
		paragraphEntry.Text = tostring(text)
		self:_requestRelayout()
	end
	return element
end

function Window:_buildSection(tab, options)
	local theme = Library.Theme
	local row = self:_newRow(tab, "Section", options)
	local tick = new("Frame", {
		Name = "Tick",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 1, 0.42, 0),
		Size = UDim2.new(0, 2, 0, 0),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
	}, row)
	local heading = self:_text("TextLabel", row, "Heading", tostring(options.Text or options.Title or "Section"), TEXT_BASE.Heading, {
		Position = UDim2.new(0, 7 / 224, 0, 0),
		Size = UDim2.fromScale(1 - 8 / 224, 0.8),
		TextColor3 = lighten(theme.Text, 0.08),
		Wave = true,
	})
	local divider = new("Frame", {
		Name = "Divider",
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = theme.Edge,
		BorderSizePixel = 0,
	}, row)
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 0.95),
		}),
		Rotation = 0,
	}, divider)
	local element = newElement("Section", tab, options, row)
	element:Bind(heading)
	element._normalize = function(value)
		return true, value == nil and "" or tostring(value)
	end
	element._apply = function(value)
		heading.Text = tostring(value)
	end
	element:Set(tostring(options.Text or options.Title or "Section"), true)
	return element
end

-- Tab -------------------------------------------------------------------------------

Tab.__index = Tab

function Tab.new(window, title, icon)
	local self = setmetatable({
		Window = window,
		Title = tostring(title or "Tab"),
		Icon = icon,
		_index = #window._tabs + 1,
		_elements = {},
		_rows = {},
		_nextOrder = 0,
		_columnIndex = 1,
		_columns = {},
		_firstShown = false,
	}, Tab)
	table.insert(window._tabs, self)
	return self
end

function Tab:_ensurePage()
	if self._page then
		return
	end
	local window = self.Window
	local theme = Library.Theme
	self._page = new("Frame", {
		Name = "Page_" .. tostring(self.Title),
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 2,
	}, window._contentArea)
	self._scroll = new("ScrollingFrame", {
		Name = "Scroll",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(1, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Accent,
		ScrollBarImageTransparency = 1,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		ScrollingEnabled = true,
	}, self._page)
	window:_enableSmoothScroll(self._scroll)
	self._holder = new("Frame", {
		Name = "Holder",
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.Y,
	}, self._scroll)
	self._holderLayout = new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, DESIGN.Gap),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}, self._holder)
	for columnIndex = 1, 2 do
		local column = new("Frame", {
			Name = columnIndex == 1 and "Primary" or "Secondary",
			LayoutOrder = columnIndex,
			Size = UDim2.fromScale(0.5, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = theme.Panel,
			BorderSizePixel = 1,
			BorderColor3 = theme.Border,
		}, self._holder)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 1) }, column)
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
			PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 5),
		}, column)
		self._columns[columnIndex] = column
	end
	self._columns[2].Visible = false
	window._painters = window._painters or {}
	table.insert(window._painters, function()
		if self._columns[1] then
			self._columns[1].BackgroundColor3 = theme.Panel
			self._columns[1].BorderColor3 = theme.Border
			self._columns[2].BackgroundColor3 = theme.Panel
			self._columns[2].BorderColor3 = theme.Border
		end
	end)
end

function Tab:NextColumn()
	if self._columnIndex == 1 then
		self._columnIndex = 2
		self:_ensurePage()
		self._columns[2].Visible = true
	end
	return self
end

function Tab:AddToggle(options)
	self:_ensurePage()
	return self.Window:_buildToggle(self, options or {})
end

function Tab:AddSlider(options)
	self:_ensurePage()
	return self.Window:_buildSlider(self, options or {})
end

function Tab:AddDropdown(options)
	self:_ensurePage()
	return self.Window:_buildDropdown(self, options or {})
end

function Tab:AddButton(options)
	self:_ensurePage()
	return self.Window:_buildButton(self, options or {})
end

function Tab:AddTextbox(options)
	self:_ensurePage()
	return self.Window:_buildTextbox(self, options or {})
end

function Tab:AddKeybind(options)
	self:_ensurePage()
	return self.Window:_buildKeybind(self, options or {})
end

function Tab:AddColorPicker(options)
	self:_ensurePage()
	return self.Window:_buildColorPicker(self, options or {}, 224)
end

function Tab:AddLabel(options)
	self:_ensurePage()
	if type(options) == "string" then
		options = { Text = options }
	end
	return self.Window:_buildLabel(self, options or {})
end

function Tab:AddParagraph(options)
	self:_ensurePage()
	if type(options) == "string" then
		options = { Text = options }
	end
	return self.Window:_buildParagraph(self, options or {})
end

function Tab:AddSection(options)
	self:_ensurePage()
	if type(options) == "string" then
		options = { Text = options }
	end
	return self.Window:_buildSection(self, options or {})
end

function Tab:Select()
	self.Window:SelectTab(self)
	return self
end

-- Window ------------------------------------------------------------------------------

Window.__index = Window

function Window:_track(connection)
	table.insert(self._connections, connection)
	return connection
end

function Window:_paintable(fn)
	table.insert(Library._Painters, fn)
	table.insert(self._painters, fn)
	fn()
end

function Window:_text(className, parent, name, text, baseSize, properties)
	local theme = Library.Theme
	local settings = {
		Name = name,
		Text = text,
		Font = Enum.Font.Code,
		TextSize = baseSize,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoLocalize = false,
		RichText = false,
	}
	local waveText = false
	for key, value in pairs(properties or {}) do
		if key == "Wave" then
			waveText = value == true
		else
			settings[key] = value
		end
	end
	if className == "TextButton" then
		settings.AutoButtonColor = false
	end
	local object = new(className, settings, parent)
	local colorRole = nil
	for key, value in pairs(theme) do
		if value == settings.TextColor3 then
			colorRole = key
			break
		end
	end
	table.insert(self._texts, {
		Object = object,
		Base = baseSize,
		Wave = waveText,
		IsTab = type(name) == "string" and name:sub(1, 4) == "Tab_",
		ColorRole = colorRole,
		CustomColor = colorRole and nil or settings.TextColor3,
	})
	return object
end

function Window:_newRow(tab, kind, options)
	tab:_ensurePage()
	tab._nextOrder = tab._nextOrder + 1
	local height = ROW_HEIGHTS[kind] or 18
	local row = new("CanvasGroup", {
		Name = kind .. "_" .. tostring(options.Flag or tab._nextOrder),
		LayoutOrder = tab._columnIndex * 10000 + tab._nextOrder,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		GroupTransparency = self._settled and 0 or 1,
	}, tab._columns[tab._columnIndex])
	local entry = { Object = row, Kind = kind, Tab = tab, Column = tab._columnIndex, Height = height }
	table.insert(self._rows, entry)
	table.insert(tab._rows, entry)
	return row
end

function Window:_resolveTier(width)
	if width >= TIERS[1].minWidth then
		return TIERS[1]
	elseif width >= TIERS[2].minWidth then
		return TIERS[2]
	end
	return TIERS[3]
end

function Window:_requestRelayout()
	if self._relayoutQueued or self.Destroyed then
		return
	end
	self._relayoutQueued = true
	task.defer(function()
		self._relayoutQueued = false
		if not self.Destroyed then
			self:_relayout()
		end
	end)
end

function Window:_measureParagraph(entry, widthPixels)
	local bodySize = math.max(6, TEXT_BASE.Small * self._unit * self._tier.textScale)
	local measured = TextService:GetTextSize(entry.Text or "", math.floor(bodySize + 0.5), Enum.Font.Code, Vector2.new(math.max(40, widthPixels - 10), 10000))
	local height = measured.Y + 8
	if entry.HasTitle then
		height = height + bodySize + 3
	end
	return math.max(height, ROW_FLOORS.Paragraph or 30)
end

function Window:_relayout()
	if self.Destroyed or not self._window or not self._window.Parent then
		return
	end
	local size = self._window.AbsoluteSize
	if size.X < 8 or size.Y < 8 then
		return
	end
	local tier = self:_resolveTier(size.X)
	self._tier = tier
	local compact = tier.name ~= "A"
	local unit = clamp(size.X / DESIGN.Width, tier.unitMin, tier.unitMax)
	self._unit = unit

	local titleHeight = math.max(18 * unit, 16)
	local tabHeight = compact and math.max(24 * unit, 22) or math.max(16 * unit, 14)
	local top = self._minimized and titleHeight or titleHeight + tabHeight + 4 * unit
	local contentHeight = math.max(24, size.Y - top - 4 * unit)

	self._titleBar.Size = UDim2.new(1, 0, 0, titleHeight)
	self._tabStrip.Position = UDim2.new(0, 4 * unit, 0, titleHeight + 1 * unit)
	self._tabStrip.Size = UDim2.new(1, -8 * unit, 0, tabHeight)
	self._contentArea.Position = UDim2.new(0, 4 * unit, 0, top)
	self._contentArea.Size = UDim2.new(1, -8 * unit, 0, contentHeight)

	for _, entry in ipairs(self._texts) do
		if entry.Object and entry.Object.Parent then
			entry.Object.TextSize = entry.Base * unit * tier.textScale
		end
	end
	for _, entry in ipairs(self._rows) do
		if entry.Object and entry.Object.Parent then
			local height = entry.Height * unit * tier.rowScale
			if tier.name == "C" then
				height = math.max(height, ROW_FLOORS[entry.Kind] or height)
			end
			entry.Object.Size = UDim2.new(1, 0, 0, height)
		end
	end

	for _, tab in ipairs(self._tabs) do
		if tab._page then
			tab._page.Size = UDim2.fromScale(1, 1)
			tab._page.Position = UDim2.fromScale(0, 0)
			local dual = (not compact) and tab._columns[2] and tab._columns[2].Visible
			local columnWidth = dual and 0.5 or 1
			local gap = compact and 5 * unit or DESIGN.Gap
			tab._holderLayout.FillDirection = compact and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
			tab._holderLayout.Padding = UDim.new(0, gap)
			tab._holderLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
			for _, column in ipairs(tab._columns) do
				local padding = column:FindFirstChildOfClass("UIPadding")
				if padding then
					local pad = compact and 3 * unit or 4 * unit
					padding.PaddingLeft = UDim.new(0, pad)
					padding.PaddingRight = UDim.new(0, pad)
					padding.PaddingTop = UDim.new(0, compact and 2 * unit or 3 * unit)
					padding.PaddingBottom = UDim.new(0, compact and 4 * unit or 5 * unit)
				end
				-- Dual-column: each pane is 50% minus half the gutter so the pair + padding fits the page.
				column.Size = UDim2.new(columnWidth, dual and -gap / 2 or 0, 0, 0)
			end
		end
		if tab._tabButton then
			if compact then
				tab._tabButton.Size = UDim2.new(0, math.max(26, tabHeight - 2), 1, -2)
			else
				tab._tabButton.Size = UDim2.fromScale(1 / math.max(1, #self._tabs), 1)
			end
		end
	end
	self._indicator.Visible = (not compact) and (not self._minimized)
	self:_positionIndicator(self._activeTab, true)
	for _, entry in ipairs(self._paragraphEntries) do
		if entry.Object and entry.Object.Parent then
			local column = entry.Object.Parent
			local width = column.AbsoluteSize.X
			if width > 40 then
				entry.Object.Size = UDim2.new(1, 0, 0, self:_measureParagraph(entry, width))
			end
		end
	end
	if self._popup then
		self._popup.Track()
	end
end

function Window:_positionIndicator(tab, instant)
	if not (self._indicator and tab and tab._tabButton and tab._tabButton.Parent and self._indicator.Parent) then
		return
	end
	local strip = self._tabStrip
	local button = tab._tabButton
	local relative = button.AbsolutePosition - strip.AbsolutePosition
	local x = relative.X + strip.CanvasPosition.X
	if instant or not animationsActive() then
		self._indicator.Position = UDim2.fromOffset(x, strip.AbsoluteSize.Y - 2)
		self._indicator.Size = UDim2.fromOffset(button.AbsoluteSize.X, 2)
	else
		Library:Tween(self._indicator, {
			Position = UDim2.fromOffset(x, strip.AbsoluteSize.Y - 2),
			Size = UDim2.fromOffset(button.AbsoluteSize.X, 2),
		}, Tokens.BASE, "Back")
	end
end

function Window:_buildTabButton(tab)
	local theme = Library.Theme
	local button = self:_text("TextButton", self._tabStrip, "Tab_" .. tostring(tab._index) .. "_" .. tab.Title, tab.Title, TEXT_BASE.Tab, {
		LayoutOrder = tab._index,
		BackgroundTransparency = 0,
		BackgroundColor3 = theme.Hover,
		BorderSizePixel = 1,
		BorderColor3 = theme.Edge,
		TextXAlignment = Enum.TextXAlignment.Center,
		Wave = true,
	})
	tab._tabButton = button
	local paint = bindButton(self, button, function()
		self:SelectTab(tab)
	end, function()
		local active = self._activeTab == tab
		return active and theme.Press or theme.Hover, 0, active and lighten(theme.Text, 0.12) or theme.Text
	end)
	tab._tabPaint = paint
	table.insert(self._paintFns, paint)
	self:_attachTooltip(button, tab.Title)
	return button
end

function Window:CreateTab(title, icon)
	local tab = Tab.new(self, title, icon)
	self:_buildTabButton(tab)
	self:_requestRelayout()
	if #self._tabs == 1 then
		self:SelectTab(tab)
	end
	return tab
end

function Window:SelectTab(target)
	if self.Destroyed then
		return false, "Window destroyed"
	end
	local tab = nil
	if typeof(target) == "Instance" then
		for _, entry in ipairs(self._tabs) do
			if entry._page == target or entry._tabButton == target then
				tab = entry
				break
			end
		end
	elseif type(target) == "table" and target._page then
		tab = target
	elseif type(target) == "string" then
		for _, entry in ipairs(self._tabs) do
			if entry.Title:lower() == tostring(target):lower() then
				tab = entry
				break
			end
		end
	end
	if not tab then
		return false, "Unknown tab"
	end
	self:_closePopup()
	self:_hideTooltip()
	local changed = self._activeTab ~= tab
	if changed then
		local previous = self._activeTab
		self._activeTab = tab
		if previous and previous._page then
			previous._page.Visible = false
		end
		tab:_ensurePage()
		tab._page.Visible = true
		local theme = Library.Theme
		for _, entry in ipairs(self._tabs) do
			if entry._tabPaint then
				entry._tabPaint()
				entry._tabButton.BorderColor3 = entry == tab and lighten(theme.Edge, 0.55) or theme.Edge
			end
		end
		self:_positionIndicator(tab)
		self:_revealTab(tab)
	else
		for _, entry in ipairs(self._tabs) do
			if entry._tabPaint then
				entry._tabPaint()
			end
		end
	end
	return true
end

function Window:_revealTab(tab)
	local stagger = tab._firstShown and 0.035 or 0.05
	local index = 0
	for _, entry in ipairs(tab._rows) do
		local row = entry.Object
		if row and row.Parent then
			index = index + 1
			local delayValue = math.min(index - 1, 16) * stagger
			if not animationsActive() then
				row.GroupTransparency = 0
				row.Position = UDim2.fromOffset(0, 0)
			else
				row.GroupTransparency = 1
				row.Position = UDim2.fromOffset(0, math.max(3, 6 * self._unit))
				task.delay(delayValue, function()
					if row.Parent and not self.Destroyed then
						Library:Tween(row, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Tokens.FAST, "Quint")
					end
				end)
			end
		end
	end
	if animationsActive() then
		tab._holder.Position = UDim2.fromOffset(0, 8 * self._unit)
		Library:Tween(tab._holder, { Position = UDim2.fromOffset(0, 0) }, Tokens.BASE, "Quint")
	end
	tab._firstShown = true
end

-- Dragging: micro-lift, 1:1 follow, clamped, soft settle ---------------------------

function Window:_setupDrag()
	local dragging = false
	local dragStart = nil
	local startPosition = nil

	local function viewportSize()
		return self._viewport.AbsoluteSize
	end

	local function clampToScreen(px, py)
		local view = viewportSize()
		local windowSize = self._window.AbsoluteSize
		local minX = -windowSize.X / 2 + 48
		local maxX = view.X - windowSize.X / 2 - 48
		local minY = 24
		local maxY = view.Y - windowSize.Y / 2 - 24
		if minX > maxX then
			minX, maxX = view.X / 2, view.X / 2
		end
		if minY > maxY then
			minY, maxY = view.Y / 2, view.Y / 2
		end
		return clamp(px, minX, maxX), clamp(py, minY, maxY)
	end

	local function toScale(px, py)
		local view = viewportSize()
		local x, y = clampToScreen(px, py)
		return UDim2.fromScale(x / math.max(1, view.X), y / math.max(1, view.Y))
	end

	self:_track(self._window.InputBegan:Connect(function(input)
		if self.Destroyed or self._minimized then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local inset = GuiService:GetGuiInset()
		local screenPoint = Vector2.new(input.Position.X, input.Position.Y) - inset
		local hovered = self._screenGui:GetGuiObjectsAtPosition(screenPoint.X, screenPoint.Y)
		local overControl = false
		for _, object in ipairs(hovered) do
			if object:IsA("GuiButton") or object:IsA("TextBox") then
				if object:IsDescendantOf(self._window) then
					overControl = true
				end
				break
			end
		end
		if overControl or self._sliderDrag then
			return
		end
		dragging = true
		self._dragSession = true
		dragStart = input.Position
		startPosition = self._window.AbsolutePosition
		self:_closePopup()
		self:_hideTooltip()
		if animationsActive() then
			Library:Tween(self._shadow, { ImageTransparency = 0.3, Size = UDim2.new(1, 58, 1, 58) }, Tokens.FAST, "Quad")
		end
	end))

	self:_track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = Vector2.new(input.Position.X - dragStart.X, input.Position.Y - dragStart.Y)
			self._window.Position = toScale(startPosition.X + delta.X, startPosition.Y + delta.Y)
			if self._popup then
				self._popup.Track()
			end
		end
	end))

	self:_track(UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			self._dragSession = nil
			if animationsActive() then
				Library:Tween(self._shadow, { ImageTransparency = 0.45, Size = UDim2.new(1, 44, 1, 44) }, Tokens.BASE, "Quint")
			end
			local view = viewportSize()
			local center = self._window.AbsolutePosition + self._window.AbsoluteSize / 2
			local targetX, targetY = clampToScreen(center.X, center.Y)
			if math.abs(targetX - center.X) > 0.5 or math.abs(targetY - center.Y) > 0.5 then
				self._window.Position = UDim2.fromScale(targetX / math.max(1, view.X), targetY / math.max(1, view.Y))
			end
		end
	end))

	self:_track(UserInputService.WindowFocusReleased:Connect(function()
		if dragging then
			dragging = false
			self._dragSession = nil
			Library:Tween(self._shadow, { ImageTransparency = 0.45, Size = UDim2.new(1, 44, 1, 44) }, Tokens.BASE, "Quint")
		end
		self:_endSliderDrag()
	end))
end

-- Visibility, opacity, background, wave ---------------------------------------------

function Window:_setShroud(transparency)
	Library:Tween(self._shroud, { BackgroundTransparency = transparency }, Tokens.FAST, "Quad")
end

function Window:SetVisible(visible)
	if self.Destroyed or type(visible) ~= "boolean" then
		return false, "Visibility must be a boolean"
	end
	if visible == self._visible then
		return true
	end
	self:_closePopup()
	self:_hideTooltip()
	self:_endSliderDrag()
	self:_cancelKeybindListen()
	self._visible = visible
	self._visibilityVersion = (self._visibilityVersion or 0) + 1
	local version = self._visibilityVersion
	if visible then
		self._window.Visible = true
		self._reopen.Visible = false
		self._uiScale.Scale = 0.02
		Library:Tween(self._uiScale, { Scale = self.Scale }, Tokens.BASE, "Back")
		self:_requestRelayout()
		self:_applyWaveState()
	else
		Library:Tween(self._shadow, { ImageTransparency = 1 }, Tokens.FAST, "Quad")
		Library:Tween(self._uiScale, { Scale = 0.02 }, Tokens.FAST, "Quint")
		task.delay(Tokens.FAST + 0.02, function()
			if self.Destroyed or self._visibilityVersion ~= version then
				return
			end
			self._window.Visible = false
			self._reopen.Visible = true
		end)
		self:_applyWaveState()
	end
	return true
end

function Window:SetOpacity(percent)
	if self.Destroyed then
		return false, "Window destroyed"
	end
	local value = tonumber(percent) or 100
	self.Opacity = clamp(value, 20, 100)
	if self._visible then
		self:_setShroud(1 - self.Opacity / 100)
	end
	return true
end

function Window:SetBackground(assetId)
	if self.Destroyed then
		return false, "Window destroyed"
	end
	self.BackgroundAsset = tostring(assetId or "")
	self:_applyBackground()
	return true
end

function Window:ClearBackground()
	return self:SetBackground("")
end

function Window:_applyBackground()
	local id = self.BackgroundAsset
	local hasBackground = id ~= nil and #id > 0
	if hasBackground then
		local url = id
		if tonumber(id) then
			url = "rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420"
		end
		if not self._bgImage then
			-- Wallpaper sits above the opacity shroud and below chrome/pages so it never eats input or hides rows.
			self._bgImage = new("ImageLabel", {
				Name = "BgImage",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				ImageTransparency = 0.8,
				ScaleType = Enum.ScaleType.Crop,
				ZIndex = 1,
				BorderSizePixel = 0,
				Active = false,
			}, self._window)
		end
		self._bgImage.Image = url
		self._bgImage.Visible = true
		if self._reopen then
			if not self._reopenBg then
				self._reopenBg = new("ImageLabel", {
					Name = "BgImage",
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					ImageTransparency = 0.8,
					ScaleType = Enum.ScaleType.Crop,
					BorderSizePixel = 0,
					ZIndex = 0,
					Active = false,
				}, self._reopen)
			end
			self._reopenBg.Image = url
			self._reopenBg.Visible = true
			self._reopen.BackgroundTransparency = 1
		end
	else
		if self._bgImage then
			self._bgImage.Visible = false
		end
		if self._reopen then
			self._reopen.BackgroundTransparency = 0
			if self._reopenBg then
				self._reopenBg.Visible = false
			end
		end
	end
end

function Window:_applyWaveState()
	local shouldRun = self.RgbText and self._visible and animationsActive() and not self.Destroyed
	if shouldRun and not self._waveConnection then
		self._waveConnection = RunService.RenderStepped:Connect(function()
			self:_stepWave()
		end)
	elseif not shouldRun and self._waveConnection then
		self._waveConnection:Disconnect()
		self._waveConnection = nil
		for _, entry in ipairs(self._texts) do
			if entry.Object and entry.Object.Parent and entry.ColorRole then
				entry.Object.TextColor3 = Library.Theme[entry.ColorRole] or entry.CustomColor or Library.Theme.Text
			end
		end
	end
end

function Window:_stepWave()
	local t = tick()
	local activeButton = (self._activeTab and self._activeTab._tabButton) or nil
	for _, entry in ipairs(self._texts) do
		local object = entry.Object
		if object and object.Parent and entry.Wave then
			if not (entry.IsTab and object == activeButton) then
				local x = object.AbsolutePosition.X
				local wave = math.sin(t * 2.5 + x * 0.012)
				local v = clamp(wave * 0.5 + 0.5, 0, 1)
				local c = 80 + v * 175
				object.TextColor3 = Color3.fromRGB(c, c, c)
			end
		end
	end
end

-- Minimize / restore ------------------------------------------------------------------

function Window:SetMinimized(minimized)
	if self.Destroyed or type(minimized) ~= "boolean" then
		return false, "Minimized state must be a boolean"
	end
	if minimized == self._minimized then
		return true
	end
	self:_closePopup()
	self:_hideTooltip()
	self:_endSliderDrag()
	self._minimized = minimized
	self._minButton.Text = minimized and "+" or "-"
	local view = self._viewport.AbsoluteSize
	local windowSize = self._window.AbsoluteSize
	local unit = self._unit or 1
	local titleHeight = math.max(18 * unit, 16)
	if minimized then
		self._aspect.Enabled = false
		local center = self._window.AbsolutePosition + windowSize / 2
		local topY = center.Y - windowSize.Y / 2 + titleHeight / 2
		local targetPosition = UDim2.fromScale(self._window.Position.X.Scale, topY / math.max(1, view.Y))
		self._tabStrip.Visible = false
		self._contentArea.Visible = false
		self._scaleHandle.Visible = false
		Library:Tween(self._minButton, { Text = "+" }, Tokens.INSTANT, "Quad")
		Library:Tween(self._window, { Size = UDim2.new(self._window.Size.X.Scale, self._window.Size.X.Offset, 0, titleHeight), Position = targetPosition }, Tokens.BASE, "Quint")
		for _, entry in ipairs(self._rows) do
			if entry.Object and entry.Object.Parent then
				Library:Tween(entry.Object, { GroupTransparency = 1 }, Tokens.INSTANT, "Quad")
			end
		end
	else
		for _, entry in ipairs(self._rows) do
			if entry.Object and entry.Object.Parent then
				entry.Object.GroupTransparency = 0
			end
		end
		self._tabStrip.Visible = true
		self._contentArea.Visible = true
		self._scaleHandle.Visible = true
		self._aspect.Enabled = true
		Library:Tween(self._minButton, { Text = "-" }, Tokens.INSTANT, "Quad")
		Library:Tween(self._window, { Size = UDim2.fromScale(0.985, 0.985) }, Tokens.BASE, "Quint")
	end
	self:_requestRelayout()
	return true
end

-- Scale ---------------------------------------------------------------------------------

function Window:SetScale(value)
	if self.Destroyed then
		return false, "Window destroyed"
	end
	local number = tonumber(value)
	if not finite(number) then
		return false, "Scale must be a number"
	end
	local scale = clamp(number, self.MinScale, self.MaxScale)
	self.Scale = math.floor(scale * 100 + 0.5) / 100
	self._uiScale.Scale = self.Scale
	if not self._scaleElement then
		Library.Flags[self.ScaleFlag] = self.Scale
		self.Changed:Fire(self.ScaleFlag, self.Scale)
	end
	if self._scaleElement and not self._syncingScale then
		local target = self._scaleIsPercent and self.Scale * 100 or self.Scale
		if math.abs((tonumber(self._scaleElement.Value) or 0) - target) > 1e-6 then
			self._syncingScale = true
			self._scaleElement:Set(target)
			self._syncingScale = false
		end
	end
	self:_requestRelayout()
	return true
end

function Window:GetScale()
	return self.Scale
end

function Window:BindScaleElement(element, isPercent)
	if type(element) ~= "table" or element.Type ~= "Slider" then
		return false, "BindScaleElement expects a slider element"
	end
	self._scaleElement = element
	self._scaleIsPercent = isPercent ~= false
	return true
end

function Window:SetToggleKey(key)
	if self.Destroyed then
		return false, "Window destroyed"
	end
	local resolved
	if typeof(key) == "EnumItem" then
		resolved = key
	else
		resolved = resolveKeyCode(key)
	end
	if not resolved then
		return false, "Unknown key: " .. tostring(key)
	end
	if not MENU_KEYS[resolved.Name] then
		return false, "Menu key must be Right Shift, Insert, Home or F4"
	end
	self.ToggleKeybind = resolved
	return true
end

-- State / persistence -------------------------------------------------------------------

function Window:Serialize()
	local values = {}
	for _, element in ipairs(self._elements) do
		if not element.Destroyed then
			values[element.Flag] = Library:SerializeValue(element.Value)
		end
	end
	return values
end

function Window:Deserialize(values, fire)
	if type(values) ~= "table" then
		return false, "Values must be a table"
	end
	local applied = 0
	local failed = 0
	for _, element in ipairs(self._elements) do
		if not element.Destroyed and values[element.Flag] ~= nil then
			local ok = element:Set(Library:DeserializeValue(values[element.Flag]), not fire)
			if ok then
				applied = applied + 1
			else
				failed = failed + 1
			end
		end
	end
	return true, applied, failed
end

function Window:GetState()
	local values = {}
	for _, element in ipairs(self._elements) do
		if not element.Destroyed then
			values[element.Flag] = element.Value
		end
	end
	return values
end

function Window:GetValue(flag)
	return Library.Flags[flag]
end

function Window:SetValue(flag, value)
	local element = Library._FlagElements[flag]
	if not element or element.Destroyed then
		return false, "Unknown flag: " .. tostring(flag)
	end
	return element:Set(value)
end

function Window:Reset()
	if self.Destroyed then
		return false, "Window destroyed"
	end
	for _, element in ipairs(self._elements) do
		if not element.Destroyed and not element._autoFlag and element.Default ~= nil then
			element:Set(element.Default)
		end
	end
	return true
end

function Window:ExportProfile()
	if self.Destroyed then
		return nil, "Window destroyed"
	end
	local ok, result = pcall(function()
		return HttpService:JSONEncode({ version = 1, values = self:Serialize() })
	end)
	if not ok then
		return nil, tostring(result)
	end
	if #result > 65536 then
		return nil, "Serialized profile exceeds the 64 KB limit"
	end
	return result
end

function Window:ImportProfile(json)
	if self.Destroyed then
		return false, "Window destroyed"
	end
	if type(json) ~= "string" or #json > 65536 then
		return false, "A profile must be JSON text smaller than 64 KB"
	end
	local decoded, profile = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not decoded or type(profile) ~= "table" or type(profile.values) ~= "table" then
		return false, "Invalid profile JSON"
	end
	return self:Deserialize(profile.values, true)
end

-- Global input routing ------------------------------------------------------------------

function Window:_bindInput()
	self:_track(GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(function()
		self:_applyWaveState()
	end))

	self:_track(UserInputService.InputChanged:Connect(function(input)
		if self._sliderDrag then
			if self._minimized then
				self:_endSliderDrag()
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				self:_updateSliderDrag(input.Position)
			end
		end
	end))

	self:_track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self:_endSliderDrag()
		end
	end))

	self:_track(UserInputService.InputBegan:Connect(function(input, processed)
		if self.Destroyed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if self._popup then
				self:_closePopup()
			end
			if self._keyListener then
				self:_cancelKeybindListen()
			end
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if not processed and self.ToggleKeybind and input.KeyCode == self.ToggleKeybind then
			self:SetVisible(not self._visible)
			return
		end
		if not self._visible or self._popup then
			return
		end
		local step = self._hoveredSliderStep
		if step then
			if input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.DPadLeft then
				step(-1)
			elseif input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.DPadRight then
				step(1)
			end
		end
	end))
end

