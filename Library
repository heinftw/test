-- Elements ----------------------------------------------------------------------

local Element = {}
Element.__index = Element

local autoFlagCounter = 0

local function newElement(kind, tab, options, row)
	local element = setmetatable({
		Type = kind,
		Tab = tab,
		Window = tab.Window,
		Row = row,
		Flag = type(options.Flag) == "string" and options.Flag or nil,
		Callback = type(options.Callback) == "function" and options.Callback or nil,
		Default = options.Default,
		Value = nil,
		Objects = {},
		Connections = {},
		Destroyed = false,
		_apply = nil,
		_normalize = nil,
	}, Element)
	if not element.Flag then
		autoFlagCounter = autoFlagCounter + 1
		element.Flag = "_auto." .. kind .. "." .. autoFlagCounter
		element._autoFlag = true
	end
	table.insert(tab._elements, element)
	table.insert(tab.Window._elements, element)
	Library._FlagElements[element.Flag] = element
	return element
end

function Element:Bind(object)
	table.insert(self.Objects, object)
	return object
end

function Element:Connect(signal, handler)
	local connection = signal:Connect(function(...)
		if not self.Destroyed then
			handler(...)
		end
	end)
	table.insert(self.Connections, connection)
	return connection
end

function Element:Get()
	return self.Value
end

function Element:Set(value, silent)
	if self.Destroyed then
		return false, "Element destroyed"
	end
	if self._normalize then
		local ok, normalized = self._normalize(value)
		if not ok then
			return false, normalized
		end
		value = normalized
	end
	self.Value = value
	Library.Flags[self.Flag] = value
	if self._apply then
		local okApply, applyError = pcall(self._apply, value, true)
		if not okApply then
			warn("[xanax.ui] apply failed for " .. tostring(self.Flag) .. ": " .. tostring(applyError))
		end
	end
	if not silent then
		self:Fire(value)
		self.Window.Changed:Fire(self.Flag, value)
	end
	return true
end

function Element:Fire(value)
	if self.Callback then
		local ok, err = pcall(self.Callback, value == nil and self.Value or value)
		if not ok then
			warn("[xanax.ui] callback failed for " .. tostring(self.Flag) .. ": " .. tostring(err))
		end
	end
end

function Element:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	for _, connection in ipairs(self.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.Connections = {}
	for _, object in ipairs(self.Objects) do
		if object and object.Parent then
			cancelTweenTree(object)
		end
	end
	if self.Row and self._ownsRow ~= false then
		Library:CancelTweens(self.Row)
		self.Row:Destroy()
		self.Row = nil
	end
	for index, entry in ipairs(self.Tab._elements) do
		if entry == self then
			table.remove(self.Tab._elements, index)
			break
		end
	end
	for index, entry in ipairs(self.Window._elements) do
		if entry == self then
			table.remove(self.Window._elements, index)
			break
		end
	end
	if Library._FlagElements[self.Flag] == self then
		Library._FlagElements[self.Flag] = nil
	end
	Library.Flags[self.Flag] = nil
end

-- Shared button behaviour: hover tint, press squish, release ripple, theme paint --

local function bindButton(window, button, callback, baseFn, isSwatch)
	button.AutoButtonColor = false
	button.ClipsDescendants = true
	local scale = new("UIScale", { Scale = 1 }, button)
	local hoverStroke = nil
	if not isSwatch then
		hoverStroke = new("UIStroke", { Color = Library.Theme.Accent, Thickness = 1, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, button)
	end
	local hovered = false
	local pressed = false

	local function paint()
		if not button.Parent then
			return
		end
		local background, transparency, textColor = baseFn()
		if pressed then
			background = isSwatch and lighten(background, 0.25) or Library.Theme.Press
			transparency = math.min(transparency, 0.2)
			textColor = textColor and lighten(textColor, 0.1) or nil
		elseif hovered then
			background = isSwatch and lighten(background, 0.14) or Library.Theme.Hover
			transparency = math.min(transparency, 0.3)
			textColor = textColor and lighten(textColor, 0.12) or nil
		end
		local props = { BackgroundColor3 = background, BackgroundTransparency = transparency }
		if textColor then
			props.TextColor3 = textColor
		end
		Library:Tween(button, props, Tokens.INSTANT, "Quad")
	end

	local function setPressed(state)
		pressed = state
		Library:Tween(scale, { Scale = state and 0.97 or 1 }, state and 0 or Tokens.BASE, state and "Quad" or "Back")
		paint()
	end

	local function ripple(input)
		if not animationsActive() then
			return
		end
		local absSize = button.AbsoluteSize
		if absSize.X <= 0 or absSize.Y <= 0 then
			return
		end
		local localX = 0
		local localY = 0
		if input then
			local rel = Vector2.new(input.Position.X, input.Position.Y) - button.AbsolutePosition
			localX = clamp(rel.X, 0, absSize.X)
			localY = clamp(rel.Y, 0, absSize.Y)
		end
		local diameter = math.max(absSize.X, absSize.Y) * 2
		local circle = new("Frame", {
			Name = "Ripple",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(localX, localY),
			Size = UDim2.fromOffset(0, 0),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.88,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, button)
		new("UICorner", { CornerRadius = UDim.new(1, 0) }, circle)
		Library:Tween(circle, { Size = UDim2.fromOffset(diameter, diameter), BackgroundTransparency = 1 }, Tokens.FAST, "Quint")
		task.delay(Tokens.FAST + 0.02, function()
			if circle.Parent then
				Library:CancelTweens(circle)
				circle:Destroy()
			end
		end)
	end

	window:_track(button.MouseEnter:Connect(function()
		hovered = true
		if hoverStroke then
			Library:Tween(hoverStroke, { Transparency = 0.55 }, Tokens.INSTANT, "Quad")
		end
		paint()
	end))
	window:_track(button.MouseLeave:Connect(function()
		hovered = false
		pressed = false
		if hoverStroke then
			Library:Tween(hoverStroke, { Transparency = 1 }, Tokens.INSTANT, "Quad")
		end
		Library:Tween(scale, { Scale = 1 }, Tokens.BASE, "Back")
		paint()
	end))
	window:_track(button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.ButtonA then
			setPressed(true)
			ripple(input)
		end
	end))
	window:_track(button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.ButtonA then
			setPressed(false)
		end
	end))
	window:_track(button.Activated:Connect(function()
		setPressed(false)
		if callback then
			local ok, err = pcall(callback)
			if not ok then
				warn("[xanax.ui] button callback failed: " .. tostring(err))
			end
		end
		paint()
	end))
	paint()
	window._paintFns = window._paintFns or {}
	table.insert(window._paintFns, paint)
	return paint
end

-- Tooltip -----------------------------------------------------------------------

function Window:_showTooltip(object, text)
	if not text or #text == 0 or self._minimized or not self._visible then
		return
	end
	self:_hideTooltip()
	local theme = Library.Theme
	local tooltip = new("CanvasGroup", {
		Name = "Tooltip",
		GroupTransparency = animationsActive() and 1 or 0,
		BackgroundColor3 = theme.Panel,
		BorderSizePixel = 1,
		BorderColor3 = theme.Edge,
		ZIndex = 80,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
	}, self._popupLayer)
	new("UIPadding", {
		PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7),
		PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3),
	}, tooltip)
	new("UIStroke", { Color = theme.Edge, Thickness = 1, Transparency = 0.3 }, tooltip)
	new("TextLabel", {
		Name = "Tip",
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = text,
		TextSize = math.max(10, math.floor(9 * self._unit + 0.5)),
		TextColor3 = theme.Text,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(0, 12),
		AutomaticSize = Enum.AutomaticSize.XY,
	}, tooltip)
	self._tooltip = tooltip
	task.defer(function()
		if not tooltip.Parent or self._tooltip ~= tooltip then
			return
		end
		local size = tooltip.AbsoluteSize
		local layerSize = self._popupLayer.AbsoluteSize
		local origin = object.AbsolutePosition - self._popupLayer.AbsolutePosition
		local x = clamp(origin.X + object.AbsoluteSize.X / 2 - size.X / 2, POPUP_MARGIN, math.max(POPUP_MARGIN, layerSize.X - size.X - POPUP_MARGIN))
		local y = origin.Y - size.Y - 4
		if y < POPUP_MARGIN then
			y = origin.Y + object.AbsoluteSize.Y + 4
		end
		tooltip.Position = UDim2.fromOffset(x, y)
		Library:Tween(tooltip, { GroupTransparency = 0 }, Tokens.FAST, "Quad")
	end)
end

function Window:_hideTooltip()
	local tooltip = self._tooltip
	self._tooltipToken = (self._tooltipToken or 0) + 1
	if tooltip then
		self._tooltip = nil
		Library:Tween(tooltip, { GroupTransparency = 1 }, Tokens.INSTANT, "Quad")
		task.delay(Tokens.INSTANT + 0.02, function()
			if tooltip.Parent then
				tooltip:Destroy()
			end
		end)
	end
end

function Window:_attachTooltip(object, text)
	self:_track(object.MouseEnter:Connect(function()
		if self._popup or self._dragSession then
			return
		end
		local token = (self._tooltipToken or 0) + 1
		self._tooltipToken = token
		task.delay(0.22, function()
			if self._tooltipToken == token and not self.Destroyed and not self._popup and not self._dragSession then
				self:_showTooltip(object, text)
			end
		end)
	end))
	self:_track(object.MouseLeave:Connect(function()
		self:_hideTooltip()
	end))
end

-- Popup layer: one popup at a time, AbsolutePosition anchored, flip + clamp ------

function Window:_closePopup()
	local popup = self._popup
	if not popup then
		return
	end
	self._popup = nil
	if popup.OnClose then
		pcall(popup.OnClose)
	end
	if popup.Backdrop then
		popup.Backdrop:Destroy()
	end
	if popup.Root and popup.Root.Parent then
		if popup.Collapse and animationsActive() then
			pcall(popup.Collapse)
			local root = popup.Root
			task.delay(Tokens.INSTANT + 0.03, function()
				if root.Parent then
					cancelTweenTree(root)
					root:Destroy()
				end
			end)
		else
			cancelTweenTree(popup.Root)
			popup.Root:Destroy()
		end
	end
	self:_hideTooltip()
end

function Window:_openPopup(kind, owner, options)
	self:_closePopup()
	options = options or {}
	local theme = Library.Theme
	local backdrop = new("TextButton", {
		Name = "PopupDismiss",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		ZIndex = 60,
	}, self._popupLayer)
	local root = new("CanvasGroup", {
		Name = "Popup_" .. kind,
		GroupTransparency = animationsActive() and 1 or 0,
		BackgroundColor3 = theme.Panel,
		BorderSizePixel = 1,
		BorderColor3 = theme.Edge,
		Active = true,
		ZIndex = 61,
	}, self._popupLayer)
	new("UIStroke", { Color = theme.Edge, Thickness = 1, Transparency = 0.25 }, root)
	local popup = {
		Kind = kind,
		Owner = owner,
		Root = root,
		Backdrop = backdrop,
		OnClose = options.OnClose,
		Window = self,
	}
	self._popup = popup

	local function track()
		if not root.Parent or not owner.Parent or not owner.AbsoluteSize then
			return
		end
		local layerSize = self._popupLayer.AbsoluteSize
		if layerSize.X < 2 then
			return
		end
		local size = root.AbsoluteSize
		local origin = owner.AbsolutePosition - self._popupLayer.AbsolutePosition
		local x = clamp(origin.X, POPUP_MARGIN, math.max(POPUP_MARGIN, layerSize.X - size.X - POPUP_MARGIN))
		if options.AnchorCenter then
			x = clamp(origin.X + owner.AbsoluteSize.X / 2 - size.X / 2, POPUP_MARGIN, math.max(POPUP_MARGIN, layerSize.X - size.X - POPUP_MARGIN))
		end
		local y = origin.Y + owner.AbsoluteSize.Y + 3
		if options.Above then
			y = origin.Y - size.Y - 3
		end
		if y + size.Y > layerSize.Y - POPUP_MARGIN then
			y = origin.Y - size.Y - 3
		end
		if y < POPUP_MARGIN then
			y = math.max(POPUP_MARGIN, layerSize.Y - size.Y - POPUP_MARGIN)
		end
		root.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	end
	popup.Track = track

	self:_track(backdrop.Activated:Connect(function()
		self:_closePopup()
	end))
	if options.Expand then
		root.Size = options.RootSize
		root.Position = UDim2.fromOffset(0, 0)
		task.defer(function()
			if self._popup ~= popup or not root.Parent then
				return
			end
			track()
			local origin = owner.AbsolutePosition - self._popupLayer.AbsolutePosition
			local pivot = UDim2.fromOffset(
				clamp(origin.X + owner.AbsoluteSize.X / 2 - root.AbsoluteSize.X / 2, POPUP_MARGIN, math.max(POPUP_MARGIN, self._popupLayer.AbsoluteSize.X - root.AbsoluteSize.X - POPUP_MARGIN)),
				clamp(origin.Y + owner.AbsoluteSize.Y / 2, POPUP_MARGIN, math.max(POPUP_MARGIN, self._popupLayer.AbsoluteSize.Y - root.AbsoluteSize.Y - POPUP_MARGIN))
			)
			local pivotScale = new("UIScale", { Scale = animationsActive() and 0.85 or 1 }, root)
			root.Position = pivot
			Library:Tween(pivotScale, { Scale = 1 }, Tokens.SLOW, "Back")
			Library:Tween(root, { GroupTransparency = 0 }, Tokens.SLOW, "Quad")
		end)
	else
		task.defer(function()
			if self._popup == popup and root.Parent then
				track()
				Library:Tween(root, { GroupTransparency = 0 }, Tokens.FAST, "Quad")
			end
		end)
	end
	return popup
end

-- Toggle -------------------------------------------------------------------------

function Window:_buildToggle(tab, options)
	local theme = Library.Theme
	local colors = options.Colors or {}
	local colorCount = math.min(#colors, 3)
	local row = self:_newRow(tab, "Toggle", options)
	local buttonWidth = 224 - colorCount * 11
	local button = self:_text("TextButton", row, "Toggle", "", TEXT_BASE.Body, {
		Size = UDim2.fromScale(buttonWidth / 224, 1),
		Text = "",
	})
	local track = new("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.05, 0.5),
		Size = UDim2.new(20 / buttonWidth, 0, 10 / 14.4, 0),
		BackgroundColor3 = lighten(theme.Hover, 0.12),
		BorderSizePixel = 0,
	}, button)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	local knob = new("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(3.5 / buttonWidth, 0, 0.5, 0),
		Size = UDim2.new(8 / buttonWidth, 0, 8 / 14.4, 0),
		BackgroundColor3 = theme.Text,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	local knobScale = new("UIScale", { Scale = 1 }, knob)
	local label = self:_text("TextLabel", button, "Label", options.Text or options.Title or "Toggle", TEXT_BASE.Body, {
		Position = UDim2.fromScale(16 / buttonWidth, 0),
		Size = UDim2.fromScale(1 - 17 / buttonWidth, 1),
	})
	local element = newElement("Toggle", tab, options, row)
	element:Bind(button)
	element:Bind(track)
	element:Bind(knob)
	element._normalize = function(value)
		return type(value) == "boolean", value == true
	end
	local function paintState(value)
		Library:Tween(knob, {
			Position = UDim2.new(value and (16.5 / buttonWidth) or (3.5 / buttonWidth), 0, 0.5, 0),
		}, Tokens.FAST, "Back")
		Library:Tween(track, {
			BackgroundColor3 = value and theme.Accent or lighten(theme.Hover, 0.12),
		}, Tokens.FAST, "Quad")
		Library:Tween(knob, { BackgroundColor3 = value and darken(theme.Accent, 0.55) or theme.Text }, Tokens.FAST, "Quad")
		button:SetAttribute("Checked", value)
	end
	element._apply = paintState
	self:_paintable(function()
		paintState(element.Value)
	end)
	element:Set(options.Default == true, true)
	bindButton(self, button, function()
		element:Set(not element.Value)
	end, function()
		return theme.Panel, 1, theme.Text
	end)
	self:_track(button.MouseEnter:Connect(function()
		Library:Tween(knobScale, { Scale = 1.12 }, Tokens.INSTANT, "Back")
	end))
	self:_track(button.MouseLeave:Connect(function()
		Library:Tween(knobScale, { Scale = 1 }, Tokens.BASE, "Back")
	end))
	for index = 1, colorCount do
		local entry = colors[index]
		local colorOptions = type(entry) == "table" and entry or { Default = entry }
		local flagSuffix = nil
		if type(element.Flag) == "string" and not element._autoFlag then
			flagSuffix = element.Flag .. ".color." .. index
		end
		if type(colorOptions.Flag) ~= "string" and flagSuffix then
			colorOptions.Flag = flagSuffix
		end
		local default = colorOptions.Default or "#ffffff"
		if element.Flag and not element._autoFlag and Library.Flags[element.Flag .. ".color." .. index] ~= nil then
			default = Library.Flags[element.Flag .. ".color." .. index]
		end
		colorOptions.Default = default
		colorOptions.Text = (options.Text or options.Title or "Toggle") .. " color " .. index
		colorOptions.Compact = true
		colorOptions._ownerRow = row
		colorOptions._colorIndex = index
		self:_buildColorPicker(tab, colorOptions, buttonWidth + (index - 1) * 11)
	end
	return element
end

-- Smooth scrolling: eased wheel + scrollbar that fades in on scroll ---------------

function Window:_enableSmoothScroll(scrollFrame)
	local token = 0
	self:_track(scrollFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local position = scrollFrame.CanvasPosition
			local step = math.max(42, scrollFrame.AbsoluteSize.Y * 0.16)
			local target = mathClamp(position.Y - input.Position.Z * step, 0, math.max(0, scrollFrame.AbsoluteCanvasSize.Y - scrollFrame.AbsoluteSize.Y))
			scrollFrame.CanvasPosition = Vector2.new(position.X, position.Y)
			Library:Tween(scrollFrame, { CanvasPosition = Vector2.new(0, target) }, Tokens.FAST, "Quint")
			scrollFrame.ScrollBarImageTransparency = 0.15
			token = token + 1
			local capture = token
			task.delay(0.7, function()
				if capture == token and scrollFrame.Parent then
					Library:Tween(scrollFrame, { ScrollBarImageTransparency = 1 }, Tokens.SLOW, "Quad")
				end
			end)
		elseif input.UserInputType == Enum.UserInputType.MouseMovement then
			token = token + 1
			local capture = token
			if scrollFrame.ScrollBarImageTransparency > 0.9 then
				scrollFrame.ScrollBarImageTransparency = 0.9
			end
			task.delay(1.4, function()
				if capture == token and scrollFrame.Parent then
					Library:Tween(scrollFrame, { ScrollBarImageTransparency = 1 }, Tokens.SLOW, "Quad")
				end
			end)
		end
	end))
end

