--[[
  UILibrary.lua — Xanax Executor UI Library
  Pure window → tabs → elements API. No demo, no config, no image-specific code.
  loadstring-ready. Ends with getgenv().UILibrary + return.
]]

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local function env()
	local g = _G
	if typeof(getgenv) == "function" then
		local ok, v = pcall(getgenv)
		if ok and typeof(v) == "table" then g = v end
	end
	return g
end

local G = env()

local function hex(c)
	return Color3.fromRGB(
		tonumber(c:sub(1, 2), 16),
		tonumber(c:sub(3, 4), 16),
		tonumber(c:sub(5, 6), 16)
	)
end

