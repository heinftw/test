    element:Set(options.Default and true or false, true)
    return registerElement(self, element)
end

--=====================================================================--
-- ELEMENT: SLIDER
--=====================================================================--
function Section:AddSlider(options)
    options = options or {}
    local minimum  = options.Min or 0
    local maximum  = options.Max or 100
    local decimals = options.Decimals or 0
    local suffix   = options.Suffix or ""
    local step     = options.Step or (decimals > 0 and (1 / (10 ^ decimals)) or 1)

    local element = {
        Type = "Slider", Name = options.Name or "Slider",
        Flag = options.Flag, Callback = options.Callback,
        Min = minimum, Max = maximum, Value = minimum,
    }

    local container = new("Frame", {
        Name = "Slider",
        Size = UDim2.new(1, 0, 0, S.SliderH),
        BackgroundTransparency = 1,
        Active = true,
    }, self.Body)

    local label = text(container, {
        Size = UDim2.new(1, -70, 0, S.SliderLabelH),
        Text = element.Name,
        TextSize = S.LabelText,
    })

    local valueLabel = text(container, {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(70, S.SliderLabelH),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextSize = S.ValueText,
        TextColor3 = Theme.TextMuted,
        TextTruncate = Enum.TextTruncate.None,
    })

    local hit = new("TextButton", {
        Position = UDim2.fromOffset(0, S.SliderHitY),
        Size = UDim2.new(1, 0, 0, S.SliderHitH),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Active = true,
    }, container)

    local track = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, S.TrackH),
        BackgroundColor3 = Theme.Track,
    }, hit)
    corner(track, S.TrackH / 2)

    local fill = new("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Theme.Accent,
    }, track)
    corner(fill, S.TrackH / 2)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(S.SliderKnob, S.SliderKnob),
        BackgroundColor3 = Theme.Knob,
        ZIndex = 2,
    }, hit)
    corner(knob, S.SliderKnob / 2)

    element.Instance = container

    local function format(value)
        if type(options.Format) == "function" then
            local ok, result = pcall(options.Format, value)
            if ok and result ~= nil then return tostring(result) end
        end
        if decimals > 0 then
            return string.format("%." .. decimals .. "f", value) .. suffix
        end
        return tostring(math.floor(value + 0.5)) .. suffix
    end

    function element:Set(value, silent)
        value = tonumber(value)
        if value == nil then return false end
        value = math.clamp(value, minimum, maximum)
        value = minimum + math.floor(((value - minimum) / step) + 0.5) * step
        value = math.clamp(value, minimum, maximum)
        if decimals > 0 then
            value = tonumber(string.format("%." .. decimals .. "f", value)) or value
        end
        self.Value = value

        local alpha = (maximum - minimum) ~= 0 and ((value - minimum) / (maximum - minimum)) or 0
        tween(fill, 0.10, { Size = UDim2.fromScale(alpha, 1) })
        tween(knob, 0.10, { Position = UDim2.new(alpha, 0, 0.5, 0) })
        valueLabel.Text = format(value)

        if not silent and type(self.Callback) == "function" then
            task.spawn(function() pcall(self.Callback, value) end)
        end
        return true
    end

    function element:Get() return self.Value end

    local dragging = false
    local function updateFromX(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        element:Set(minimum + (maximum - minimum) * alpha)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            self.Window:CloseMenus()
            updateFromX(input.Position.X)
        end
    end)

    table.insert(self.Window.Connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end))

    table.insert(self.Window.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    element:Set(options.Default ~= nil and options.Default or minimum, true)
    return registerElement(self, element)
end

--=====================================================================--
-- ELEMENT: DROPDOWN
--=====================================================================--
function Section:AddDropdown(options)
    options = options or {}
    local window = self.Window
    local multi  = options.Multi and true or false

    local element = {
        Type = multi and "MultiDropdown" or "Dropdown",
        Name = options.Name or "Dropdown",
        Flag = options.Flag, Callback = options.Callback,
        Options = copyList(options.Options),
        Placeholder = options.Placeholder or "---",
        Multi = multi,
        Value = multi and {} or "",
    }

    local hasLabel = options.Name ~= nil and options.Name ~= ""
    local height = hasLabel and S.LabeledFieldH or S.FieldH

    local container = new("Frame", {
        Name = "Dropdown",
        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 1,
        Active = true,
    }, self.Body)

    if hasLabel then
        text(container, {
            Size = UDim2.new(1, 0, 0, S.SliderLabelH),
            Text = element.Name,
            TextSize = S.LabelText,
        })
    end

    local trigger = new("TextButton", {
        Position = UDim2.fromOffset(0, hasLabel and (height - S.FieldH) or 0),
        Size = UDim2.new(1, 0, 0, S.FieldH),
        BackgroundColor3 = Theme.Field,
        AutoButtonColor = false,
        Text = "",
        Active = true,
    }, container)
    corner(trigger, S.FieldRadius)
    stroke(trigger, Theme.Stroke, 1)
    hoverFill(trigger, Theme.Field, Theme.FieldHover)

    local valueLabel = text(trigger, {
        Position = UDim2.fromOffset(S.FieldPadX, 0),
        Size = UDim2.new(1, -(S.FieldPadX + 26), 1, 0),
        TextSize = S.FieldText,
    })
    local chevron = text(trigger, {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -8, 0, 0),
        Size = UDim2.fromOffset(14, S.FieldH),
        Text = Icons.chevron,
        TextSize = 14,
        TextColor3 = Theme.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Center,
    })

    element.Instance = container
    element.Trigger  = trigger

    local function displayText()
        if multi then
            local list = element.Value
            if type(list) ~= "table" or #list == 0 then return element.Placeholder, true end
            return table.concat(list, ", "), false
        end
        if element.Value == nil or element.Value == "" then return element.Placeholder, true end
        return element.Value, false
    end

    local function paint()
        local display, empty = displayText()
        valueLabel.Text = display
        valueLabel.TextColor3 = empty and Theme.TextDim or Theme.TextSecondary
        if element.MenuRefresh then element.MenuRefresh() end
    end

    local function isSelected(item)
        if multi then
            for _, value in ipairs(element.Value) do
                if value == item then return true end
            end
            return false
        end
        return element.Value == item
    end

    local function closeMenu()
        if element.MenuFrame then
            pcall(function() element.MenuFrame:Destroy() end)
        end
        element.MenuFrame, element.MenuRefresh = nil, nil
        tween(chevron, 0.12, { Rotation = 0, TextColor3 = Theme.TextMuted })
    end

    local function openMenu()
        window:CloseMenus()

        local scaleValue = window.ScaleValue > 0 and window.ScaleValue or 1
        local relative = (trigger.AbsolutePosition - window.Root.AbsolutePosition) / scaleValue
        local width    = trigger.AbsoluteSize.X / scaleValue
        local count    = #element.Options
        local menuHeight = math.clamp(count * S.OptionH + S.MenuPad * 2, S.OptionH + S.MenuPad * 2, S.MenuMax)

        local top = relative.Y + S.FieldH + 4
        if top + menuHeight > window.Height - 10 then
            top = math.max(10, relative.Y - menuHeight - 4)
        end

        local menu = new("ScrollingFrame", {
            Name = "Menu",
            Position = UDim2.fromOffset(math.floor(relative.X), math.floor(top)),
            Size = UDim2.fromOffset(math.floor(width), math.floor(menuHeight)),
            BackgroundColor3 = Theme.Menu,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Stroke,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 101,
            Active = true,
        }, window.Overlay)
        corner(menu, S.FieldRadius)
        stroke(menu, Theme.Stroke, 1)
        vlist(menu, 2)
        padding(menu, S.MenuPad, S.MenuPad, S.MenuPad, S.MenuPad)

        local rows = {}
        if count == 0 then
            text(menu, {
                Size = UDim2.new(1, 0, 0, S.OptionH),
                Text = options.EmptyText or "No entries",
                TextSize = S.ValueText,
                TextColor3 = Theme.TextDim,
                ZIndex = 102,
            })
        end

        for index, item in ipairs(element.Options) do
            local option = new("TextButton", {
                Size = UDim2.new(1, 0, 0, S.OptionH),
                BackgroundColor3 = Theme.Menu,
                BackgroundTransparency = 1,
                AutoButtonColor = false,
                Text = "",
                LayoutOrder = index,
                ZIndex = 102,
                Active = true,
            }, menu)
            corner(option, 6)

            local optionLabel = text(option, {
                Position = UDim2.fromOffset(8, 0),
                Size = UDim2.new(1, -30, 1, 0),
                Text = tostring(item),
                TextSize = S.ValueText,
                ZIndex = 103,
            })
            local tick = text(option, {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -8, 0, 0),
                Size = UDim2.fromOffset(14, S.OptionH),
                Text = Icons.check,
                TextSize = 13,
                TextColor3 = Theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Center,
                ZIndex = 103,
            })

            option.MouseEnter:Connect(function() tween(option, 0.1, { BackgroundTransparency = 0, BackgroundColor3 = Theme.FieldHover }) end)
            option.MouseLeave:Connect(function() tween(option, 0.1, { BackgroundTransparency = 1 }) end)

            option.MouseButton1Click:Connect(function()
                if multi then
                    local list = copyList(element.Value)
                    local found
                    for position, value in ipairs(list) do
                        if value == item then found = position break end
                    end
                    if found then table.remove(list, found) else table.insert(list, item) end
                    element:Set(list)
                else
                    element:Set(item)
                    window:CloseMenus()
                end
            end)

            rows[index] = { Label = optionLabel, Tick = tick, Value = item }
        end

        local function refresh()
            for _, row in ipairs(rows) do
                local selected = isSelected(row.Value)
                row.Tick.Visible = selected
                row.Label.TextColor3 = selected and Theme.TextPrimary or Theme.TextSecondary
            end
        end
        refresh()

        element.MenuFrame, element.MenuRefresh = menu, refresh
        tween(chevron, 0.12, { Rotation = 180, TextColor3 = Theme.Accent })

        window.OpenMenu = { Frame = menu, Trigger = trigger, Close = closeMenu }
    end

    function element:Set(value, silent)
        if self.Multi then
            local list = {}
            if type(value) == "table" then
                for _, item in ipairs(value) do
                    for _, valid in ipairs(self.Options) do
                        if valid == item then table.insert(list, item) break end
                    end
                end
            end
            self.Value = list
        else
            if value == nil then value = "" end
            value = tostring(value)
            local valid = value == ""
            for _, item in ipairs(self.Options) do
                if item == value then valid = true break end
            end
            if not valid then return false end
            self.Value = value
        end

        paint()
        if not silent and type(self.Callback) == "function" then
            local payload = self.Multi and copyList(self.Value) or self.Value
            task.spawn(function() pcall(self.Callback, payload) end)
        end
        return true
    end

    function element:Get()
        if self.Multi then return copyList(self.Value) end
        return self.Value
    end

    function element:Refresh(list, selected)
        self.Options = copyList(list)
        if selected == nil then selected = self:Get() end
        window:CloseMenus()
        self:Set(selected, true)
        paint()
        return self.Options
    end

    trigger.MouseButton1Click:Connect(function()
        if element.MenuFrame then window:CloseMenus() else openMenu() end
    end)

    element:Set(options.Default ~= nil and options.Default or (multi and {} or ""), true)
    return registerElement(self, element)
end

