-- ColorPicker (compact)
function Section:AddColorPicker(opts)
	opts = opts or {}
	local def = opts.Default or Theme.Accent
	if typeof(def) == "table" then
		def = Color3.new(def.R or def[1] or 1, def.G or def[2] or 1, def.B or def[3] or 1)
	end
	local row = makeRow(self, Theme.RowH)
	makeLabel(row, opts.Name or "Color")
	local swatch = mk("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(28, 20),
		BackgroundColor3 = def,
		BackgroundTransparency = 0,
		Text = "",
	}, row)
	corner(swatch, 4)
	stroke(swatch, Theme.Stroke)

	local el = setmetatable({
		Window = self.Window,
		Section = self,
		Name = opts.Name or "Color",
		Flag = opts.Flag,
		Callback = opts.Callback,
		Row = row,
		_value = def,
	}, Element)
	function el:Validate(v)
		return typeof(v) == "Color3" or (typeof(v) == "table" and (v.R or v[1]))
	end
	function el:Get()
		local c = self._value
		if typeof(c) == "Color3" then
			return { R = c.R, G = c.G, B = c.B }
		end
		return clone(c)
	end
	function el:Set(v, silent)
		local c = v
		if typeof(v) == "table" then
			c = Color3.new(v.R or v[1] or 1, v.G or v[2] or 1, v.B or v[3] or 1)
		end
		if typeof(c) ~= "Color3" then return false end
		self._value = c
		swatch.BackgroundColor3 = c
		if not silent and self.Callback then pcall(self.Callback, self:Get()) end
		return true
	end
	el:_register()
	el:Set(def, true)

	-- cycle preset colors on click (compact, no full picker UI required by image)
	local presets = {
		Theme.Accent, hex("E06C75"), hex("6BCB8A"), hex("E5C07B"),
		hex("C678DD"), hex("56B6C2"), hex("E8E8EC"), hex("D19A66"),
	}
	local idx = 1
	self.Window:Connect(swatch.MouseButton1Click, function()
		idx = idx % #presets + 1
		el:Set(presets[idx])
	end)

	table.insert(self.Elements, el)
	return el
end

