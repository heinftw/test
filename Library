function Window:_buildTextbox(tab, options)
	local theme = Library.Theme
	local row = self:_newRow(tab, "Textbox", options)
	self:_text("TextLabel", row, "Label", options.Text or options.Title or "Input", TEXT_BASE.Small, {
		Size = UDim2.fromScale(1, 12 / 31),
	})
	local box = new("TextBox", {
		Name = "Textbox",
		Position = UDim2.new(0, 0, 12 / 31, 0),
		Size = UDim2.new(0.565, 0, 14 / 31, 0),
		BackgroundTransparency = 0,
		BackgroundColor3 = lighten(theme.Panel, 0.185),
		BorderSizePixel = 1,
		BorderColor3 = theme.Border,
		Text = tostring(options.Default or ""),
		PlaceholderText = tostring(options.Placeholder or ""),
		PlaceholderColor3 = theme.Muted,
		Font = Enum.Font.Code,
		TextSize = 10,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Selectable = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, row)
	new("UIPadding", { PaddingLeft = UDim.new(0.03, 0), PaddingRight = UDim.new(0.03, 0) }, box)
	local glow = new("UIStroke", { Color = theme.Accent, Thickness = 1, Transparency = 1 }, box)
	local squish = new("UIScale", { Scale = 1 }, box)
	local element = newElement("Textbox", tab, options, row)
	element:Bind(box)
	element.Box = box
	local committed = box.Text
	element._normalize = function(value)
		return true, value == nil and "" or tostring(value)
	end
	element._apply = function(value)
		if UserInputService:GetFocusedTextBox() ~= box then
			box.Text = tostring(value)
			committed = tostring(value)
		end
	end
	element:Set(committed, true)

	self:_track(box.Focused:Connect(function()
		self:_cancelKeybindListen()
		Library:Tween(glow, { Transparency = 0.45 }, Tokens.FAST, "Quad")
		Library:Tween(box, { BackgroundColor3 = lighten(theme.Panel, 0.24) }, Tokens.FAST, "Quad")
		Library:Tween(box, { PlaceholderColor3 = darken(theme.Muted, 0.35) }, Tokens.FAST, "Quad")
	end))

	local function revert()
		box.Text = committed
		Library:Tween(squish, { Scale = 1 }, Tokens.INSTANT, "Back")
	end

	self:_track(box.FocusLost:Connect(function(enterPressed)
		Library:Tween(glow, { Transparency = 1 }, Tokens.FAST, "Quad")
		Library:Tween(box, { BackgroundColor3 = lighten(theme.Panel, 0.185) }, Tokens.FAST, "Quad")
		Library:Tween(box, { PlaceholderColor3 = theme.Muted }, Tokens.FAST, "Quad")
		if enterPressed then
			committed = box.Text
			Library:Tween(squish, { Scale = 0.985 }, 0, "Quad")
			Library:Tween(squish, { Scale = 1 }, Tokens.BASE, "Back")
			element:Set(committed)
		else
			element:Set(box.Text)
			committed = box.Text
		end
	end))
	self:_track(box.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and UserInputService:GetFocusedTextBox() == box then
			revert()
			box:ReleaseFocus(false)
		end
	end))

	function element:Alert()
		Library:Tween(box, { BorderColor3 = Color3.fromRGB(231, 157, 143) }, Tokens.INSTANT, "Quad")
		Library:Tween(glow, { Color = Color3.fromRGB(231, 157, 143), Transparency = 0.3 }, Tokens.INSTANT, "Quad")
		task.delay(0.5, function()
			if box.Parent then
				Library:Tween(box, { BorderColor3 = theme.Border }, Tokens.FAST, "Quad")
				Library:Tween(glow, { Color = theme.Accent, Transparency = 1 }, Tokens.FAST, "Quad")
			end
		end)
	end

	return element
end

-- Keybind -----------------------------------------------------------------------------

function Window:_cancelKeybindListen()
	local listener = self._keyListener
	if not listener then
		return
	end
	self._keyListener = nil
	if listener.Connection then
		listener.Connection:Disconnect()
	end
	if listener.Button and listener.Button.Parent then
		listener.Button.Text = listener.PreviousText or ""
		Library:Tween(listener.Button, { BackgroundColor3 = listener.PreviousColor or Library.Theme.Panel }, Tokens.FAST, "Quad")
		Library:Tween(listener.Button, { TextColor3 = Library.Theme.Text }, Tokens.FAST, "Quad")
		if listener.Stroke then
			Library:CancelTweens(listener.Stroke)
			listener.Stroke.Transparency = 1
		end
	end
end

function Window:_buildKeybind(tab, options)
	local theme = Library.Theme
	local row = self:_newRow(tab, "Keybind", options)
	self:_text("TextLabel", row, "Label", options.Text or options.Title or "Keybind", TEXT_BASE.Small, {
		Size = UDim2.fromScale(1, 12 / 27),
	})
	local button = self:_text("TextButton", row, "Keybind", "", TEXT_BASE.Body, {
		Position = UDim2.fromScale(0, 12 / 27),
		Size = UDim2.fromScale(0.565, 14 / 27),
		BackgroundTransparency = 0,
		BackgroundColor3 = lighten(theme.Panel, 0.185),
		BorderSizePixel = 1,
		BorderColor3 = theme.Border,
	})
	new("UIPadding", { PaddingLeft = UDim.new(0.03, 0), PaddingRight = UDim.new(0.03, 0) }, button)
	local element = newElement("Keybind", tab, options, row)
	element:Bind(button)

	element._normalize = function(value)
		if typeof(value) == "EnumItem" then
			if value.EnumType == Enum.KeyCode then
				return true, prettifyKey(value.Name)
			end
			return false, "Unsupported keybind type"
		end
		if type(value) ~= "string" then
			return false, "Keybind must be a string"
		end
		return true, value
	end
	element._apply = function(value)
		button.Text = tostring(value)
	end
	element:Set(options.Default or "None", true)

	bindButton(self, button, function()
		if self._keyListener then
			if self._keyListener.Element == element then
				return
			end
			self:_cancelKeybindListen()
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		local stroke = new("UIStroke", { Color = theme.Accent, Thickness = 1, Transparency = 0.2 }, button)
		self._keyListener = {
			Element = element,
			Button = button,
			Stroke = stroke,
			PreviousText = button.Text,
			PreviousColor = button.BackgroundColor3,
		}
		button.Text = "..."
		Library:Tween(button, { BackgroundColor3 = theme.Accent }, Tokens.FAST, "Quad")
		Library:Tween(button, { TextColor3 = darken(theme.Accent, 0.7) }, Tokens.FAST, "Quad")
		if animationsActive() then
			Library:Tween(stroke, { Transparency = 0.75 }, 0.55, "Quad")
			stroke.Transparency = 0.75
			local pulse = TweenService:Create(stroke, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.1 })
			TweenRegistry[stroke] = { Transparency = pulse }
			pulse:Play()
		end
		local connection
		connection = UserInputService.InputBegan:Connect(function(input, processed)
			if not self._keyListener or self.Destroyed then
				connection:Disconnect()
				return
			end
			if UserInputService:GetFocusedTextBox() then
				self:_cancelKeybindListen()
				connection:Disconnect()
				return
			end
			if input.KeyCode == Enum.KeyCode.Escape then
				self:_cancelKeybindListen()
				connection:Disconnect()
				return
			end
			if processed then
				return
			end
			local keyName = nil
			if input.UserInputType == Enum.UserInputType.Keyboard then
				keyName = prettifyKey(input.KeyCode.Name)
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
				keyName = "Mouse 1"
			elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
				keyName = "Mouse 2"
			elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
				keyName = "Mouse 3"
			end
			if keyName then
				connection:Disconnect()
				local active = self._keyListener
				self._keyListener = nil
				Library:CancelTweens(stroke)
				stroke:Destroy()
				if button.Parent then
					Library:Tween(button, { BackgroundColor3 = WHITE, BackgroundTransparency = 0.55 }, Tokens.INSTANT, "Quad")
					Library:Tween(button, { BackgroundColor3 = lighten(theme.Panel, 0.185), BackgroundTransparency = 0 }, Tokens.BASE, "Quad")
				end
				element:Set(keyName)
			end
		end)
		listener.Connection = connection
	end, function()
		return lighten(theme.Panel, 0.185), 0, theme.Text
	end)

	function element:GetKeyCode()
		return resolveKeyCode(element.Value)
	end

	return element
end

