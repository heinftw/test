--[[
    Xanax UI Library
    ------------------------------------------------------------------
    Executor-only Roblox UI library (loadstring ready, no dependencies).
    Executing this file renders NOTHING by design - it only defines the
    library and publishes it as getgenv().UILibrary.

    PUBLIC API
      local Library = loadstring(game:HttpGet(RAW_URL))()

      local Window = Library:CreateWindow({
          Title    = "Xanax",                    -- sidebar wordmark
          Size     = Vector2.new(930, 615),      -- optional
          ToggleKey= Enum.KeyCode.RightShift,    -- optional
      })

      local Tab = Window:CreateTab({ Name = "Rage", Icon = "rage", Category = "Combat" })
      local Sec = Tab:AddSection({ Name = "Ragebot", Icon = "target", Column = 1 })

      Sec:AddToggle      { Name, Default, Flag, Callback }
      Sec:AddSlider      { Name, Min, Max, Default, Decimals, Step, Suffix, Format, Flag, Callback }
      Sec:AddDropdown    { Name, Options, Default, Multi, Placeholder, Flag, Callback }
      Sec:AddButton      { Name, Callback }
      Sec:AddTextbox     { Name, Default, Placeholder, ClearOnFocus, Flag, Callback }
      Sec:AddKeybind     { Name, Default, Flag, Callback, OnPressed }
      Sec:AddColorPicker { Name, Default, Flag, Callback }
      Sec:AddLabel       { Text, Muted, HideEmpty }
      Sec:AddParagraph   { Title, Text }

      Every element exposes :Set(value, silent) and :Get().
      Any element given Flag = "id" registers into Library.Flags["id"],
      which is the entire integration surface used by SaveManager.lua.

      Window:SelectTab(tab) / Window:Toggle() / Window:SetVisible(bool) / Window:Destroy()
]]

