function Section:AddKeybind(options)
    options = options or {}
    local element = {
        Type = "Keybind", Name = options.Name or "Keybind",
        Flag = options.Flag, Callback = options.Callback, Value = "None",
    }

    local row = new("Frame", {
        Name = "Keybind",
        Size = UDim2.new(1, 0, 0, S.RowH),
        BackgroundTransparency = 1,
        Active = true,
    }, self.Body)

    text(row, {
        Size = UDim2.new(1, -(S.KeyPillW + 12), 1, 0),
        Text = element.Name,
        TextSize = S.LabelText,
    })

    local pill = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(S.KeyPillW, S.KeyPillH),
        BackgroundColor3 = Theme.Field,
        AutoButtonColor = false,
        Font = Theme.Font,
        Text = "None",
        TextSize = S.ValueText,
        TextColor3 = Theme.TextSecondary,
        Active = true,
    }, row)
    corner(pill, 7)
    stroke(pill, Theme.Stroke, 1)
    hoverFill(pill, Theme.Field, Theme.FieldHover)

    element.Instance = row
    element.KeyEnum = nil
    local capturing = false

    -- Enum.KeyCode["Bogus"] raises, so resolution always goes through pcall.
    local function resolveKeyCode(name)
        if type(name) ~= "string" or name == "" or name == "None" then return nil end
        local ok, keyCode = pcall(function() return Enum.KeyCode[name] end)
        if ok and typeof(keyCode) == "EnumItem" then return keyCode end
        return nil
    end

    function element:Set(value, silent)
        local name, keyCode = "None", nil
        if typeof(value) == "EnumItem" then
            keyCode, name = value, value.Name
        elseif type(value) == "string" and value ~= "" and value ~= "None" then
            keyCode = resolveKeyCode(value)
            if keyCode then name = keyCode.Name end
        end
        self.Value = name
        self.KeyEnum = keyCode
        pill.Text = name
        if not silent and type(self.Callback) == "function" then
            task.spawn(function() pcall(self.Callback, name) end)
        end
        return true
    end

    function element:Get() return self.Value end

    pill.MouseButton1Click:Connect(function()
        capturing = true
        pill.Text = "..."
        pill.TextColor3 = Theme.Accent
    end)

    table.insert(self.Window.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if capturing then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                capturing = false
                pill.TextColor3 = Theme.TextSecondary
                if input.KeyCode == Enum.KeyCode.Escape then
                    element:Set("None")
                else
                    element:Set(input.KeyCode.Name)
                end
            end
            return
        end
        if processed then return end
        if element.KeyEnum and input.KeyCode == element.KeyEnum then
            if type(options.OnPressed) == "function" then
                task.spawn(function() pcall(options.OnPressed) end)
            end
        end
    end))

    element:Set(options.Default or "None", true)
    return registerElement(self, element)
end

--=====================================================================--
-- ELEMENT: COLOR PICKER
--=====================================================================--
function Section:AddColorPicker(options)
    options = options or {}
    local window = self.Window
    local element = {
        Type = "ColorPicker", Name = options.Name or "Color",
        Flag = options.Flag, Callback = options.Callback,
        Value = options.Default or Color3.fromRGB(255, 255, 255),
    }

    local row = new("Frame", {
        Name = "ColorPicker",
        Size = UDim2.new(1, 0, 0, S.RowH),
        BackgroundTransparency = 1,
        Active = true,
    }, self.Body)

    text(row, {
        Size = UDim2.new(1, -(S.SwatchW + 12), 1, 0),
        Text = element.Name,
        TextSize = S.LabelText,
    })

    local swatch = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(S.SwatchW, S.SwatchH),
        BackgroundColor3 = element.Value,
        AutoButtonColor = false,
        Text = "",
        Active = true,
    }, row)
    corner(swatch, 6)
    stroke(swatch, Theme.Stroke, 1)

    element.Instance = row

    local hue, saturation, value = 0, 0, 1
    do
        local h, s, v = Color3.toHSV(element.Value)
        hue, saturation, value = h, s, v
    end

    local picker
    local function closePicker()
        if picker then pcall(function() picker:Destroy() end) end
        picker = nil
    end

    function element:Set(color, silent)
        if typeof(color) ~= "Color3" then return false end
        self.Value = color
        swatch.BackgroundColor3 = color
        hue, saturation, value = Color3.toHSV(color)
        if not silent and type(self.Callback) == "function" then
            task.spawn(function() pcall(self.Callback, color) end)
        end
        return true
    end

    function element:Get() return self.Value end

    swatch.MouseButton1Click:Connect(function()
        if picker then window:CloseMenus() return end
        window:CloseMenus()

        local scaleValue = window.ScaleValue > 0 and window.ScaleValue or 1
        local relative = (swatch.AbsolutePosition - window.Root.AbsolutePosition) / scaleValue
        local totalHeight = S.PickerSV + S.PickerHue + 24
        local top = relative.Y + S.SwatchH + 6
        if top + totalHeight > window.Height - 10 then
            top = math.max(10, relative.Y - totalHeight - 6)
        end
        local left = math.min(relative.X, window.Width - S.PickerW - 14)

        picker = new("Frame", {
            Name = "ColorPopup",
            Position = UDim2.fromOffset(math.floor(left), math.floor(top)),
            Size = UDim2.fromOffset(S.PickerW, totalHeight),
            BackgroundColor3 = Theme.Menu,
            ZIndex = 101,
            Active = true,
        }, window.Overlay)
        corner(picker, S.FieldRadius)
        stroke(picker, Theme.Stroke, 1)
        padding(picker, 8, 8, 8, 8)

        local area = new("TextButton", {
            Size = UDim2.new(1, 0, 0, S.PickerSV),
            BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
            AutoButtonColor = false,
            Text = "",
            ZIndex = 102,
            Active = true,
        }, picker)
        corner(area, 6)

        local white = new("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            ZIndex = 103,
        }, area)
        corner(white, 6)
        new("UIGradient", {
            Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }, white)

        local black = new("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(0, 0, 0),
            ZIndex = 104,
        }, area)
        corner(black, 6)
        new("UIGradient", {
            Color = ColorSequence.new(Color3.fromRGB(0, 0, 0)),
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0),
            }),
        }, black)

        local cursor = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(10, 10),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            ZIndex = 105,
        }, area)
        corner(cursor, 5)
        stroke(cursor, Color3.fromRGB(20, 20, 22), 1)

        local hueBar = new("TextButton", {
            Position = UDim2.fromOffset(0, S.PickerSV + 8),
            Size = UDim2.new(1, 0, 0, S.PickerHue),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            AutoButtonColor = false,
            Text = "",
            ZIndex = 102,
            Active = true,
        }, picker)
        corner(hueBar, 6)
        new("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
            }),
        }, hueBar)

        local hueCursor = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(6, S.PickerHue + 6),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            ZIndex = 105,
        }, hueBar)
        corner(hueCursor, 3)
        stroke(hueCursor, Color3.fromRGB(20, 20, 22), 1)

        local function sync()
            area.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
            cursor.Position = UDim2.fromScale(saturation, 1 - value)
            hueCursor.Position = UDim2.new(hue, 0, 0.5, 0)
        end
        sync()

        local draggingSV, draggingHue = false, false

        local function updateSV(x, y)
            local size = area.AbsoluteSize
            if size.X <= 0 or size.Y <= 0 then return end
            saturation = math.clamp((x - area.AbsolutePosition.X) / size.X, 0, 1)
            value      = 1 - math.clamp((y - area.AbsolutePosition.Y) / size.Y, 0, 1)
            element:Set(Color3.fromHSV(hue, saturation, value))
            sync()
        end

        local function updateHue(x)
            local width = hueBar.AbsoluteSize.X
            if width <= 0 then return end
            hue = math.clamp((x - hueBar.AbsolutePosition.X) / width, 0, 1)
            element:Set(Color3.fromHSV(hue, saturation, value))
            sync()
        end

        area.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                draggingSV = true
                updateSV(input.Position.X, input.Position.Y)
            end
        end)
        hueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                draggingHue = true
                updateHue(input.Position.X)
            end
        end)

        local moveConnection = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
               and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if draggingSV then updateSV(input.Position.X, input.Position.Y) end
            if draggingHue then updateHue(input.Position.X) end
        end)
        local endConnection = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
               or input.UserInputType == Enum.UserInputType.Touch then
                draggingSV, draggingHue = false, false
            end
        end)

        window.OpenMenu = {
            Frame = picker,
            Trigger = swatch,
            Close = function()
                pcall(function() moveConnection:Disconnect() end)
                pcall(function() endConnection:Disconnect() end)
                closePicker()
            end,
        }
    end)

    element:Set(element.Value, true)
    return registerElement(self, element)
end

--=====================================================================--
-- ELEMENT: LABEL / PARAGRAPH
--=====================================================================--
function Section:AddLabel(options)
    options = options or {}
    local element = { Type = "Label", Name = options.Text or "", Value = options.Text or "" }

    local label = text(self.Body, {
        Name = "Label",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = options.Text or "",
        TextSize = options.TextSize or S.LabelBodyText,
        TextColor3 = options.Color or (options.Muted and Theme.TextDim or Theme.TextMuted),
        TextWrapped = true,
        TextTruncate = Enum.TextTruncate.None,
        TextYAlignment = Enum.TextYAlignment.Top,
    })

    element.Instance = label
    element.HideEmpty = options.HideEmpty and true or false

    function element:Set(value, silent)
        value = tostring(value == nil and "" or value)
        self.Value = value
        label.Text = value
        if self.HideEmpty then label.Visible = value ~= "" end
        return true
    end

    function element:SetColor(color)
        if typeof(color) == "Color3" then label.TextColor3 = color end
    end

    function element:Get() return self.Value end

    element:Set(options.Text or "", true)
    return registerElement(self, element)
end

function Section:AddParagraph(options)
    options = options or {}
    local container = new("Frame", {
        Name = "Paragraph",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Active = true,
    }, self.Body)
    vlist(container, 2)

    local title = text(container, {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = options.Title or "",
        Font = Theme.FontMedium,
        TextSize = S.ParagraphTitle,
        TextColor3 = Theme.TextPrimary,
        TextWrapped = true,
        TextTruncate = Enum.TextTruncate.None,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 1,
    })
    local body = text(container, {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = options.Text or "",
        TextSize = S.LabelBodyText,
        TextColor3 = Theme.TextMuted,
        TextWrapped = true,
        TextTruncate = Enum.TextTruncate.None,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 2,
    })

    local element = { Type = "Paragraph", Name = options.Title or "", Instance = container, Value = options.Text or "" }

    function element:Set(value, silent)
        value = tostring(value == nil and "" or value)
        self.Value = value
        body.Text = value
        return true
    end
    function element:SetTitle(value) title.Text = tostring(value or "") end
    function element:Get() return self.Value end

    return registerElement(self, element)
end

--=====================================================================--
-- LIBRARY LEVEL HELPERS
--=====================================================================--
function Library:Destroy()
    for index = #self.Windows, 1, -1 do
        local window = self.Windows[index]
        pcall(function() window:Destroy() end)
    end
    self.Windows = {}
    self.Flags = {}
    self.CurrentWindow = nil
end

local environment = (type(getgenv) == "function") and getgenv() or _G
environment.UILibrary = Library

return Library
