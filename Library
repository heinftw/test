function Section:AddTextbox(options)
    options = options or {}
    local element = {
        Type = "Textbox", Name = options.Name or "Textbox",
        Flag = options.Flag, Callback = options.Callback, Value = "",
    }

    local hasLabel = options.Name ~= nil and options.Name ~= ""
    local height = hasLabel and S.LabeledFieldH or S.FieldH

    local container = new("Frame", {
        Name = "Textbox",
        Size = UDim2.new(1, 0, 0, height),
        BackgroundTransparency = 1,
        Active = true,
    }, self.Body)

    if hasLabel then
        text(container, {
            Size = UDim2.new(1, 0, 0, S.SliderLabelH),
            Text = element.Name,
            TextSize = S.LabelText,
        })
    end

    local field = new("Frame", {
        Position = UDim2.fromOffset(0, hasLabel and (height - S.FieldH) or 0),
        Size = UDim2.new(1, 0, 0, S.FieldH),
        BackgroundColor3 = Theme.Field,
        Active = true,
    }, container)
    corner(field, S.FieldRadius)
    local fieldStroke = stroke(field, Theme.Stroke, 1)

    local input = new("TextBox", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Font = Theme.Font,
        TextSize = S.FieldText,
        TextColor3 = Theme.TextSecondary,
        PlaceholderText = options.Placeholder or "",
        PlaceholderColor3 = Theme.TextDim,
        Text = "",
        ClearTextOnFocus = options.ClearOnFocus and true or false,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, field)
    padding(input, S.FieldPadX, S.FieldPadX, 0, 0)

    element.Instance = container
    element.Input = input

    local painting = false

    function element:Set(value, silent)
        value = tostring(value == nil and "" or value)
        self.Value = value
        painting = true
        input.Text = value
        painting = false
        if not silent and type(self.Callback) == "function" then
            task.spawn(function() pcall(self.Callback, value) end)
        end
        return true
    end

    function element:Get() return self.Value end

    input.Focused:Connect(function() tween(fieldStroke, 0.12, { Color = Theme.Accent }) end)
    input.FocusLost:Connect(function(enterPressed)
        tween(fieldStroke, 0.12, { Color = Theme.Stroke })
        if painting then return end
        element:Set(input.Text)
        if enterPressed and type(options.OnEnter) == "function" then
            task.spawn(function() pcall(options.OnEnter, input.Text) end)
        end
    end)
    input:GetPropertyChangedSignal("Text"):Connect(function()
        if painting then return end
        element.Value = input.Text
    end)

    element:Set(options.Default or "", true)
    return registerElement(self, element)
end

