-- Tab element passthroughs (AddSection stays on Tab; do not wrap it)
do
	local methods = { "AddToggle", "AddSlider", "AddDropdown", "AddButton", "AddTextbox", "AddKeybind", "AddColorPicker", "AddLabel", "AddParagraph" }
	for i = 1, #methods do
		local methodName = methods[i]
		Tab[methodName] = function(self, opts)
			local sec = ensureSection(self)
			return sec[methodName](sec, opts)
		end
	end
end

