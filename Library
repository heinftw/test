function Window:_setupScaleHandle()
	local dragging = false
	local startY = nil
	local startScale = nil
	self:_track(self._scaleHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startY = input.Position.Y
			startScale = self.Scale
		end
	end))
	self:_track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local view = self._viewport.AbsoluteSize.Y
			local delta = (input.Position.Y - startY) / math.max(200, view)
			self:SetScale(startScale + delta * 2)
		end
	end))
	self:_track(UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
		end
	end))
end

function Window:_setupCtrlScroll()
	self:_track(self._titleBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
			if ctrl then
				local direction = input.Position.Z > 0 and 1 or -1
				self:SetScale(self.Scale + direction * 0.05)
			end
		end
	end))
end

-- Lifetime ---------------------------------------------------------------------------------

function Window:_teardown()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	self:_closePopup()
	self:_hideTooltip()
	self:_endSliderDrag()
	self:_cancelKeybindListen()
	if self._waveConnection then
		self._waveConnection:Disconnect()
		self._waveConnection = nil
	end
	for _, connection in ipairs(self._connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self._connections = {}
	if self._window then
		cancelTweenTree(self._window)
	end
	for index = #Library.Windows, 1, -1 do
		if Library.Windows[index] == self then
			table.remove(Library.Windows, index)
		end
	end
	for index = #Library._Painters, 1, -1 do
		local painter = Library._Painters[index]
		local owned = false
		for _, own in ipairs(self._painters or {}) do
			if own == painter then
				owned = true
				break
			end
		end
		if owned then
			table.remove(Library._Painters, index)
		end
	end
	for flag, element in pairs(Library._FlagElements) do
		if element.Window == self then
			Library._FlagElements[flag] = nil
		end
	end
	self._elements = {}
	self._rows = {}
	self._texts = {}
	self._tabs = {}
	self.Changed:DisconnectAll()
	if self._screenGui then
		self._screenGui:Destroy()
		self._screenGui = nil
	end
	self.Instance = nil
end

function Window:Destroy()
	if self.Destroyed then
		return
	end
	if self._screenGui and self._screenGui.Parent and animationsActive() then
		Library:Tween(self._shadow, { ImageTransparency = 1 }, Tokens.FAST, "Quad")
		Library:Tween(self._uiScale, { Scale = 0.02 }, Tokens.FAST, "Quint")
		task.delay(Tokens.FAST + 0.03, function()
			self:_teardown()
		end)
	else
		self:_teardown()
	end
end

-- Constructor --------------------------------------------------------------------------------

function Library:CreateWindow(options)
	options = type(options) == "table" and options or {}
	if type(options.Theme) == "table" then
		for key, value in pairs(options.Theme) do
			Library:SetTheme(key, value)
		end
	end
	local parent = resolveGuiParent()
	local self = setmetatable({
		Title = tostring(options.Title or "Window"),
		Scale = 1,
		MinScale = 0.5,
		MaxScale = 1.5,
		Opacity = 100,
		BackgroundAsset = tostring(options.BackgroundAsset or ""),
		RgbText = options.RgbText == true,
		ToggleKeybind = nil,
		ScaleFlag = tostring(options.ScaleFlag or "ui.scale"),
		Changed = Signal.new(),
		Destroyed = false,
		_visible = true,
		_minimized = false,
		_settled = false,
		_unit = 1,
		_tier = TIERS[1],
		_tabs = {},
		_activeTab = nil,
		_elements = {},
		_rows = {},
		_texts = {},
		_painters = {},
		_paragraphEntries = {},
		_connections = {},
		_visibilityVersion = 0,
	}, Window)
	if options.OnChanged ~= nil and type(options.OnChanged) ~= "function" then
		error("[xanax.ui] OnChanged must be a function", 2)
	end
	if options.OnChanged then
		self:_track(self.Changed:Connect(function(flag, value)
			task.spawn(function()
				local ok, err = pcall(options.OnChanged, flag, value)
				if not ok then
					warn("[xanax.ui] OnChanged failed: " .. tostring(err))
				end
			end)
		end))
	end
	table.insert(Library.Windows, self)
	self:_build(parent)
	if options.ToggleKeybind ~= nil then
		self:SetToggleKey(options.ToggleKeybind)
	end
	self:SetScale(tonumber(options.Scale) or 1)
	self:SetOpacity(tonumber(options.Opacity) or 100)
	if self.BackgroundAsset ~= "" then
		self:_applyBackground()
	end
	self:_relayout()
	self:_applyWaveState()

	-- staged reveal: settle scale/fade, then the first page staggers up on SelectTab
	if animationsActive() then
		self._uiScale.Scale = 0.94
		self._shroud.BackgroundTransparency = 1
		Library:Tween(self._uiScale, { Scale = self.Scale }, Tokens.SLOW, "Back")
		self:_setShroud(1 - self.Opacity / 100)
	end
	task.delay(0.16, function()
		if not self.Destroyed then
			self._settled = true
		end
	end)
	return self
end

-- Value serialization helpers -----------------------------------------------------------------

function Library:SerializeValue(value)
	if typeof(value) == "Color3" then
		return { R = math.floor(value.R * 1000 + 0.5) / 1000, G = math.floor(value.G * 1000 + 0.5) / 1000, B = math.floor(value.B * 1000 + 0.5) / 1000 }
	elseif typeof(value) == "EnumItem" then
		return tostring(value.Name)
	elseif type(value) == "table" then
		local copy = {}
		for key, entry in pairs(value) do
			copy[key] = Library:SerializeValue(entry)
		end
		return copy
	end
	return value
end

function Library:DeserializeValue(value)
	if type(value) == "table" then
		if type(value.R) == "number" and type(value.G) == "number" and type(value.B) == "number" then
			return Color3.new(clamp(value.R, 0, 1), clamp(value.G, 0, 1), clamp(value.B, 0, 1))
		end
		local copy = {}
		for key, entry in pairs(value) do
			copy[key] = Library:DeserializeValue(entry)
		end
		return copy
	end
	return value
end

return Library
