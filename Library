function Section:AddButton(options)
    options = options or {}
    local element = { Type = "Button", Name = options.Name or "Button", Callback = options.Callback }

    local button = new("TextButton", {
        Name = "Button",
        Size = UDim2.new(1, 0, 0, S.FieldH),
        BackgroundColor3 = Theme.Field,
        AutoButtonColor = false,
        Font = Theme.FontMedium,
        Text = element.Name,
        TextSize = S.FieldText,
        TextColor3 = Theme.TextSecondary,
        Active = true,
    }, self.Body)
    corner(button, S.FieldRadius)
    stroke(button, Theme.Stroke, 1)
    hoverFill(button, Theme.Field, Theme.FieldHover)

    element.Instance = button

    button.MouseButton1Click:Connect(function()
        tween(button, 0.08, { BackgroundColor3 = Theme.AccentPress })
        task.spawn(function()
            task.wait(0.09)
            tween(button, 0.12, { BackgroundColor3 = Theme.Field })
        end)
