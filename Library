--[[
	Xanax UI Library
	------------------------------------------------------------
	Pure, loadstring-ready UI engine for Roblox executors.
	No demo code, no image-specific layout, no config system lives
	in this file. Build windows/tabs/elements through the public
	API below (see Preview.lua / Example.lua for usage examples).

	Host this file on GitHub (raw) and load it with:
		loadstring(game:HttpGet("<raw url>"))()

	Public API summary:
		Library:CreateWindow(cfg)                 -> Window
		Window:CreateTab(cfg)                     -> Tab
		Window:Destroy()
		Window:SetVisible(bool)
		Tab:AddSection(cfg)                       -> Section
		Section:AddLabel(cfg)                     -> Element
		Section:AddParagraph(cfg)                 -> Element
		Section:AddDivider(cfg)                   -> Element
		Section:AddToggle(cfg)                    -> Element
		Section:AddSlider(cfg)                    -> Element
		Section:AddDropdown(cfg)                  -> Element
		Section:AddButton(cfg)                    -> Element
		Section:AddTextbox(cfg)                   -> Element
		Section:AddKeybind(cfg)                   -> Element
		Section:AddColorPicker(cfg)                -> Element

		Element:Set(value, silent)
		Element:Get()

		Library.Flags[flagName] -> Element (registered automatically
			for any element created with a `Flag` field in its config)
]]

