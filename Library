--=====================================================================--
-- SMALL HELPERS
--=====================================================================--
local function apply(props, defaults)
    props = props or {}
    for key, value in pairs(defaults) do
        if props[key] == nil then props[key] = value end
    end
    return props
end

local function new(class, props, parent)
    local inst = Instance.new(class)
    for key, value in pairs(props or {}) do
        if key ~= "Parent" then inst[key] = value end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(inst, radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local function stroke(inst, color, thickness)
    return new("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function padding(inst, left, right, top, bottom)
    return new("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0), PaddingRight = UDim.new(0, right or 0),
        PaddingTop = UDim.new(0, top or 0), PaddingBottom = UDim.new(0, bottom or 0),
    }, inst)
end

local function vlist(inst, gap)
    return new("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, gap or 0),
    }, inst)
end

local function tween(inst, duration, props)
    local anim = TweenService:Create(inst, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    anim:Play()
    return anim
end

local function text(parent, props)
    return new("TextLabel", apply(props, {
        BackgroundTransparency = 1,
        Font = Theme.Font,
        TextSize = S.LabelText,
        TextColor3 = Theme.TextSecondary,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = false,
        Text = "",
    }), parent)
end

local function glyph(name)
    if type(name) ~= "string" or name == "" then return Icons.dot end
    return Icons[name] or name
end

local function copyList(source)
    local out = {}
    if type(source) == "table" then
        for index, value in ipairs(source) do out[index] = value end
    end
    return out
end

local function inBounds(inst, point)
    if not inst or not inst.Parent then return false end
    local pos, size = inst.AbsolutePosition, inst.AbsoluteSize
    return point.X >= pos.X and point.X <= pos.X + size.X
       and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end

local function hoverFill(button, base, hover)
    button.MouseEnter:Connect(function() tween(button, 0.12, { BackgroundColor3 = hover }) end)
    button.MouseLeave:Connect(function() tween(button, 0.12, { BackgroundColor3 = base }) end)
end

--=====================================================================--
-- FLAG REGISTRY (one group per flag; a group may drive many elements)
--=====================================================================--
function Library:BindFlag(flag, element)
    if type(flag) ~= "string" or flag == "" then return end
    local group = self.Flags[flag]
    if not group then
        group = { Flag = flag, Type = element.Type, Elements = {} }

        function group:Get()
            local first = self.Elements[1]
            if first then return first:Get() end
            return nil
        end

        function group:Set(value, silent)
            local applied = false
            for _, element in ipairs(self.Elements) do
                local ok = pcall(element.Set, element, value, silent)
                applied = applied or ok
            end
            return applied
        end

        self.Flags[flag] = group
    end
    group.Type = group.Type or element.Type
    table.insert(group.Elements, element)
end

function Library:UnbindElement(element)
    local flag = element and element.Flag
    if type(flag) ~= "string" then return end
    local group = self.Flags[flag]
    if not group then return end
    for index = #group.Elements, 1, -1 do
        if group.Elements[index] == element then table.remove(group.Elements, index) end
    end
    if #group.Elements == 0 then self.Flags[flag] = nil end
end

function Library:GetFlag(flag)
    local group = self.Flags[flag]
    return group and group:Get()
end

function Library:SetFlag(flag, value, silent)
    local group = self.Flags[flag]
    if not group then return false end
    return group:Set(value, silent)
end

--=====================================================================--
-- CLASSES
--=====================================================================--
local Window  = {}; Window.__index  = Window
local Tab     = {}; Tab.__index     = Tab
local Section = {}; Section.__index = Section

local function registerElement(section, element)
    element.Section = section
    element.Window  = section.Window
    element.Tab     = section.Tab
    table.insert(section.Elements, element)
    if type(element.Flag) == "string" and element.Flag ~= "" then
        Library:BindFlag(element.Flag, element)
    end
    return element
end

--=====================================================================--
-- WINDOW
--=====================================================================--
local function resolveParent(gui)
    local candidates = {}

    if type(gethui) == "function" then
        local ok, host = pcall(gethui)
        if ok and typeof(host) == "Instance" then table.insert(candidates, host) end
    end

    local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if okCore and typeof(coreGui) == "Instance" then table.insert(candidates, coreGui) end

    local okPlayers, players = pcall(function() return game:GetService("Players") end)
    if okPlayers and players and players.LocalPlayer then
        local playerGui = players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
            or players.LocalPlayer:WaitForChild("PlayerGui", 5)
        if playerGui then table.insert(candidates, playerGui) end
    end

    for _, host in ipairs(candidates) do
        local ok = pcall(function() gui.Parent = host end)
        if ok and gui.Parent == host then return host end
    end
    return nil
end

function Library:CreateWindow(options)
    options = options or {}

    local gui = new("ScreenGui", {
        Name = "Xanax_" .. HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 8),
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })

    if type(syn) == "table" and type(syn.protect_gui) == "function" then
        pcall(syn.protect_gui, gui)
    elseif type(protectgui) == "function" then
        pcall(protectgui, gui)
    end

    if not resolveParent(gui) then
        gui:Destroy()
        warn("[Xanax] No reachable GUI parent (gethui / CoreGui / PlayerGui all failed).")
        return nil
    end

    local self = setmetatable({}, Window)
    self.Library     = Library
    self.Gui         = gui
    self.Title       = options.Title or Library.Name
    self.Tabs        = {}
    self.Categories  = {}
    self.CategoryOrder = 0
    self.Connections = {}
    self.Destroyed   = false
    self.Offset      = Vector2.new(0, 0)
    self.ScaleValue  = 1
    self.OpenMenu    = nil
    self.ToggleKey   = options.ToggleKey or Enum.KeyCode.RightShift

    local size = options.Size or Vector2.new(S.WindowW, S.WindowH)
    self.Width, self.Height = size.X, size.Y

    -- ROOT ------------------------------------------------------------
    local root = new("Frame", {
        Name = "Root",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(self.Width, self.Height),
        BackgroundColor3 = Theme.Backdrop,
        Active = true,
    }, gui)
    corner(root, S.WindowRadius)
    stroke(root, Theme.Stroke, 1)
    self.Root = root

    local scale = new("UIScale", { Scale = 1 }, root)
    self.Scale = scale

    local function fit()
        local viewport = gui.AbsoluteSize
        if viewport.X < 10 or viewport.Y < 10 then return end
        local value = math.min(1, (viewport.X - 40) / self.Width, (viewport.Y - 40) / self.Height)
        value = math.max(0.35, value)
        scale.Scale = value
        self.ScaleValue = value
        self:CloseMenus()
    end
    fit()
    table.insert(self.Connections, gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))

    -- SIDEBAR ---------------------------------------------------------
    local sidebar = new("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(S.WindowPad, S.WindowPad),
        Size = UDim2.fromOffset(S.SidebarW, self.Height - S.WindowPad * 2),
        BackgroundColor3 = Theme.Sidebar,
        Active = true,
    }, root)
    corner(sidebar, S.SidebarRadius)
    self.Sidebar = sidebar

    local brand = new("Frame", {
        Name = "Brand",
        Position = UDim2.fromOffset(S.BrandY, S.BrandY),
        Size = UDim2.fromOffset(S.SidebarW - S.BrandY * 2, S.BrandH),
        BackgroundTransparency = 1,
        Active = true,
    }, sidebar)

    local mark = new("Frame", {
        Size = UDim2.fromOffset(S.BrandMark, S.BrandMark),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Theme.Accent,
    }, brand)
    corner(mark, S.BrandMarkRadius)
    new("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(91, 155, 255), Theme.AccentPress),
        Rotation = 160,
    }, mark)
    text(mark, {
        Size = UDim2.fromScale(1, 1),
        Text = "X",
        Font = Theme.FontBold,
        TextSize = 17,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextXAlignment = Enum.TextXAlignment.Center,
    })

    text(brand, {
        Position = UDim2.fromOffset(S.BrandMark + S.BrandGap, 0),
        Size = UDim2.new(1, -(S.BrandMark + S.BrandGap), 1, 0),
        Text = self.Title,
        Font = Theme.FontBold,
        TextSize = S.BrandText,
        TextColor3 = Theme.TextPrimary,
    })
    self.DragHandle = brand

    local navHeight = (self.Height - S.WindowPad * 2) - S.NavTop - (S.SearchH + S.SearchBottom * 2)
    local nav = new("ScrollingFrame", {
        Name = "Nav",
        Position = UDim2.fromOffset((S.SidebarW - S.NavW) / 2, S.NavTop),
        Size = UDim2.fromOffset(S.NavW, navHeight),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Active = true,
    }, sidebar)
    vlist(nav, S.NavGap)
    padding(nav, 2, 2, 0, 8)
    self.Nav = nav

    local searchBox = new("Frame", {
        Name = "Search",
        Position = UDim2.fromOffset(S.BrandY, (self.Height - S.WindowPad * 2) - S.SearchH - S.SearchBottom),
        Size = UDim2.fromOffset(S.SidebarW - S.BrandY * 2, S.SearchH),
        BackgroundColor3 = Theme.Field,
        Active = true,
    }, sidebar)
    corner(searchBox, S.SearchRadius)
    stroke(searchBox, Theme.SoftStroke, 1)
    text(searchBox, {
        Position = UDim2.fromOffset(11, 0),
        Size = UDim2.fromOffset(18, S.SearchH),
        Text = Icons.search,
        TextSize = 17,
        TextColor3 = Theme.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    local searchInput = new("TextBox", {
        Position = UDim2.fromOffset(34, 0),
        Size = UDim2.new(1, -44, 1, 0),
        BackgroundTransparency = 1,
        Font = Theme.Font,
        TextSize = S.SearchText,
        TextColor3 = Theme.TextSecondary,
        PlaceholderText = "Search...",
        PlaceholderColor3 = Theme.TextDim,
        Text = "",
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, searchBox)
    self.SearchInput = searchInput
    table.insert(self.Connections, searchInput:GetPropertyChangedSignal("Text"):Connect(function()
        self:_applySearch(searchInput.Text)
    end))

    -- CONTENT ---------------------------------------------------------
    local content = new("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(S.WindowPad * 2 + S.SidebarW, S.WindowPad),
        Size = UDim2.fromOffset(self.Width - (S.WindowPad * 3 + S.SidebarW), self.Height - S.WindowPad * 2),
        BackgroundColor3 = Theme.Content,
        Active = true,
    }, root)
    corner(content, S.ContentRadius)
    self.Content = content
    self.ContentWidth = content.Size.X.Offset

    local columnWidth = math.floor((self.ContentWidth - S.ContentPad * 2 - S.ColumnGap) / 2)
    self.ColumnWidth = columnWidth

    -- OVERLAY (dropdown menus / colour pickers) -----------------------
    local overlay = new("Frame", {
        Name = "Overlay",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 100,
        Active = false,
    }, root)
    self.Overlay = overlay

    -- DRAGGING --------------------------------------------------------
    local dragging, dragStart, dragOrigin = false, nil, nil
    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging   = true
        dragStart  = input.Position
        dragOrigin = self.Offset
        self:CloseMenus()
    end
    brand.InputBegan:Connect(beginDrag)
    sidebar.InputBegan:Connect(beginDrag)

    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        local viewport = gui.AbsoluteSize
        local limitX = math.max(0, (viewport.X + self.Width * self.ScaleValue) / 2 - 70)
        local limitY = math.max(0, (viewport.Y + self.Height * self.ScaleValue) / 2 - 50)
        self.Offset = Vector2.new(
            math.clamp(dragOrigin.X + delta.X, -limitX, limitX),
            math.clamp(dragOrigin.Y + delta.Y, -limitY, limitY)
        )
        root.Position = UDim2.new(0.5, self.Offset.X, 0.5, self.Offset.Y)
    end))

    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    -- GLOBAL INPUT: toggle key + click-away for menus ------------------
    table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if self.Destroyed then return end

        if not processed and input.KeyCode == self.ToggleKey and not UserInputService:GetFocusedTextBox() then
            self:Toggle()
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            local menu = self.OpenMenu
            if menu then
                local point = Vector2.new(input.Position.X, input.Position.Y)
                if not inBounds(menu.Frame, point) and not inBounds(menu.Trigger, point) then
                    self:CloseMenus()
                end
            end
        end
    end))

    table.insert(Library.Windows, self)
    Library.CurrentWindow = self
    return self
end

function Window:_applySearch(query)
    query = string.lower(query or "")
    for _, tab in ipairs(self.Tabs) do
        local visible = query == "" or string.find(string.lower(tab.Name), query, 1, true) ~= nil
        tab.NavButton.Visible = visible
    end
    for _, category in pairs(self.Categories) do
        local any = false
        for _, tab in ipairs(self.Tabs) do
            if tab.Category == category.Name and tab.NavButton.Visible then any = true break end
        end
        category.Label.Visible = any
    end
end

function Window:_category(name)
    if not name or name == "" then return nil end
    local existing = self.Categories[name]
    if existing then return existing end

    self.CategoryOrder = self.CategoryOrder + 1
    local order = self.CategoryOrder * 100

    local label = text(self.Nav, {
        Name = "Category_" .. name,
        Size = UDim2.new(1, 0, 0, S.CategoryH),
        Text = name,
        TextSize = S.CategoryText,
        TextColor3 = Theme.TextDim,
        Font = Theme.FontMedium,
        LayoutOrder = order,
    })
    padding(label, S.CategoryX, 0, 0, 0)

    local category = { Name = name, Label = label, Order = order, Count = 0 }
    self.Categories[name] = category
    return category
end

function Window:CreateTab(options)
    options = options or {}
    local tab = setmetatable({}, Tab)
    tab.Window   = self
    tab.Name     = options.Name or "Tab"
    tab.Category = options.Category
    tab.Sections = {}
    tab.Columns  = {}

    local category = self:_category(tab.Category)
    local order
    if category then
        category.Count = category.Count + 1
        order = category.Order + category.Count
    else
        self.CategoryOrder = self.CategoryOrder + 1
        order = self.CategoryOrder * 100
    end

    local button = new("TextButton", {
        Name = "Nav_" .. tab.Name,
        Size = UDim2.new(1, 0, 0, S.NavItemH),
        BackgroundColor3 = Theme.Sidebar,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        LayoutOrder = order,
        Active = true,
    }, self.Nav)
    corner(button, S.NavRadius)

    local iconLabel = text(button, {
        Position = UDim2.fromOffset(S.NavIconX, 0),
        Size = UDim2.fromOffset(20, S.NavItemH),
        Text = glyph(options.Icon),
        TextSize = S.NavIcon,
        TextColor3 = Theme.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    local nameLabel = text(button, {
        Position = UDim2.fromOffset(S.NavLabelX, 0),
        Size = UDim2.new(1, -(S.NavLabelX + 10), 1, 0),
        Text = tab.Name,
        TextSize = S.NavText,
        TextColor3 = Theme.TextMuted,
    })

    tab.NavButton = button
    tab.NavIcon   = iconLabel
    tab.NavLabel  = nameLabel

    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, { BackgroundTransparency = 0, BackgroundColor3 = Theme.NavHover })
        end
    end)
    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(button, 0.12, { BackgroundTransparency = 1 })
        end
    end)
    button.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

    -- PAGE ------------------------------------------------------------
    local page = new("ScrollingFrame", {
        Name = "Page_" .. tab.Name,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.Stroke,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Active = true,
    }, self.Content)
    padding(page, S.ContentPad, S.ContentPad, S.ContentPad, S.ContentPad)
    tab.Page = page

    for index = 1, 2 do
        local column = new("Frame", {
            Name = "Column" .. index,
            Position = UDim2.fromOffset((index - 1) * (self.ColumnWidth + S.ColumnGap), 0),
            Size = UDim2.fromOffset(self.ColumnWidth, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Active = true,
        }, page)
        vlist(column, S.ColumnGap)
        tab.Columns[index] = column
    end

    table.insert(self.Tabs, tab)
    if not self.ActiveTab then self:SelectTab(tab) end
    self:_applySearch(self.SearchInput and self.SearchInput.Text or "")
    return tab
end

function Window:SelectTab(tab)
    self:CloseMenus()
    for _, entry in ipairs(self.Tabs) do
        local active = entry == tab
        entry.Page.Visible = active
        entry.NavButton.BackgroundTransparency = active and 0 or 1
        entry.NavButton.BackgroundColor3 = Theme.NavActive
        tween(entry.NavLabel, 0.12, { TextColor3 = active and Theme.TextPrimary or Theme.TextMuted })
        tween(entry.NavIcon, 0.12, { TextColor3 = active and Theme.TextPrimary or Theme.TextMuted })
    end
    self.ActiveTab = tab
    return tab
end

function Window:FindTab(name)
    local wanted = string.lower(tostring(name or ""))
    for _, tab in ipairs(self.Tabs) do
        if string.lower(tab.Name) == wanted then return tab end
    end
    return nil
end

function Window:CloseMenus()
    local menu = self.OpenMenu
    if not menu then return end
    self.OpenMenu = nil
    pcall(menu.Close)
end

function Window:SetVisible(visible)
    if self.Destroyed then return end
    if not visible then self:CloseMenus() end
    self.Gui.Enabled = visible and true or false
end

function Window:Toggle()
    self:SetVisible(not self.Gui.Enabled)
end

function Window:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    self:CloseMenus()

    for _, connection in ipairs(self.Connections) do pcall(function() connection:Disconnect() end) end
    self.Connections = {}

    for _, tab in ipairs(self.Tabs) do
        for _, section in ipairs(tab.Sections) do
            for _, element in ipairs(section.Elements) do Library:UnbindElement(element) end
        end
    end

    pcall(function() self.Gui:Destroy() end)

    for index = #Library.Windows, 1, -1 do
        if Library.Windows[index] == self then table.remove(Library.Windows, index) end
    end
    if Library.CurrentWindow == self then
        Library.CurrentWindow = Library.Windows[#Library.Windows]
    end
end

