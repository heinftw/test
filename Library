function Window:_buildSlider(tab, options)
	local theme = Library.Theme
	local row = self:_newRow(tab, "Slider", options)
	local content = new("Frame", {
		Name = "SliderContent",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(options.Narrow and 0.97 or 1, 1),
	}, row)
	local valueLabel = self:_text("TextLabel", content, "Value", "", TEXT_BASE.Tiny, {
		Size = UDim2.fromScale(1, 0.5),
	})
	local decrease = self:_text("TextButton", content, "Decrease", "-", TEXT_BASE.Small, {
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromScale(10 / 224, 10 / 24),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local increase = self:_text("TextButton", content, "Increase", "+", TEXT_BASE.Small, {
		Position = UDim2.fromScale(214 / 224, 0.5),
		Size = UDim2.fromScale(10 / 224, 10 / 24),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local hitArea = self:_text("TextButton", content, "Range_" .. tostring(options.Flag or options.Text), "", TEXT_BASE.Tiny, {
		Position = UDim2.fromScale(12 / 224, 0.46),
		Size = UDim2.fromScale(198 / 224, 12 / 24),
		Active = true,
		Text = "",
	})
	local track = new("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromScale(1, 5 / 12),
		BackgroundColor3 = lighten(theme.Panel, 0.12),
		BorderSizePixel = 1,
		BorderColor3 = theme.Border,
	}, hitArea)
	local fillGradient = new("UIGradient", {
		Color = ColorSequence.new(theme.Accent, lighten(theme.Accent, 0.35)),
		Rotation = 0,
	}, nil)
	local fill = new("Frame", {
		Name = "Fill",
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
	}, track)
	fillGradient.Parent = fill
	local knob = new("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 1, 0.5, 0),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = theme.Text,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
	}, hitArea)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	local knobScale = new("UIScale", { Scale = 0 }, knob)
	local bubble = new("CanvasGroup", {
		Name = "Bubble",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0, 1, 0, -4),
		Size = UDim2.fromOffset(34, 16),
		BackgroundColor3 = darken(theme.Panel, 0.15),
		BorderSizePixel = 1,
		BorderColor3 = theme.Edge,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = 4,
	}, hitArea)
	new("UICorner", { CornerRadius = UDim.new(0, 3) }, bubble)
	local bubbleText = new("TextLabel", {
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		TextSize = 10,
		TextColor3 = theme.Text,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, bubble)

	local element = newElement("Slider", tab, options, row)
	element:Bind(hitArea)
	element:Bind(fill)
	element.Options = {
		Min = tonumber(options.Min) or 0,
		Max = tonumber(options.Max) or 100,
		Step = (finite(tonumber(options.Step)) and tonumber(options.Step) > 0) and tonumber(options.Step) or 1,
		Suffix = tostring(options.Suffix or ""),
	}
	element.Options.Min, element.Options.Max = math.min(element.Options.Min, element.Options.Max), math.max(element.Options.Min, element.Options.Max)
	local suffix = element.Options.Suffix

	local function formatValue(value)
		local number = (value % 1 == 0) and string.format("%d", math.floor(value + 0.5)) or string.format("%.2f", value)
		return number .. suffix
	end

	local function viewValue(value, instant)
		local ratio = clamp((value - element.Options.Min) / math.max(1e-9, element.Options.Max - element.Options.Min), 0, 1)
		valueLabel.Text = string.format("%s %s", options.Text or options.Title or "", formatValue(value))
		hitArea:SetAttribute("Value", value)
		decrease.TextTransparency = value <= element.Options.Min + 1e-9 and 0.45 or 0
		increase.TextTransparency = value >= element.Options.Max - 1e-9 and 0.45 or 0
		local targetSize = UDim2.new(ratio, -2 * ratio, 1, -2)
		bubble.Position = UDim2.new(ratio, 0, 0, -5)
		if instant then
			fill.Size = targetSize
			knob.Position = UDim2.new(ratio, 0, 0.5, 0)
		elseif self._sliderDrag and self._sliderDrag.Element == element then
			fill.Size = targetSize
			knob.Position = UDim2.new(ratio, 0, 0.5, 0)
		else
			Library:Tween(fill, { Size = targetSize }, Tokens.INSTANT, "Quint")
			Library:Tween(knob, { Position = UDim2.new(ratio, 0, 0.5, 0) }, Tokens.INSTANT, "Quint")
		end
	end

	element._normalize = function(value)
		local number = tonumber(value)
		if not finite(number) then
			return false, "Slider value must be a number"
		end
		local range = element.Options.Max - element.Options.Min
		local stepped = element.Options.Min + math.floor((clamp(number, element.Options.Min, element.Options.Max) - element.Options.Min) / element.Options.Step + 0.5) * element.Options.Step
		stepped = clamp(stepped, element.Options.Min, element.Options.Max)
		if stepped % 1 ~= 0 and math.abs(stepped % 1 - 1) < 1e-6 then
			stepped = math.floor(stepped)
		end
		return true, stepped
	end
	element._apply = function(value, instant)
		viewValue(value, instant == true)
	end
	self:_paintable(function()
		track.BackgroundColor3 = lighten(theme.Panel, 0.12)
		track.BorderColor3 = theme.Border
		fill.BackgroundColor3 = theme.Accent
		fillGradient.Color = ColorSequence.new(theme.Accent, lighten(theme.Accent, 0.35))
		knob.BackgroundColor3 = theme.Text
		bubble.BackgroundColor3 = darken(theme.Panel, 0.15)
		bubble.BorderColor3 = theme.Edge
		bubbleText.TextColor3 = theme.Text
	end)
	element:Set(tonumber(options.Default) or element.Options.Min, true)

	local function stepBy(direction)
		element:Set(element.Value + element.Options.Step * direction)
	end

	bindButton(self, decrease, function()
		stepBy(-1)
	end, function()
		return theme.Panel, 1, theme.Text
	end)
	bindButton(self, increase, function()
		stepBy(1)
	end, function()
		return theme.Panel, 1, theme.Text
	end)
	bindButton(self, hitArea, function() end, function()
		return theme.Panel, 1, theme.Text
	end)

	local function showFocusFx(state, ratio)
		knob.Visible = true
		Library:Tween(knobScale, { Scale = state and 1.25 or 1 }, state and Tokens.INSTANT or Tokens.FAST, "Back")
		Library:Tween(bubble, { GroupTransparency = state and 0 or 1 }, state and Tokens.INSTANT or Tokens.FAST, "Quad")
		if state and ratio then
			bubble.Position = UDim2.new(ratio, 0, 0, -5)
		end
		if not state then
			task.delay(Tokens.FAST + 0.02, function()
				if bubble.Parent and bubble.GroupTransparency >= 0.99 then
					bubble.Visible = false
				end
			end)
		end
	end

	self:_track(hitArea.MouseEnter:Connect(function()
		self._hoveredSliderStep = function(direction)
			stepBy(direction)
		end
		knob.Visible = true
		Library:Tween(knobScale, { Scale = 1.08 }, Tokens.FAST, "Back")
	end))
	self:_track(hitArea.MouseLeave:Connect(function()
		if self._hoveredSliderStep then
			self._hoveredSliderStep = nil
		end
		if not (self._sliderDrag and self._sliderDrag.Element == element) then
			showFocusFx(false)
		end
	end))

	self:_track(hitArea.InputBegan:Connect(function(input)
		if self._minimized then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			local overlay = new("Frame", {
				Name = "SliderInput",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = theme.Panel,
				BorderSizePixel = 1,
				BorderColor3 = theme.Accent,
				ZIndex = 8,
			}, hitArea)
			local box = new("TextBox", {
				Name = "Input",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = tostring(element.Value),
				Font = Enum.Font.Code,
				TextSize = 10,
				TextColor3 = theme.Accent,
				TextXAlignment = Enum.TextXAlignment.Center,
				ClearTextOnFocus = true,
				ZIndex = 9,
			}, overlay)
			box:CaptureFocus()
			self:_track(box.FocusLost:Connect(function(enterPressed)
				if enterPressed then
					local number = tonumber(box.Text)
					if number then
						element:Set(number)
					end
				end
				overlay:Destroy()
			end))
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if self._sliderDrag then
				return
			end
			self._sliderDrag = {
				Element = element,
				HitArea = hitArea,
				Bubble = bubble,
				ShowFocusFx = showFocusFx,
				LastInput = input,
			}
			self:_updateSliderDrag(input.Position)
			showFocusFx(true, clamp((element.Value - element.Options.Min) / math.max(1e-9, element.Options.Max - element.Options.Min), 0, 1))
		end
	end))

	return element
end

function Window:_updateSliderDrag(position)
	local drag = self._sliderDrag
	if not drag or not drag.HitArea.Parent or drag.HitArea.AbsoluteSize.X <= 0 then
		return
	end
	local inset = GuiService:GetGuiInset()
	local x = position.X - inset.X - drag.HitArea.AbsolutePosition.X
	local ratio = clamp(x / drag.HitArea.AbsoluteSize.X, 0, 1)
	local element = drag.Element
	drag.LastRatio = ratio
	element.Options.Min = element.Options.Min
	local target = element.Options.Min + ratio * (element.Options.Max - element.Options.Min)
	if element._normalize then
		local ok, normalized = element._normalize(target)
		if ok then
			target = normalized
		end
	end
	element.Value = target
	Library.Flags[element.Flag] = target
	element._apply(target, true)
	element:Fire(target)
	element.Window.Changed:Fire(element.Flag, target)
end

function Window:_endSliderDrag()
	local drag = self._sliderDrag
	if not drag then
		return
	end
	self._sliderDrag = nil
	local element = drag.Element
	if element and not element.Destroyed then
		element._apply(element.Value, false)
		element:Fire(element.Value)
		element.Window.Changed:Fire(element.Flag, element.Value)
		if drag.ShowFocusFx then
			drag.ShowFocusFx(false)
		end
	end
end

-- Dropdown --------------------------------------------------------------------------

function Window:_buildDropdown(tab, options)
	local theme = Library.Theme
	local row = self:_newRow(tab, "Dropdown", options)
	local label = self:_text("TextLabel", row, "Label", options.Text or options.Title or "Select", TEXT_BASE.Small, {
		Size = UDim2.fromScale(1, 12 / 31),
	})
	local multi = options.Multi == true
	local button = self:_text("TextButton", row, "Select", "", TEXT_BASE.Body, {
		Position = UDim2.fromScale(0, 12 / 31),
		Size = UDim2.fromScale(0.565, 14 / 31),
		BackgroundTransparency = 0,
		BackgroundColor3 = lighten(theme.Panel, 0.185),
		BorderSizePixel = 1,
		BorderColor3 = theme.Border,
	})
	new("UIPadding", { PaddingLeft = UDim.new(0.03, 0), PaddingRight = UDim.new(0, 16) }, button)
	local chevron = new("TextButton", {
		Name = "Chevron",
		Text = "+",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		TextSize = 12,
		TextColor3 = theme.Muted,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Active = false,
		Selectable = false,
	}, button)

	local element = newElement("Dropdown", tab, options, row)
	element:Bind(button)
	element.Multi = multi
	element.Options = {}
	if type(options.Options) == "table" then
		for _, option in ipairs(options.Options) do
			table.insert(element.Options, tostring(option))
		end
	end

	local function displayFor(value)
		if multi then
			if type(value) ~= "table" or #value == 0 then
				return "—"
			end
			local parts = {}
			for index = 1, math.min(#value, 2) do
				table.insert(parts, tostring(value[index]))
			end
			local text = table.concat(parts, ", ")
			if #value > 2 then
				text = text .. " +" .. tostring(#value - 2)
			end
			return text
		end
		return tostring(value ~= nil and value or "—")
	end

	local function defaultFor()
		if multi then
			local selected = {}
			local defaults = options.Default or options.Values
			if type(defaults) == "table" then
				for _, value in ipairs(defaults) do
					if tableFind(element.Options, tostring(value)) then
						table.insert(selected, tostring(value))
					end
				end
			end
			return selected
		end
		if tableFind(element.Options, tostring(options.Default)) then
			return tostring(options.Default)
		end
		return element.Options[1]
	end

	local function paintSelection(marker, item)
		if marker and item and item.Parent then
			Library:Tween(marker, { Position = UDim2.new(0, 0, 0, item.Position.Y.Offset) }, Tokens.FAST, "Quint")
		end
	end

	local function buildItems(popup, panel)
		local unit = clamp(self._unit or 1, 0.85, 1.6)
		local itemHeight = clamp(math.floor(button.AbsoluteSize.Y * 1.5), math.floor(22 * unit), math.floor(42 * unit))
		local list = new("ScrollingFrame", {
			Name = "Options",
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.new(1, -8, 1, -8),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(1, 0, 0, #element.Options * itemHeight + 4),
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = theme.Accent,
			ScrollBarImageTransparency = 0.4,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ElasticBehavior = Enum.ElasticBehavior.Never,
			Active = true,
			ZIndex = 3,
		}, panel)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 1) }, list)
		local marker = new("Frame", {
			Name = "Marker",
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.new(1, 0, 0, itemHeight),
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = 0.88,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, list)
		new("Frame", {
			Name = "MarkerBar",
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, marker)

		local function isSelected(option)
			if multi then
				return type(element.Value) == "table" and tableFind(element.Value, option) ~= nil
			end
			return element.Value == option
		end

		local function toggleOption(option)
			if multi then
				local selected = {}
				if type(element.Value) == "table" then
					for _, value in ipairs(element.Value) do
						table.insert(selected, value)
					end
				end
				local existing = tableFind(selected, option)
				if existing then
					table.remove(selected, existing)
				else
					table.insert(selected, option)
				end
				element:Set(selected)
			else
				element:Set(option)
				self:_closePopup()
			end
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("TextButton") then
					child.TextColor3 = isSelected(child.Text) and theme.Accent or theme.Text
				end
			end
		end

		local firstItem = nil
		for index, option in ipairs(element.Options) do
			local item = new("TextButton", {
				Name = "Option_" .. tostring(index),
				LayoutOrder = index,
				Size = UDim2.new(1, -2, 0, itemHeight),
				BackgroundColor3 = theme.Panel,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Font = Enum.Font.Code,
				Text = option,
				TextSize = math.max(9, math.floor(10 * unit + 0.5)),
				TextColor3 = isSelected(option) and theme.Accent or theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				ZIndex = 3,
			}, list)
			new("UIPadding", { PaddingLeft = UDim.new(0, 8) }, item)
			if isSelected(option) and firstItem == nil then
				firstItem = item
			end
			item.MouseEnter:Connect(function()
				paintSelection(marker, item)
			end)
			item.Activated:Connect(function()
				toggleOption(option)
			end)
			local delay = math.min(index - 1, 12) * 0.02
			if animationsActive() then
				item.TextTransparency = 1
				task.delay(delay, function()
					if item.Parent then
						Library:Tween(item, { TextTransparency = 0 }, Tokens.FAST, "Quad")
					end
				end)
			end
		end
		if firstItem then
			task.defer(function()
				if marker.Parent then
					marker.Position = UDim2.new(0, 0, 0, firstItem.Position.Y.Offset)
					list.CanvasPosition = Vector2.new(0, math.max(0, firstItem.Position.Y.Offset - itemHeight))
				end
			end)
		end
	end

	local function openDropdown()
		if self._popup and self._popup.Kind == "Dropdown" and self._popup.Element == element then
			self:_closePopup()
			return
		end
		local unit = clamp(self._unit or 1, 0.85, 1.6)
		local itemHeight = clamp(math.floor(button.AbsoluteSize.Y * 1.5), math.floor(22 * unit), math.floor(42 * unit))
		local visibleItems = math.min(#element.Options, 8)
		local popupHeight = math.min(#element.Options * itemHeight + 8, self._popupLayer.AbsoluteSize.Y * 0.6)
		local popupWidth = math.max(button.AbsoluteSize.X, math.floor(120 * unit))
		popupWidth = math.min(popupWidth, self._popupLayer.AbsoluteSize.X - POPUP_MARGIN * 2)
		local popup = self:_openPopup("Dropdown", button, {
			RootSize = UDim2.fromOffset(popupWidth, math.max(itemHeight, popupHeight)),
			OnClose = function()
				Library:Tween(chevron, { Rotation = 0 }, Tokens.FAST, "Back")
				Library:Tween(chevron, { TextColor3 = theme.Muted }, Tokens.FAST, "Quad")
			end,
		})
		popup.Element = element
		if not popup then
			return
		end
		Library:Tween(chevron, { Rotation = 180 }, Tokens.FAST, "Back")
		Library:Tween(chevron, { TextColor3 = theme.Accent }, Tokens.FAST, "Quad")
		local panel = new("Frame", {
			Name = "ListPanel",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 2,
		}, popup.Root)
		buildItems(popup, panel)
		popup.Collapse = function()
			Library:Tween(popup.Root, { Size = UDim2.new(popup.Root.Size.X.Scale, popup.Root.Size.X.Offset, 0, 0), GroupTransparency = 1 }, Tokens.INSTANT, "Quint")
		end
	end

	element._normalize = function(value)
		if value == nil then
			return true, multi and {} or nil
		end
		if multi then
			local selected = {}
			if type(value) == "table" then
				for _, entry in ipairs(value) do
					local text = tostring(entry)
					if tableFind(element.Options, text) and not tableFind(selected, text) then
						table.insert(selected, text)
					end
				end
			end
			return true, selected
		end
		local text = tostring(value)
		if not tableFind(element.Options, text) then
			return false, "Invalid selection: " .. text
		end
		return true, text
	end

	element._apply = function(value)
		button.Text = displayFor(value)
		button:SetAttribute("Value", multi and table.concat(type(value) == "table" and value or {}, "|") or tostring(value))
	end
	element:Set(defaultFor(), true)

	bindButton(self, button, openDropdown, function()
		return lighten(theme.Panel, 0.185), 0, theme.Text
	end)
	self:_track(chevron.MouseEnter:Connect(function()
		Library:Tween(chevron, { TextColor3 = theme.Text }, Tokens.INSTANT, "Quad")
	end))
	self:_track(chevron.MouseLeave:Connect(function()
		if chevron.Rotation < 90 then
			Library:Tween(chevron, { TextColor3 = theme.Muted }, Tokens.INSTANT, "Quad")
		end
	end))

	function element:SetOptions(newOptions)
		element.Options = {}
		if type(newOptions) == "table" then
			for _, option in ipairs(newOptions) do
				table.insert(element.Options, tostring(option))
			end
		end
		if multi then
			local selected = {}
			if type(element.Value) == "table" then
				for _, value in ipairs(element.Value) do
					if tableFind(element.Options, value) then
						table.insert(selected, value)
					end
				end
			end
			element:Set(selected)
		elseif not tableFind(element.Options, tostring(element.Value)) then
			element:Set(element.Options[1])
		end
		return true
	end

	return element
end

